      "updated": 1784292412394,
      "link": null,
      "locked": false,
      "text": "[student@workstation serving-modelregistry]$ oc get inferenceService\nNAME          URL                                                              READY   PREV   LATEST   PREVROLLEDOUTREVISION   LATESTREADYREVISION   AGE\ndiabetes-v1   https://diabetes-v1-serving-modelregistry.apps.lab.example.com   True                                                                  11m\n[student@workstation serving-modelregistry]$ \n[student@workstation serving-modelregistry]$ oc get inferenceService -o yaml\napiVersion: v1\nitems:\n- apiVersion: serving.kserve.io/v1beta1\n  kind: InferenceService\n  metadata:\n    annotations:\n      ...\n    labels:\n     ...\n    name: diabetes-v1\n    namespace: serving-modelregistry\n\n  spec:\n    predictor:\n      automountServiceAccountToken: false\n      deploymentStrategy:\n        type: RollingUpdate\n      imagePullSecrets:\n      - name: rht-oci-registry\n      maxReplicas: 1\n      minReplicas: 1\n      model:\n        modelFormat:\n          name: onnx\n          version: \"1\"\n        name: \"\"\n        resources:\n          limits:\n            cpu: \"2\"\n            memory: 4Gi\n          requests:\n            cpu: \"2\"\n            memory: 4Gi\n        runtime: diabetes-v1\n        storageUri: oci://registry.lab.example.com:8443/redhattraining/models/diabetes:v1",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
