    {
      "id": "2nSGFJbxWXsT_coMtrJSi",
      "type": "text",
      "x": -1051.199951171875,
      "y": 40346.38833230251,
      "width": 1940.4000244140625,
      "height": 1845,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "r4q-t0m3PTy06F8fl_z1Y",
        "xldV0AIcIkMsgcHLNKXcc",
        "1XhsYm_3-ikG1lh2d-GVc"
      ],
      "frameId": null,
      "index": "c0D6",
