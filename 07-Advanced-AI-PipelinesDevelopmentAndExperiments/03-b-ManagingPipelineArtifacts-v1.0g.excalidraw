      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> allows you to import an artifact into your pipeline\n    when that artifact was not created by tasks within\n    the pipeline",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> allows you to import an artifact into your pipeline\n    when that artifact was not created by tasks within\n    the pipeline",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793616506960,
      "labelPosition": null,
      "baseFontSize": null
    },
