      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 15.045238222395142,
      "y": 8330.190476190095,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1252.9166259765625,
      "height": 855,
      "seed": 2027707562,
      "groupIds": [
        "zezApT6lOrfT8Rf_nlhee",
        "XOw4KuM4vSI1j6UiI-JP3",
        "oZ1oTRVEPtoqlMNErnoKk",
