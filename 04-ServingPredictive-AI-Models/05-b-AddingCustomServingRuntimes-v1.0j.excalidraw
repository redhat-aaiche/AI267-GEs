      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 8,
      "text": "apiVersion: serving.kserve.io/v1alpha1\n\nkind: ServingRuntime\n\nmetadata:\n    annotations:\n    \n       openshift.io/display-name: Example Model Server\n\n    name: kserve-paddleserver\n\nspec:\n\n    annotations:\n        prometheus.kserve.io/path: /metrics\n        prometheus.kserve.io/port: \"8080\"\n\ncontainers:\n    - args:\n        - --model_name={{ .Name }}\n        - --model_dir=/mnt/models\n        - --http_port=8080\n        image: paddle_container_image\n        name: kserve-container\n\nmultiModel: false\n\nprotocolVersions:\n    - v2\n\nsupportedModelFormats:\n    - autoSelect: true\n      name: paddle\n      priority: 1\n      version: \"2\"",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "apiVersion: serving.kserve.io/v1alpha1\n\nkind: ServingRuntime\n\nmetadata:\n    annotations:\n    \n       openshift.io/display-name: Example Model Server\n\n    name: kserve-paddleserver\n\nspec:\n\n    annotations:\n        prometheus.kserve.io/path: /metrics\n        prometheus.kserve.io/port: \"8080\"\n\ncontainers:\n    - args:\n        - --model_name={{ .Name }}\n        - --model_dir=/mnt/models\n        - --http_port=8080\n        image: paddle_container_image\n        name: kserve-container\n\nmultiModel: false\n\nprotocolVersions:\n    - v2\n\nsupportedModelFormats:\n    - autoSelect: true\n      name: paddle\n      priority: 1\n      version: \"2\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793543230979,
      "labelPosition": null,
      "baseFontSize": null
