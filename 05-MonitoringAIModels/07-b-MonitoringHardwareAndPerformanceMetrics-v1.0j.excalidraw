      "text": "[student@workstation ~]$ oc get ServiceMonitor\nNAME                 AGE\ndistilbert-metrics   37m\n\n\n\n[student@workstation ~]$ oc get ServiceMonitor/distilbert-metrics -o yaml\napiVersion: monitoring.coreos.com/v1\n\nkind: ServiceMonitor\n\nmetadata:\n  ...\n  labels:\n    monitoring.opendatahub.io/scrape: \"true\"\n  name: distilbert-metrics\n  namespace: monitoring-performance\n  \nspec:\n\n  endpoints:\n  - port: kserve-ovms-metrics\n    scheme: http\n\n  namespaceSelector: {}\n\n  selector:\n    matchLabels:\n      name: distilbert-metrics\n",
