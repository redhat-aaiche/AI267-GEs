      "boundElements": [],
      "updated": 1793543200173,
      "link": null,
      "locked": false,
      "text": "° In reality, you don't create an InferenceService nor a ServingRuntime\n  when using the Dashboard, these 2 CRs will be created for you\n\n\n\n° However the ServingRuntime Template needs to be available, so you \n  can you select the Serving Runtime",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° In reality, you don't create an InferenceService nor a ServingRuntime\n  when using the Dashboard, these 2 CRs will be created for you\n\n\n\n° However the ServingRuntime Template needs to be available, so you \n  can you select the Serving Runtime",
      "autoResize": true,
