      "text": "kind: ConfigMap\napiVersion: v1\nmetadata:\n  name: fms-orchestr8-config-gateway\n  labels:\n    app: fmstack-nlp\ndata:\n  config.yaml: |\n\n\n    orchestrator:\n\n      host: \"localhost\"\n      port: 8032\n\n\n\n\n    detectors:\n\n      - name: regex\n        input: true\n        output: true\n        detector_params: \n          regex:\n            - email\n            - us-phone-number\n            - credit-card\n            - \\b(?i:vmware|broadcom|docker|oracle|suse)\\b          \n\n\n      - name: hap\n        input: true\n        output: true\n        detector_params: {}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n    routes:\n\n      - name: all\n        detectors: \n          - regex\n          - hap          \n\n      - name: hap\n        detectors:\n          - hap            \n\n      - name: passthrough\n        detectors:",
