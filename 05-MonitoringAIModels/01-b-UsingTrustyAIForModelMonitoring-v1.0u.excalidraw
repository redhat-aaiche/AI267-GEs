    },
    {
      "type": "text",
      "version": 3595,
      "versionNonce": 1185396938,
      "index": "c144",
      "isDeleted": false,
      "id": "mdF86sctNTMNyAdtuSCmp",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 79.16434955094701,
      "y": 50260,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "width": 1588.949951171875,
      "height": 1170,
      "seed": 1869152778,
      "groupIds": [
        "vvna736rYn0XKTixNu2kT",
        "LrT_XwkeR19t17BGdHEwB",
        "uWrCs3vboTD7WSuPBR69x",
        "y1BoXXdfYWaUTf6YIReWn",
        "TCnxqubW8IlYYDnRLCODr",
        "lRNMKOxEMSjMxcY4XSHs5",
        "01Vgdt41h7RrAEylfLn99",
        "y8dkkbLlj0qADDVqzGxyn",
        "qYhyF0wZhZ8IQ6wqP_4c0",
        "7trFCEGwaHxCd6Flz8ID8",
        "tLf0S7ATALre1f9_CdMO1",
        "5eyO1_4Xc429GTftJHLuk",
        "bjwmYPeizLWpD8Fs7cKY4",
        "ubgNQu1ZwYWnPPo5lSCGl",
        "phev8ZcjG_rlf5oZzeQ53"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1793606792641,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Different Metrics :\n\n    ° The concept of Throughput or Latency is different as\n      because it is not possible to predict, given a request, how long\n      the answer will be, so any metric that counts the requests will not provide a good\n      representation of the actual model server workload\n\n    ° Since tokens are the core unit of computation for LLM generation, model server\n      metrics are token-based rather than request-base\n\n\n \n    ° For LLM Models, there are 2 phases during generation :\n\n        - Prefill ( compute-bound )\n\n        and \n\n        - Decode ( memory-bound )\n\n\n   For example, you like to track :\n\n    - Time To First Token ( TTFT )\n\n    - Inter-Token Latency ( ITL )",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Different Metrics :\n\n    ° The concept of Throughput or Latency is different as\n      because it is not possible to predict, given a request, how long\n      the answer will be, so any metric that counts the requests will not provide a good\n      representation of the actual model server workload\n\n    ° Since tokens are the core unit of computation for LLM generation, model server\n      metrics are token-based rather than request-base\n\n\n \n    ° For LLM Models, there are 2 phases during generation :\n\n        - Prefill ( compute-bound )\n\n        and \n\n        - Decode ( memory-bound )\n\n\n   For example, you like to track :\n\n    - Time To First Token ( TTFT )\n\n    - Inter-Token Latency ( ITL )",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793606786659,
      "labelPosition": null,
      "baseFontSize": null
    },
