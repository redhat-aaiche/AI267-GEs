    {
      "id": "qEd6DrAIakMGsxOd9I1KN",
      "type": "text",
      "x": 688.517198972954,
      "y": -1784.2729135797565,
      "width": 1312,
      "height": 134.4,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
