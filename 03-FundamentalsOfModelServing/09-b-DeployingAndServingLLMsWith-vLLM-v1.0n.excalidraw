    {
      "id": "Ex5UmhKhZ7KVu6ELUZAuJ",
      "type": "text",
      "x": -460,
      "y": 5638.662012852272,
      "width": 1254.050048828125,
      "height": 585,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3QlDdb-3LfxaM7xozFP3s",
        "0RyOJgis8dbYLfXnuyuk4",
        "GkAJyG4BeabJJYbvbS0At",
        "kj1GSImcaByx9TbKTQg81",
        "1HGtfJluD6_EcjllbuoPO",
        "9BfC1IcaimDGpUDG9SU3j"
      ],
      "frameId": null,
      "index": "by3",
      "roundness": null,
      "seed": 64232979,
      "version": 1611,
      "versionNonce": 156468196,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793702328057,
      "link": null,
      "locked": false,
      "text": "° As soon as an inference request has completed\n  we evict it and start another one\n\n° Here the 3rd request ends at T6 and immediately\n  at T7 we have something else running\n\n    ==> here we are not waiting for the 2nd request to complete at T8\n\n==> Continuous Batching, as soon an inference request has completed \n     we evict it and start another one\n     we never stop : we try to keep the hardware as busy as possible\n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° As soon as an inference request has completed\n  we evict it and start another one\n\n° Here the 3rd request ends at T6 and immediately\n  at T7 we have something else running\n\n    ==> here we are not waiting for the 2nd request to complete at T8\n\n==> Continuous Batching, as soon an inference request has completed \n     we evict it and start another one\n     we never stop : we try to keep the hardware as busy as possible\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1793532284139,
      "baseFontSize": null
    },
