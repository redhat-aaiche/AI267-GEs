    {
      "id": "YAAHGmGPtEq0U4nXtL5zE",
      "type": "text",
      "x": 1361.0956418206708,
      "y": 46408.03118944536,
      "width": 1188,
      "height": 1035,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "PDZHWccSwttR_45MwOGcL",
        "bYFnZ-wi3fiagnx9l5W9O",
        "OSuv2fLWTU6FxkGwQD9hp",
        "ip-PvsmIZxwzlLcIoYiAW"
      ],
      "frameId": null,
      "index": "c0Lx",
      "roundness": null,
      "seed": 769182513,
      "version": 439,
      "versionNonce": 983621087,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791809346525,
      "link": null,
      "locked": false,
      "text": "[student@workstation genai-agentic]$ cat test_mcp_tools.sh\n#!/bin/bash\n# Test MCP server tool discovery\n#\n# This script sends a JSON-RPC 2.0 request to the MCP server\n# to list all available tools. The MCP server uses the\n# Streamable HTTP transport (SSE) for network communication.\n\n\n# Ensure trailing slash for SSE endpoint\nMCP_EXTERNAL_URL=\"${MCP_EXTERNAL_URL%/}/\"\n\necho \"Discovering MCP tools...\"\necho \"Endpoint: $MCP_EXTERNAL_URL\"\necho \"\"\n\ncurl -s \"$MCP_EXTERNAL_URL\" \\\n  -H \"Content-Type: application/json\" \\\n  -H \"Accept: application/json, text/event-stream\" \\\n  -d '{\"jsonrpc\": \"2.0\", \"method\": \"tools/list\", \"id\": 1}' \\\n  | grep '^data:' \\\n  | sed 's/^data: //' \\\n  | jq",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation genai-agentic]$ cat test_mcp_tools.sh\n#!/bin/bash\n# Test MCP server tool discovery\n#\n# This script sends a JSON-RPC 2.0 request to the MCP server\n# to list all available tools. The MCP server uses the\n# Streamable HTTP transport (SSE) for network communication.\n\n\n# Ensure trailing slash for SSE endpoint\nMCP_EXTERNAL_URL=\"${MCP_EXTERNAL_URL%/}/\"\n\necho \"Discovering MCP tools...\"\necho \"Endpoint: $MCP_EXTERNAL_URL\"\necho \"\"\n\ncurl -s \"$MCP_EXTERNAL_URL\" \\\n  -H \"Content-Type: application/json\" \\\n  -H \"Accept: application/json, text/event-stream\" \\\n  -d '{\"jsonrpc\": \"2.0\", \"method\": \"tools/list\", \"id\": 1}' \\\n  | grep '^data:' \\\n  | sed 's/^data: //' \\\n  | jq",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1791809322587,
      "labelPosition": null,
      "baseFontSize": null
    },
