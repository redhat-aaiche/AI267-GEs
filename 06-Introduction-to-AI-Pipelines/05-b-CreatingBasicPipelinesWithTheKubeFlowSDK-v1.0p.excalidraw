      "link": null,
      "locked": false,
      "text": "[student@workstation dspa-kubeflow]$ cat pipeline.yaml \n# PIPELINE DEFINITION\n# Name: sentiment-analysis\n\ncomponents:\n\n  comp-process-data:\n    executorLabel: exec-process-data\n    outputDefinitions:\n      parameters:\n        labels:\n          parameterType: LIST\n        texts:\n          parameterType: LIST\n\n  ...\n\n\ndeploymentSpec:\n\n  executors:\n\n    exec-process-data:\n      container:\n        args:\n...\n        command:\n...\n        image: registry.redhat.io/rhoai/odh-pipeline-runtime-datascience-cpu-py312-rhel9@s...\npipelineInfo:\n  name: sentiment-analysis\n\nroot:\n\n  dag:\n\n    tasks:\n      process-data:\n        cachingOptions:\n          enableCache: true\n        componentRef:\n          name: comp-process-data\n        taskInfo:\n          name: process-data\n\n...\n\nschemaVersion: 2.1.0\nsdkVersion: kfp-2.15.2",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation dspa-kubeflow]$ cat pipeline.yaml \n# PIPELINE DEFINITION\n# Name: sentiment-analysis\n\ncomponents:\n\n  comp-process-data:\n    executorLabel: exec-process-data\n    outputDefinitions:\n      parameters:\n        labels:\n          parameterType: LIST\n        texts:\n          parameterType: LIST\n\n  ...\n\n\ndeploymentSpec:\n\n  executors:\n\n    exec-process-data:\n      container:\n        args:\n...\n        command:\n...\n        image: registry.redhat.io/rhoai/odh-pipeline-runtime-datascience-cpu-py312-rhel9@s...\npipelineInfo:\n  name: sentiment-analysis\n\nroot:\n\n  dag:\n\n    tasks:\n      process-data:\n        cachingOptions:\n          enableCache: true\n        componentRef:\n          name: comp-process-data\n        taskInfo:\n          name: process-data\n\n...\n\nschemaVersion: 2.1.0\nsdkVersion: kfp-2.15.2",
