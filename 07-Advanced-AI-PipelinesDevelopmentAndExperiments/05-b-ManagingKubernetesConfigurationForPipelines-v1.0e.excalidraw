      "updated": 1787385571231,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Kubeflow Pipelines support caching to eliminate redundant \n   executions and improve the efficiency of your pipeline runs\n\n--> Caching is enabled by default for all components in KFP. \n   You can disable caching for a component by calling \n\n\n   on a task object",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Kubeflow Pipelines support caching to eliminate redundant \n   executions and improve the efficiency of your pipeline runs\n\n--> Caching is enabled by default for all components in KFP. \n   You can disable caching for a component by calling \n\n\n   on a task object",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
