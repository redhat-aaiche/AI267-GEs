      "link": null,
      "locked": false,
      "text": "° I found this definition somewhere :\n\n    \" An algorithm is fair if it makes predictions that \n      do not favour or discriminate against certain individuals\n      or groups based on sensitive characteristics \"",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
