      "updated": 1775819729240,
      "link": null,
      "locked": false,
      "text": "- check out the extension for Tekton Pipelines in addition to\n the OpenShift Connector for Visual Studio Code \n- This extension allows you to graphically build a pipeline, and it \n connects to Tekton Hub for reusable pipelines and tasks shared by the community",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- check out the extension for Tekton Pipelines in addition to\n the OpenShift Connector for Visual Studio Code \n- This extension allows you to graphically build a pipeline, and it \n connects to Tekton Hub for reusable pipelines and tasks shared by the community",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
