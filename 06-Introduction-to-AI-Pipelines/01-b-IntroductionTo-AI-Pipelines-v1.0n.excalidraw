      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "width": 1315.5167236328125,
      "height": 900,
      "seed": 1708403798,
      "groupIds": [
        "VWxxF7ClRDFtURRVxi1YZ",
        "xUfxUIGOujYnvxV1CTGB2",
        "Fo11iR0kAEekhoJw1m_eB",
        "Eud7e_dp1wYwu8Otn39hc",
        "rYtwdQJvHWaiqnYmcoxCJ",
