    },
    {
      "id": "9XzJXRK8ycm4Y5mbQGX8F",
      "type": "text",
      "x": 186.79910235744728,
      "y": 24859.114827260957,
      "width": 1089,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fffce8",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "DqWim8_PIgGtSZR63pOm9",
        "YbSJp-sp2qVUESeTmBF6s",
        "HCYJ_EM-SY9OsmkwpsJVA"
      ],
      "frameId": null,
      "index": "c0Hp",
      "roundness": null,
      "seed": 383957179,
      "version": 532,
      "versionNonce": 786546075,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793442615298,
      "link": null,
      "locked": false,
      "text": "° Muliple Data Scientists can work on the same code\n\n\n\n° Muliple Data Scientists can work on specific features\n  using Git branches\n    - reduces conflicts with the main branch\n\n\n\n° Code on a branch can be integrated to the main one,\n  once it is reviewed \n\n\n° Changes are tracked and can be reverted if a change\n  causes a problem",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Muliple Data Scientists can work on the same code\n\n\n\n° Muliple Data Scientists can work on specific features\n  using Git branches\n    - reduces conflicts with the main branch\n\n\n\n° Code on a branch can be integrated to the main one,\n  once it is reviewed \n\n\n° Changes are tracked and can be reverted if a change\n  causes a problem",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793442610104,
      "labelPosition": null,
      "baseFontSize": null
    },
