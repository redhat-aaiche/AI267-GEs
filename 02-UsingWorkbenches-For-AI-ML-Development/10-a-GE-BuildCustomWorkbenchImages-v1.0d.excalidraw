      "updated": 1784802566918,
      "link": null,
      "locked": false,
      "text": "FROM quay.io/modh/odh-workbench-jupyter-minimal-cpu-py312-ubi9@sha256:f7a64dcb3cca14afdfbf873243ec76f2a56198e67d815d23635977ba3550cbe3\n\nUSER 1001\n\nCOPY requirements.txt ./\n\nRUN echo \"Installing tooling and packages\" && \\\n    pip install micropipenv && \\\n    micropipenv install && \\\n    rm -f ./requirements.txt\n\nRUN chmod -R g+w /opt/app-root/lib/python3.12/site-packages && \\\n    fix-permissions /opt/app-root -P",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FROM quay.io/modh/odh-workbench-jupyter-minimal-cpu-py312-ubi9@sha256:f7a64dcb3cca14afdfbf873243ec76f2a56198e67d815d23635977ba3550cbe3\n\nUSER 1001\n\nCOPY requirements.txt ./\n\nRUN echo \"Installing tooling and packages\" && \\\n    pip install micropipenv && \\\n    micropipenv install && \\\n    rm -f ./requirements.txt\n\nRUN chmod -R g+w /opt/app-root/lib/python3.12/site-packages && \\\n    fix-permissions /opt/app-root -P",
