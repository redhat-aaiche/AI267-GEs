      "containerId": null,
      "originalText": "$ vim pipeline-manifest.py",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": 1793614216942,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "-8ePRnTkkMn8la_xoKKOr",
      "type": "text",
      "x": 815.025009155273,
      "y": 79640,
      "width": 1445.4000244140625,
      "height": 1665,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zAmyrTh9vR7daf86A-tX5",
        "UDRNX7HuCqGOjXiG1N6M3",
        "q7wfYBqFCepniQkV-AA3r",
        "MEhvdEuLWK4G-vUCgFjWK"
      ],
      "frameId": null,
      "index": "c0mJ",
      "roundness": null,
      "seed": 1322107734,
      "version": 1007,
      "versionNonce": 2046475990,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793614230311,
      "link": null,
      "locked": false,
      "text": "from kfp import dsl\nfrom kfp import compiler\nfrom kfp.compiler.compiler_utils import KubernetesManifestOptions\n\n\n@dsl.component\ndef say_hello(name: str) -> str:\n    hello_text = f'Hello, {name}!'\n    print(hello_text)\n    return hello_text\n\n@dsl.pipeline\ndef hello_pipeline(recipient: str) -> str:\n    hello_task = say_hello(name=recipient)\n    return hello_task.output\n\nif __name__ == \"__main__\":\n    outfile = \"pipeline-manifest.yaml\"\n    # Compile the pipeline\n    compiler.Compiler().compile(\n        hello_pipeline,\n        outfile,\n        kubernetes_manifest_format=True,\n        kubernetes_manifest_options=KubernetesManifestOptions(\n            pipeline_name=\"my-second-pipeline\",\n            pipeline_display_name=\"My Second Pipeline\",\n            pipeline_version_name=\"my-second-pipeline-v1\",\n            pipeline_version_display_name=\"My Second Pipeline v1\",\n            namespace=\"dspa-kubeflow\",\n            include_pipeline_manifest=True\n        )\n    )\n\n    print(\n        \"Pipeline compiled.\\n\"\n        f\"Use the Kubernetes API to import the '{outfile}' manifest file\"\n    )",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from kfp import dsl\nfrom kfp import compiler\nfrom kfp.compiler.compiler_utils import KubernetesManifestOptions\n\n\n@dsl.component\ndef say_hello(name: str) -> str:\n    hello_text = f'Hello, {name}!'\n    print(hello_text)\n    return hello_text\n\n@dsl.pipeline\ndef hello_pipeline(recipient: str) -> str:\n    hello_task = say_hello(name=recipient)\n    return hello_task.output\n\nif __name__ == \"__main__\":\n    outfile = \"pipeline-manifest.yaml\"\n    # Compile the pipeline\n    compiler.Compiler().compile(\n        hello_pipeline,\n        outfile,\n        kubernetes_manifest_format=True,\n        kubernetes_manifest_options=KubernetesManifestOptions(\n            pipeline_name=\"my-second-pipeline\",\n            pipeline_display_name=\"My Second Pipeline\",\n            pipeline_version_name=\"my-second-pipeline-v1\",\n            pipeline_version_display_name=\"My Second Pipeline v1\",\n            namespace=\"dspa-kubeflow\",\n            include_pipeline_manifest=True\n        )\n    )\n\n    print(\n        \"Pipeline compiled.\\n\"\n        f\"Use the Kubernetes API to import the '{outfile}' manifest file\"\n    )",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793614216942,
      "labelPosition": null,
      "baseFontSize": null
    },
