      "updated": 1784400448513,
      "link": null,
      "locked": false,
      "text": "#!/bin/bash\n# Test vLLM with random prompts from alice.txt\n# Usage: ./curl-llm-random.sh NUM_REQUESTS TOKEN [TIMEOUT] [LLM_URL]\n\nNUM_REQUESTS=${1:-20}\nTOKEN=${2}\nTIMEOUT=${3:-30}\nLLM_URL=${4:-\"http://my-llm-predictor.serving-vllm.svc.cluster.local:8080\"}\nRESULTS_DIR=\"/tmp/vllm-random-$$\"\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nALICE_FILE=\"$SCRIPT_DIR/alice.txt\"\n\nif [ -z \"$TOKEN\" ]; then\n  echo \"ERROR: TOKEN required\"\n  echo \"Usage: $0 NUM_REQUESTS TOKEN [TIMEOUT] [LLM_URL]\"\n  exit 1\nfi\n\nif [ ! -f \"$ALICE_FILE\" ]; then\n  echo \"ERROR: alice.txt not found at $ALICE_FILE\"\n  exit 1\nfi\n\nrm -rf \"$RESULTS_DIR\"\nmkdir -p \"$RESULTS_DIR/chunks\"\necho \"Preparing random prompts from alice.txt...\"\n\n# Split alice.txt into ~70 chunks\nTOTAL_LINES=$(wc -l < \"$ALICE_FILE\")\nCHUNK_SIZE=$((TOTAL_LINES / 70))\nsplit -l \"$CHUNK_SIZE\" \"$ALICE_FILE\" \"$RESULTS_DIR/chunks/chunk-\"\n\necho \"Sending $NUM_REQUESTS requests to $LLM_URL...\"\nSTART=$(date +%s)\n\nfor i in $(seq 1 $NUM_REQUESTS); do\n  # Pick random chunk\n  CHUNK=$(ls \"$RESULTS_DIR/chunks\"/chunk-* | shuf -n 1)\n  CONTENT=$(cat \"$CHUNK\")\n\n  # Create payload\n  python3 -c \"\nimport json\npayload = {\n  'model': 'my-llm',\n  'messages': [\n    {'role': 'system', 'content': 'You are a helpful assistant.'},\n    {'role': 'user', 'content': '''$CONTENT'''}\n  ]\n}\nwith open('$RESULTS_DIR/payload-$i.json', 'w') as f:\n  json.dump(payload, f)\n\"\n\n  curl -sk -X POST \"$LLM_URL/v1/chat/completions\" \\\n    -H \"Authorization: Bearer $TOKEN\" \\\n    -H \"Content-Type: application/json\" \\\n    --max-time $TIMEOUT \\\n    --data-binary \"@$RESULTS_DIR/payload-$i.json\" \\\n    -o \"$RESULTS_DIR/result-$i.json\" 2>&1 &\ndone\n\nwait\nEND=$(date +%s)\nDURATION=$((END - START))\n\n# Count successes\nSUCCESSFUL=0\nfor i in $(seq 1 $NUM_REQUESTS); do\n  if grep -q '\"choices\"' \"$RESULTS_DIR/result-$i.json\" 2>/dev/null; then\n    ((SUCCESSFUL++))\n  fi\ndone\n\nFAILED=$((NUM_REQUESTS - SUCCESSFUL))\n\necho \"Duration: ${DURATION}s\"\necho \"Success: $SUCCESSFUL/$NUM_REQUESTS\"\necho \"Failed: $FAILED/$NUM_REQUESTS",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#!/bin/bash\n# Test vLLM with random prompts from alice.txt\n# Usage: ./curl-llm-random.sh NUM_REQUESTS TOKEN [TIMEOUT] [LLM_URL]\n\nNUM_REQUESTS=${1:-20}\nTOKEN=${2}\nTIMEOUT=${3:-30}\nLLM_URL=${4:-\"http://my-llm-predictor.serving-vllm.svc.cluster.local:8080\"}\nRESULTS_DIR=\"/tmp/vllm-random-$$\"\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nALICE_FILE=\"$SCRIPT_DIR/alice.txt\"\n\nif [ -z \"$TOKEN\" ]; then\n  echo \"ERROR: TOKEN required\"\n  echo \"Usage: $0 NUM_REQUESTS TOKEN [TIMEOUT] [LLM_URL]\"\n  exit 1\nfi\n\nif [ ! -f \"$ALICE_FILE\" ]; then\n  echo \"ERROR: alice.txt not found at $ALICE_FILE\"\n  exit 1\nfi\n\nrm -rf \"$RESULTS_DIR\"\nmkdir -p \"$RESULTS_DIR/chunks\"\necho \"Preparing random prompts from alice.txt...\"\n\n# Split alice.txt into ~70 chunks\nTOTAL_LINES=$(wc -l < \"$ALICE_FILE\")\nCHUNK_SIZE=$((TOTAL_LINES / 70))\nsplit -l \"$CHUNK_SIZE\" \"$ALICE_FILE\" \"$RESULTS_DIR/chunks/chunk-\"\n\necho \"Sending $NUM_REQUESTS requests to $LLM_URL...\"\nSTART=$(date +%s)\n\nfor i in $(seq 1 $NUM_REQUESTS); do\n  # Pick random chunk\n  CHUNK=$(ls \"$RESULTS_DIR/chunks\"/chunk-* | shuf -n 1)\n  CONTENT=$(cat \"$CHUNK\")\n\n  # Create payload\n  python3 -c \"\nimport json\npayload = {\n  'model': 'my-llm',\n  'messages': [\n    {'role': 'system', 'content': 'You are a helpful assistant.'},\n    {'role': 'user', 'content': '''$CONTENT'''}\n  ]\n}\nwith open('$RESULTS_DIR/payload-$i.json', 'w') as f:\n  json.dump(payload, f)\n\"\n\n  curl -sk -X POST \"$LLM_URL/v1/chat/completions\" \\\n    -H \"Authorization: Bearer $TOKEN\" \\\n    -H \"Content-Type: application/json\" \\\n    --max-time $TIMEOUT \\\n    --data-binary \"@$RESULTS_DIR/payload-$i.json\" \\\n    -o \"$RESULTS_DIR/result-$i.json\" 2>&1 &\ndone\n\nwait\nEND=$(date +%s)\nDURATION=$((END - START))\n\n# Count successes\nSUCCESSFUL=0\nfor i in $(seq 1 $NUM_REQUESTS); do\n  if grep -q '\"choices\"' \"$RESULTS_DIR/result-$i.json\" 2>/dev/null; then\n    ((SUCCESSFUL++))\n  fi\ndone\n\nFAILED=$((NUM_REQUESTS - SUCCESSFUL))\n\necho \"Duration: ${DURATION}s\"\necho \"Success: $SUCCESSFUL/$NUM_REQUESTS\"\necho \"Failed: $FAILED/$NUM_REQUESTS",
