    {
      "id": "V3WHb7dLvMmS_sCBOjvjl",
      "type": "text",
      "x": 1360.0464032712505,
      "y": 48088.05664248942,
      "width": 1445.4000244140625,
      "height": 765,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "sfEriPaKPZ4W_NmQiDYoH",
