      "text": "$ curl -s \\\n\n    -H \"Authorization: Bearer $TOKEN\" \\\n\n    https://$MODEL_PATH/infer \\\n\n    -X POST \\\n\n    --data '{\"inputs\":[{\"name\":\"X\",\"shape\":[1,4],\"datatype\":\"FP32\",\"data\":[3,4,3,2]}]}' \\\n\n    | jq",
      "textAlign": "left",
      "verticalAlign": "top",
