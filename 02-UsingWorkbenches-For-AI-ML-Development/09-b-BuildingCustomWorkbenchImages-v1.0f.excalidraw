    },
    {
      "id": "QXM1YjGpyNA33T6b-K7MR",
      "type": "text",
      "x": 313.97377680362695,
      "y": 14743,
      "width": 1168.199951171875,
      "height": 270,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#db212f",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "s9bjvdYeDrK9152IJpflL",
        "8JhpzO9_9_62yuooar00w"
      ],
      "frameId": null,
      "index": "c01B",
      "roundness": null,
      "seed": 1027580059,
      "version": 890,
      "versionNonce": 1411818075,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793443502019,
      "link": null,
      "locked": false,
      "text": "° The working directoy is not configurable, \n° so custom images must use this default location\n  for persisted data\n° When launching a notebook in RHOAI, the working directory\n  of a user is mounted at :\n    /opt/app-root/src/",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° The working directoy is not configurable, \n° so custom images must use this default location\n  for persisted data\n° When launching a notebook in RHOAI, the working directory\n  of a user is mounted at :\n    /opt/app-root/src/",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793443494856,
      "labelPosition": null,
      "baseFontSize": null
