    {
      "id": "v1QHgjhMux7SMrWxeJupk",
      "type": "text",
      "x": 820,
      "y": 10700,
      "width": 1742.4000244140625,
      "height": 4680,
      "angle": 0,
      "strokeColor": "#1e1e1e",
