      "updated": 1793709707976,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> JupyterLab is :\n\n        ° a New Interface for jupyter notebooks\n\n        ° It provides more capabilities that you need\n\n        ° It gives more flexibility :\n            - Multiple documents / tabs can be opened\n              for example to compare 2 notebooks\n\n        \n        ° It looks more like an IDE\n\n\n        ° Provides Modular, Extensible Architecture\n\n\n        ° Retains backward compatibility with the old\n          jupyter notebook",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> JupyterLab is :\n\n        ° a New Interface for jupyter notebooks\n\n        ° It provides more capabilities that you need\n\n        ° It gives more flexibility :\n            - Multiple documents / tabs can be opened\n              for example to compare 2 notebooks\n\n        \n        ° It looks more like an IDE\n\n\n        ° Provides Modular, Extensible Architecture\n\n\n        ° Retains backward compatibility with the old\n          jupyter notebook",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793612126513,
      "labelPosition": null,
      "baseFontSize": null
    },
