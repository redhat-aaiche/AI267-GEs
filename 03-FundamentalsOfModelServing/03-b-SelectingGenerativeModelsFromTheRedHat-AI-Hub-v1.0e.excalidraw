    {
      "id": "EeUzUuY7APwFTLPDNiAJo",
      "type": "text",
      "x": -406.1666666666679,
      "y": 29467.16666666667,
      "width": 1846.2833251953125,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "qrRD0uDKGeUXsLGL4C_s3",
        "ZApscPLR4PFeX8Gmr1ZhP",
        "7c75bZ-wwZCSu6DqRvk0d"
      ],
      "frameId": null,
      "index": "bts",
      "roundness": null,
      "seed": 390693670,
      "version": 269,
      "versionNonce": 1671073702,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788350858091,
      "link": null,
      "locked": false,
      "text": "--> latency vs throughput :\n\n        ° At the highest level there are 2 competing metrics:\n\n            1) Latency — the time from when a request is submitted until tokens are returned\n    \n\n            2) Throughput — the number of tokens/requests per second the system can generate/process\n\n\n--> Latency matters most for interactive applications, where users are waiting on responses\n\n\n--> Throughput matters in offline workloads like synthetic data generation for pre/post-training runs, \n    data cleaning/processing, and in general - any type of offline batch inference jobs ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> latency vs throughput :\n\n        ° At the highest level there are 2 competing metrics:\n\n            1) Latency — the time from when a request is submitted until tokens are returned\n    \n\n            2) Throughput — the number of tokens/requests per second the system can generate/process\n\n\n--> Latency matters most for interactive applications, where users are waiting on responses\n\n\n--> Throughput matters in offline workloads like synthetic data generation for pre/post-training runs, \n    data cleaning/processing, and in general - any type of offline batch inference jobs ",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
