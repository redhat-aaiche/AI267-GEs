      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 3,
      "text": "$ curl -H \"Authorization: Bearer ${TOKEN}\"  -H 'Content-Type: application/json' -X POST ${TRUSTY_ROUTE}/info/names \\\n\n  -d '{\n\n    \"modelId\": \"diabetes\",\n\n    \"inputMapping\": {\n      \"dense_input-0\": \"Pregnancies\",\n      \"dense_input-1\": \"Glucose\",\n      \"dense_input-2\": \"BloodPressure\",\n      \"dense_input-3\": \"SkinThickness\",\n      \"dense_input-4\": \"Insulin\",\n      \"dense_input-5\": \"BMI\",\n      \"dense_input-6\": \"DiabetesPedigreeFunction\",\n      \"dense_input-7\": \"Age\"\n    },\n\n    \"outputMapping\": {\n      \"dense_2-0\": \"No Diabetes\",\n      \"dense_2-1\": \"Diabetes\"\n    }\n\n  }'",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
