      "updated": 1793705132900,
      "link": null,
      "locked": false,
      "text": "° Model Fairness :\n\n    ==> whatever biases in society does not come to your algorithm\n\n    ==> you don't give power to your algorithm to create\n        discrimination and bias",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Model Fairness :\n\n    ==> whatever biases in society does not come to your algorithm\n\n    ==> you don't give power to your algorithm to create\n        discrimination and bias",
