    {
      "id": "YFIQiJRPS5v6phrh7w4v3",
      "type": "text",
      "x": -300,
      "y": 99100,
      "width": 2079,
      "height": 1710,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Enzo2c70I9dNYcM_syOis",
        "KFA4v2aX0VJB8E33bu8E3",
        "w7-zs0fdvaETPmawFdLVr",
        "sBGZn0aFK0OdIomDH26_y"
      ],
      "frameId": null,
      "index": "c2Xk",
      "roundness": null,
      "seed": 408136986,
      "version": 684,
      "versionNonce": 584646746,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785405188545,
      "link": null,
      "locked": false,
      "text": "[student@workstation scripts]$ cat schedule_spd.sh \n#!/bin/bash\n\noc login -u developer -p developer https://api.ocp4.example.com:6443 >/dev/null 2>&1\n\nMM_NAMESPACE=monitoring-bias\n\noc project $MM_NAMESPACE >/dev/null 2>&1\n\nTRUSTY_ROUTE=https://$(oc get route/trustyai-service --template={{.spec.host}})\nTOKEN=${TOKEN:-$(oc whoami -t)}\n\nfor model in \"demo-loan-nn-onnx-alpha\" \"demo-loan-nn-onnx-beta\"; do\n  echo \"Sending curl request for scheduling periodic SPD calculation for model $model...\"\n  curl -sk -H \"Authorization: Bearer ${TOKEN}\" -X POST $TRUSTY_ROUTE/metrics/group/fairness/spd/request \\\n       --header 'Content-Type: application/json' \\\n       --data \"{\n                   \\\"modelId\\\": \\\"$model\\\",\n                   \\\"protectedAttribute\\\": \\\"Is Male-Identifying?\\\",\n                   \\\"privilegedAttribute\\\": 1.0,\n                   \\\"unprivilegedAttribute\\\": 0.0,\n                   \\\"outcomeName\\\": \\\"Will Default?\\\",\n                   \\\"favorableOutcome\\\": 0,\n                   \\\"batchSize\\\": 5000\n               }\" | jq .\ndone\n\nfor model in \"demo-loan-nn-onnx-alpha\" \"demo-loan-nn-onnx-beta\"; do\n  echo \"Sending curl request for setting protected attribute and outcome field for model $model...\"\n  for field in \"Is Male-Identifying?\" \"Will Default?\"; do\n    curl -sk -H \"Authorization: Bearer ${TOKEN}\" -X POST $TRUSTY_ROUTE/metrics/identity/request \\\n         --header 'Content-Type: application/json' \\\n         --data \"{\n                     \\\"columnName\\\": \\\"$field\\\",\n                     \\\"batchSize\\\": 250,\n                     \\\"modelId\\\": \\\"$model\\\"\n                 }\" | jq .\n  done",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation scripts]$ cat schedule_spd.sh \n#!/bin/bash\n\noc login -u developer -p developer https://api.ocp4.example.com:6443 >/dev/null 2>&1\n\nMM_NAMESPACE=monitoring-bias\n\noc project $MM_NAMESPACE >/dev/null 2>&1\n\nTRUSTY_ROUTE=https://$(oc get route/trustyai-service --template={{.spec.host}})\nTOKEN=${TOKEN:-$(oc whoami -t)}\n\nfor model in \"demo-loan-nn-onnx-alpha\" \"demo-loan-nn-onnx-beta\"; do\n  echo \"Sending curl request for scheduling periodic SPD calculation for model $model...\"\n  curl -sk -H \"Authorization: Bearer ${TOKEN}\" -X POST $TRUSTY_ROUTE/metrics/group/fairness/spd/request \\\n       --header 'Content-Type: application/json' \\\n       --data \"{\n                   \\\"modelId\\\": \\\"$model\\\",\n                   \\\"protectedAttribute\\\": \\\"Is Male-Identifying?\\\",\n                   \\\"privilegedAttribute\\\": 1.0,\n                   \\\"unprivilegedAttribute\\\": 0.0,\n                   \\\"outcomeName\\\": \\\"Will Default?\\\",\n                   \\\"favorableOutcome\\\": 0,\n                   \\\"batchSize\\\": 5000\n               }\" | jq .\ndone\n\nfor model in \"demo-loan-nn-onnx-alpha\" \"demo-loan-nn-onnx-beta\"; do\n  echo \"Sending curl request for setting protected attribute and outcome field for model $model...\"\n  for field in \"Is Male-Identifying?\" \"Will Default?\"; do\n    curl -sk -H \"Authorization: Bearer ${TOKEN}\" -X POST $TRUSTY_ROUTE/metrics/identity/request \\\n         --header 'Content-Type: application/json' \\\n         --data \"{\n                     \\\"columnName\\\": \\\"$field\\\",\n                     \\\"batchSize\\\": 250,\n                     \\\"modelId\\\": \\\"$model\\\"\n                 }\" | jq .\n  done",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
