      "frameId": null,
      "index": "c05T",
      "roundness": null,
      "seed": 1005838579,
      "version": 1144,
      "versionNonce": 275846227,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793532383669,
      "link": null,
      "locked": false,
      "text": "--> Traditional : Static Batching :\n\n\n        °  In static Batching, you start 4 requests together and WAIT for all of them to finish\n           before you add new ones\n\n\n        ° If one request finishes early, it sits IDLE while the others catch up, MUST WAIT for others \n          and the GPU waste cycles",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Traditional : Static Batching :\n\n\n        °  In static Batching, you start 4 requests together and WAIT for all of them to finish\n           before you add new ones\n\n\n        ° If one request finishes early, it sits IDLE while the others catch up, MUST WAIT for others \n          and the GPU waste cycles",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1793532381250,
      "baseFontSize": null
    },
