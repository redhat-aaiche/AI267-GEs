      ],
      "frameId": null,
      "index": "c13V",
      "roundness": null,
      "seed": 1800096519,
      "version": 763,
      "versionNonce": 1313075079,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789295513591,
      "created": 1789295502483,
      "link": null,
      "locked": false,
      "text": "° we define detectors \n\n° we create routes that will be exposed ( to the user ) by the Guardrails Gateway\n\n° the routes are chat completions endpoints where users come in through\n\n° these endpoints will be translated to the Orchestrator ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° we define detectors \n\n° we create routes that will be exposed ( to the user ) by the Guardrails Gateway\n\n° the routes are chat completions endpoints where users come in through\n\n° these endpoints will be translated to the Orchestrator ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
