    {
      "id": "RDwW4gHHHqZxeLYsNg7hR",
      "type": "text",
      "x": 120,
      "y": 43580,
      "width": 1629.699951171875,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "S7V94Eq3X-zz74mbvcpHE",
        "iKcnZ_w_ZuZ5AfudgOSgL",
        "D0WFsCBamjABjQrphCTBd",
        "lU_L5DJgxGsQD_0DQt6Gq",
        "BAQvarXO2MxrFuIDAG5Dj",
        "S1eMyuOr_ayZwNMnQ1j24",
        "kFc6UgNc1S1heFJxAq6Pu",
        "-HfYypW86SX9SV6MFIN24",
        "nJQ7Ymaljyun0umfh-gSU",
        "w1G7ExKXEsIAAtabfNHTK"
      ],
      "frameId": null,
      "index": "c05v",
      "roundness": null,
      "seed": 860923507,
      "version": 1217,
      "versionNonce": 1002768851,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793532383669,
      "link": null,
      "locked": false,
      "text": "--> Continuous Batching :\n\n\n        °  As soon as a request finishes, a NEW one takes its place in the very next iteration\n          you can add and remove requests at at any time, so the GPU stays busy\n\n\n                ==> No wasted GPU cycles\n\n                ==> The result : 2 to 3 times higher throughput, lower latency per request\n                     and better utilization",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Continuous Batching :\n\n\n        °  As soon as a request finishes, a NEW one takes its place in the very next iteration\n          you can add and remove requests at at any time, so the GPU stays busy\n\n\n                ==> No wasted GPU cycles\n\n                ==> The result : 2 to 3 times higher throughput, lower latency per request\n                     and better utilization",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1793532381250,
      "baseFontSize": null
    },
