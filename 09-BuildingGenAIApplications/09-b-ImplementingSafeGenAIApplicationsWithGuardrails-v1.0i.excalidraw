      "isDeleted": true,
      "boundElements": [],
      "updated": 1793725905059,
      "created": 1789295053758,
      "link": null,
      "locked": false,
      "text": "° And hotsawp between unguardrailed and guardrailed models without having to change\n  any of your API contracts\n\n° So this lets you experiment really quickly between different configurations of\n  detectors\n\n° Experiment with how does the guardrailed model perform compared\n  to unguardrailed model?\n\n        ° Does it flag up the right queries ?\n        \n        ° It is really good for quick experimentation",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° And hotsawp between unguardrailed and guardrailed models without having to change\n  any of your API contracts\n\n° So this lets you experiment really quickly between different configurations of\n  detectors\n\n° Experiment with how does the guardrailed model perform compared\n  to unguardrailed model?\n\n        ° Does it flag up the right queries ?\n        \n        ° It is really good for quick experimentation",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
