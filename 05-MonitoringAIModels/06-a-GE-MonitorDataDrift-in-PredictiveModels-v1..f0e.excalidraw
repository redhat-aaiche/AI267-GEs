      "seed": 492790918,
      "version": 425,
      "versionNonce": 735642950,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785409478753,
      "link": null,
      "locked": false,
      "text": "[student@workstation scripts]$ cat trustyai_metadata.sh \n#!/bin/bash\n\noc login -u developer -p developer https://api.ocp4.example.com:6443 >/dev/null 2>&1\n\nMM_NAMESPACE=monitoring-bias\n\noc project $MM_NAMESPACE >/dev/null 2>&1\n\nTOKEN=${TOKEN:-$(oc whoami -t)}\n\n# Get the route URL for the TrustyAI service\nTRUSTY_ROUTE=https://$(oc get route/trustyai-service --template={{.spec.host}})\n\necho \"Sending curl request to TrustyAI to display metadata for model alpha...\"\n# Query the /info endpoint for the alpha model\ncurl -s  -H \"Authorization: Bearer ${TOKEN}\" $TRUSTY_ROUTE/info | jq '.[\"demo-loan-nn-onnx-alpha\"].data | {inputSchema: .inputSchema, outputSchema: .outputSchema}'\n\necho \"Sending curl request to TrustyAI to display metadata for model beta...\"\n# Query the /info endpoint for the beta model\ncurl -s -H \"Authorization: Bearer ${TOKEN}\" $TRUSTY_ROUTE/info | jq '.[\"demo-loan-nn-onnx-beta\"].data | {inputSchema: .inputSchema, outputSchema: .outputSchema}'",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation scripts]$ cat trustyai_metadata.sh \n#!/bin/bash\n\noc login -u developer -p developer https://api.ocp4.example.com:6443 >/dev/null 2>&1\n\nMM_NAMESPACE=monitoring-bias\n\noc project $MM_NAMESPACE >/dev/null 2>&1\n\nTOKEN=${TOKEN:-$(oc whoami -t)}\n\n# Get the route URL for the TrustyAI service\nTRUSTY_ROUTE=https://$(oc get route/trustyai-service --template={{.spec.host}})\n\necho \"Sending curl request to TrustyAI to display metadata for model alpha...\"\n# Query the /info endpoint for the alpha model\ncurl -s  -H \"Authorization: Bearer ${TOKEN}\" $TRUSTY_ROUTE/info | jq '.[\"demo-loan-nn-onnx-alpha\"].data | {inputSchema: .inputSchema, outputSchema: .outputSchema}'\n\necho \"Sending curl request to TrustyAI to display metadata for model beta...\"\n# Query the /info endpoint for the beta model\ncurl -s -H \"Authorization: Bearer ${TOKEN}\" $TRUSTY_ROUTE/info | jq '.[\"demo-loan-nn-onnx-beta\"].data | {inputSchema: .inputSchema, outputSchema: .outputSchema}'",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
