      "groupIds": [
        "NIQBVaAw0y8wOuDehkRCl",
        "aD7BWp29d3V7O9UIiIb64",
        "6NQ4yTZ5_--R_ER-_3bFP",
        "DNJHSsF69pw5olDeW7O2T",
        "Jb2bFQJ1Rg_gosDeM7b2e"
      ],
      "frameId": null,
      "index": "c0AKAG",
      "roundness": null,
      "seed": 847016068,
      "version": 42,
      "versionNonce": 818068484,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784400448466,
      "link": null,
      "locked": false,
      "text": "#!/bin/bash\n# Test vLLM with identical prompts\n# Usage: ./curl-llm.sh NUM_REQUESTS TOKEN [TIMEOUT] [LLM_URL]\n\nNUM_REQUESTS=${1:-10}\nTOKEN=${2}\nTIMEOUT=${3:-30}\nLLM_URL=${4:-\"http://my-llm-predictor.serving-vllm.svc.cluster.local:8080\"}\nRESULTS_DIR=\"/tmp/vllm-test-$$\"\n\nif [ -z \"$TOKEN\" ]; then\n  echo \"ERROR: TOKEN required\"\n  echo \"Usage: $0 NUM_REQUESTS TOKEN [TIMEOUT] [LLM_URL]\"\n  exit 1\nfi\n\nrm -rf \"$RESULTS_DIR\"\nmkdir -p \"$RESULTS_DIR\"\necho \"Sending $NUM_REQUESTS requests to $LLM_URL...\"\nSTART=$(date +%s)\n\nfor i in $(seq 1 $NUM_REQUESTS); do\n  curl -sk -X POST \"$LLM_URL/v1/chat/completions\" \\\n    -H \"Authorization: Bearer $TOKEN\" \\\n    -H \"Content-Type: application/json\" \\\n    --max-time $TIMEOUT \\\n    -d '{\n      \"model\": \"my-llm\",\n      \"messages\": [\n        {\"role\": \"system\", \"content\": \"You are a helpful assistant.\"},\n        {\"role\": \"user\", \"content\": \"Explain what machine learning is in one sentence.\"}\n      ],\n      \"max_tokens\": 50\n    }' -o \"$RESULTS_DIR/result-$i.json\" 2>&1 &\ndone\n\nwait\nEND=$(date +%s)\nDURATION=$((END - START))\n\n# Count successes\nSUCCESSFUL=0\nfor i in $(seq 1 $NUM_REQUESTS); do\n  if grep -q '\"choices\"' \"$RESULTS_DIR/result-$i.json\" 2>/dev/null; then\n    ((SUCCESSFUL++))\n  fi\ndone\n\nFAILED=$((NUM_REQUESTS - SUCCESSFUL))\n\necho \"Duration: ${DURATION}s\"\necho \"Success: $SUCCESSFUL/$NUM_REQUESTS\"\necho \"Failed: $FAILED/$NUM_REQUESTS\"",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#!/bin/bash\n# Test vLLM with identical prompts\n# Usage: ./curl-llm.sh NUM_REQUESTS TOKEN [TIMEOUT] [LLM_URL]\n\nNUM_REQUESTS=${1:-10}\nTOKEN=${2}\nTIMEOUT=${3:-30}\nLLM_URL=${4:-\"http://my-llm-predictor.serving-vllm.svc.cluster.local:8080\"}\nRESULTS_DIR=\"/tmp/vllm-test-$$\"\n\nif [ -z \"$TOKEN\" ]; then\n  echo \"ERROR: TOKEN required\"\n  echo \"Usage: $0 NUM_REQUESTS TOKEN [TIMEOUT] [LLM_URL]\"\n  exit 1\nfi\n\nrm -rf \"$RESULTS_DIR\"\nmkdir -p \"$RESULTS_DIR\"\necho \"Sending $NUM_REQUESTS requests to $LLM_URL...\"\nSTART=$(date +%s)\n\nfor i in $(seq 1 $NUM_REQUESTS); do\n  curl -sk -X POST \"$LLM_URL/v1/chat/completions\" \\\n    -H \"Authorization: Bearer $TOKEN\" \\\n    -H \"Content-Type: application/json\" \\\n    --max-time $TIMEOUT \\\n    -d '{\n      \"model\": \"my-llm\",\n      \"messages\": [\n        {\"role\": \"system\", \"content\": \"You are a helpful assistant.\"},\n        {\"role\": \"user\", \"content\": \"Explain what machine learning is in one sentence.\"}\n      ],\n      \"max_tokens\": 50\n    }' -o \"$RESULTS_DIR/result-$i.json\" 2>&1 &\ndone\n\nwait\nEND=$(date +%s)\nDURATION=$((END - START))\n\n# Count successes\nSUCCESSFUL=0\nfor i in $(seq 1 $NUM_REQUESTS); do\n  if grep -q '\"choices\"' \"$RESULTS_DIR/result-$i.json\" 2>/dev/null; then\n    ((SUCCESSFUL++))\n  fi\ndone\n\nFAILED=$((NUM_REQUESTS - SUCCESSFUL))\n\necho \"Duration: ${DURATION}s\"\necho \"Success: $SUCCESSFUL/$NUM_REQUESTS\"\necho \"Failed: $FAILED/$NUM_REQUESTS\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
