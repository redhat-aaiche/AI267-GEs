      "boundElements": [],
      "updated": 1793702328056,
      "link": null,
      "locked": false,
      "text": "° low throughput\n° no great performance\n° no cost performance\n\n==> Problem : it is sequential -- we can not parallelize and we see low usage of the hardware accelerator\n==> And we see low throughput\n\n==> We need  to optimize",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° low throughput\n° no great performance\n° no cost performance\n\n==> Problem : it is sequential -- we can not parallelize and we see low usage of the hardware accelerator\n==> And we see low throughput\n\n==> We need  to optimize",
      "autoResize": true,
