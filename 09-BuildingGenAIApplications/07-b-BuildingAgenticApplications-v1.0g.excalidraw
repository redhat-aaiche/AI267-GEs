      "isDeleted": false,
      "boundElements": [],
      "updated": 1791807025952,
      "created": 1791807020088,
      "link": null,
      "locked": false,
      "text": "° While the name implies that the model \n  is performing some action, \n  ==> this is not the case !\n\n° The Model is coming up with the \n  arguments to a Tool\n\nand\n\n° Actually running the Tool ( or not ) \n  is up to the user",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° While the name implies that the model \n  is performing some action, \n  ==> this is not the case !\n\n° The Model is coming up with the \n  arguments to a Tool\n\nand\n\n° Actually running the Tool ( or not ) \n  is up to the user",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
