    {
      "id": "u_TXa7QK4vdQ9B4FXYq2_",
      "type": "text",
      "x": -83.33333333333348,
      "y": 93360,
      "width": 1722.5999755859375,
      "height": 4545,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "mZx66_pdxq34sSaYPQQh6",
        "CaJxU0L4E7LgWU9FN72jh",
        "rZxHIxFadxUJMb56j3CSc",
        "iZYJ0zRhyL0MpJF7D5Z5x",
        "zoKNgGq1dA0GxZncQWvH-"
      ],
      "frameId": null,
      "index": "c0Yu",
      "roundness": null,
      "seed": 1578916755,
      "version": 506,
      "versionNonce": 1328868883,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791898543598,
      "created": 1791898526136,
      "link": null,
      "locked": false,
      "text": "[student@workstation genai-app]$ cat gradio-llm-app.py \n\nimport gradio as gr\n\n\nfrom llm_client import LLMClient\n\n\ndef create_interface(llm_client: LLMClient) -> gr.Blocks:\n    with gr.Blocks(title=\"LLM Chat Interface\") as demo:\n        gr.Markdown(\"# LLM Chat Interface\")\n        gr.Markdown(\n            \"Ask questions and get AI-powered responses with adjustable creativity.\"\n        )\n\n        chatbot = gr.Chatbot(\n            label=\"Conversation\", height=400, show_label=False, container=True\n        )\n\n        with gr.Row():\n            with gr.Column(scale=1):\n                gr.HTML(\"\")\n            with gr.Column(scale=3):\n                query_input = gr.Textbox(\n                    label=\"\",\n                    placeholder=(\n                        \"Type your message here... (Press Enter to send, \"\n                        \"Shift+Enter for new line)\"\n                    ),\n                    lines=1,\n                    max_lines=10,\n                    show_label=False,\n                )\n\n                submit_btn = gr.Button(\"Send\", variant=\"primary\", size=\"lg\")\n\n                with gr.Accordion(\"Settings\", open=True):\n                    temperature_slider = gr.Slider(\n                        label=\"Temperature\",\n                        minimum=0.0,\n                        maximum=1.0,\n                        value=0.7,\n                        step=0.1,\n                        info=\"Controls randomness: lower = focused, higher = creative\",\n                    )\n\n                    with gr.Row():\n                        gr.Markdown(f\"**Model:** `{llm_client.get_model_name()}`\")\n                        clear_btn = gr.Button(\n                            \"Clear Chat\", variant=\"secondary\", size=\"sm\"\n                        )\n            with gr.Column(scale=1):\n                gr.HTML(\"\")\n\n        # Event handlers\n        submit_btn.click(\n            fn=llm_client.query_streaming,\n            inputs=[query_input, temperature_slider, chatbot],\n            outputs=[chatbot],\n            show_progress=True,\n        )\n\n        query_input.submit(\n            fn=llm_client.query_streaming,\n            inputs=[query_input, temperature_slider, chatbot],\n            outputs=[chatbot],\n            show_progress=True,\n        )\n\n        clear_btn.click(fn=lambda: [], outputs=[chatbot])\n\n    return demo\n\n\ndef main() -> None:\n    \"\"\"Main entry point for the Gradio application.\"\"\"\n\n\n    # Initialize LLM client\n    llm_client: LLMClient = LLMClient()\n\n\n    print(\"Starting LLM Chat Interface...\")\n    print(f\"Model: {llm_client.get_model_name()}\")\n    print(\"Chat UI: http://localhost:7860\")\n\n    custom_css: str = \"\"\"\n    .gradio-container {\n        max-width: 100% !important;\n        padding-left: 0px !important;\n        padding-right: 0px !important;\n    }\n    \"\"\"\n\n    # Create and launch the interface\n    demo: gr.Blocks = create_interface(llm_client)\n    demo.launch(share=False, server_name=\"localhost\", server_port=7860, css=custom_css)\n\n\nif __name__ == \"__main__\":\n    main()",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation genai-app]$ cat gradio-llm-app.py \n\nimport gradio as gr\n\n\nfrom llm_client import LLMClient\n\n\ndef create_interface(llm_client: LLMClient) -> gr.Blocks:\n    with gr.Blocks(title=\"LLM Chat Interface\") as demo:\n        gr.Markdown(\"# LLM Chat Interface\")\n        gr.Markdown(\n            \"Ask questions and get AI-powered responses with adjustable creativity.\"\n        )\n\n        chatbot = gr.Chatbot(\n            label=\"Conversation\", height=400, show_label=False, container=True\n        )\n\n        with gr.Row():\n            with gr.Column(scale=1):\n                gr.HTML(\"\")\n            with gr.Column(scale=3):\n                query_input = gr.Textbox(\n                    label=\"\",\n                    placeholder=(\n                        \"Type your message here... (Press Enter to send, \"\n                        \"Shift+Enter for new line)\"\n                    ),\n                    lines=1,\n                    max_lines=10,\n                    show_label=False,\n                )\n\n                submit_btn = gr.Button(\"Send\", variant=\"primary\", size=\"lg\")\n\n                with gr.Accordion(\"Settings\", open=True):\n                    temperature_slider = gr.Slider(\n                        label=\"Temperature\",\n                        minimum=0.0,\n                        maximum=1.0,\n                        value=0.7,\n                        step=0.1,\n                        info=\"Controls randomness: lower = focused, higher = creative\",\n                    )\n\n                    with gr.Row():\n                        gr.Markdown(f\"**Model:** `{llm_client.get_model_name()}`\")\n                        clear_btn = gr.Button(\n                            \"Clear Chat\", variant=\"secondary\", size=\"sm\"\n                        )\n            with gr.Column(scale=1):\n                gr.HTML(\"\")\n\n        # Event handlers\n        submit_btn.click(\n            fn=llm_client.query_streaming,\n            inputs=[query_input, temperature_slider, chatbot],\n            outputs=[chatbot],\n            show_progress=True,\n        )\n\n        query_input.submit(\n            fn=llm_client.query_streaming,\n            inputs=[query_input, temperature_slider, chatbot],\n            outputs=[chatbot],\n            show_progress=True,\n        )\n\n        clear_btn.click(fn=lambda: [], outputs=[chatbot])\n\n    return demo\n\n\ndef main() -> None:\n    \"\"\"Main entry point for the Gradio application.\"\"\"\n\n\n    # Initialize LLM client\n    llm_client: LLMClient = LLMClient()\n\n\n    print(\"Starting LLM Chat Interface...\")\n    print(f\"Model: {llm_client.get_model_name()}\")\n    print(\"Chat UI: http://localhost:7860\")\n\n    custom_css: str = \"\"\"\n    .gradio-container {\n        max-width: 100% !important;\n        padding-left: 0px !important;\n        padding-right: 0px !important;\n    }\n    \"\"\"\n\n    # Create and launch the interface\n    demo: gr.Blocks = create_interface(llm_client)\n    demo.launch(share=False, server_name=\"localhost\", server_port=7860, css=custom_css)\n\n\nif __name__ == \"__main__\":\n    main()",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
