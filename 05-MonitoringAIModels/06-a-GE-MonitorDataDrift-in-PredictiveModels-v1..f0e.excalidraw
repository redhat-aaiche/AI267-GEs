      "opacity": 100,
      "groupIds": [
        "hGXdYcLCjfgiKNN2Y-4cI",
        "ZCHMT2q84BI0uBTubzLIV",
        "A2pnOXoDIMvOg9WIGCrMf",
        "JjSWn8mnCOm_jqszC31rR",
        "ipBo8pwEWo8fitUQdgDsO",
        "5Q-msXBQR_qZ7UeFHkiuP",
        "wPsqMHdoWQu9HeiHCoPga",
        "fRSCuqPkpT4LVqcIdby71",
        "A1yen-6NVmyQazhxLhqyc"
      ],
      "frameId": null,
      "index": "c1336",
      "roundness": null,
      "seed": 1582798022,
      "version": 231,
      "versionNonce": 378798475,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785573094237,
      "link": null,
      "locked": false,
      "text": "#!/usr/bin/env -S uv run --script\n#\n# /// script\n# requires-python = \">=3.11\"\n# dependencies = [\n#   \"numpy\",\n#   \"requests\",\n#   \"rich\",\n# ]\n# ///\nimport os\nimport time\nimport urllib3\nfrom typing import List\nimport requests\nimport numpy as np\nfrom rich import print\n\nurllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)\n\n\ndiabetes_model_base_url = os.getenv(\"DIABETES_MODEL_ROUTE\")\n\nif not diabetes_model_base_url:\n    raise ValueError(\"DIABETES_MODEL_ROUTE environment variable is not set\")\n\ntoken = os.getenv(\"MODEL_TOKEN\")\n\nheaders = {\"Content-Type\": \"application/json\"}\nif token:\n    headers[\"Authorization\"] = f\"Bearer {token}\"\n\nbody = {\"modelId\": \"diabetes\", \"referenceTag\": \"TRAINING\"}\n\n\ndef prepare_request_body(case_data: List[float]):\n    return {\n        \"inputs\": [\n            {\n                \"name\": \"dense_input\",\n                \"shape\": [1, 8],\n                \"datatype\": \"FP32\",\n                \"data\": case_data,\n            }\n        ]\n    }\n\n\ndef simulate_case():\n    return [\n        np.random.randint(0, 7),  # Pregnancies\n        np.random.uniform(70, 140),  # Glucose (mg/dL)\n        np.random.uniform(60, 100),  # BloodPressure (mmHg): normal diastolic range\n        np.random.uniform(10, 40),  # SkinThickness (mm): typical triceps range\n        np.random.uniform(15, 200),  # Insulin (μU/ml): fasting to post-meal range\n        np.random.uniform(18, 45),  # BMI: underweight to obese\n        np.random.uniform(0.1, 1.0),  # DiabetesPedigreeFunction\n        np.random.randint(10, 70),  # Age\n    ]\n\n\ndef parse_response(response: requests.Response):\n    print(\"Outputs: \", response.json()[\"outputs\"])\n    output = response.json()[\"outputs\"][0]\n    diabetes_probability = output[\"data\"][1]\n\n    print(\n        f\"\\nDiabetes Prediction: {'YES' if diabetes_probability > 0.5 else 'NO'} \"\n        f\"(probability: {100 * diabetes_probability:.2f}%)\"\n    )\n\n\ninference_url = f\"{diabetes_model_base_url}/v2/models/diabetes/infer\"\ncase_count = 0\nwhile True:\n    case_data = simulate_case()\n    print(f\"Case {case_count}:\")\n    print(f\" Pregnancies: {case_data[0]}\")\n    print(f\" Glucose: {case_data[1]:.2f}\")\n    print(f\" BloodPressure: {case_data[2]:.2f}\")\n    print(f\" SkinThickness: {case_data[3]:.2f}\")\n    print(f\" Insulin: {case_data[4]:.2f}\")\n    print(f\" BMI: {case_data[5]:.2f}\")\n    print(f\" DiabetesPedigreeFunction: {case_data[6]:.2f}\")\n    print(f\" Age: {case_data[7]}\")\n    request_body = prepare_request_body(case_data)\n    response = requests.post(\n        inference_url, json=request_body, headers=headers, verify=False\n    )\n\n    print(\"\\n\")\n    parse_response(response)\n    print(\"\\n\\n--------------------------------\\n\\n\")\n    time.sleep(1)\n    case_count += 1",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#!/usr/bin/env -S uv run --script\n#\n# /// script\n# requires-python = \">=3.11\"\n# dependencies = [\n#   \"numpy\",\n#   \"requests\",\n#   \"rich\",\n# ]\n# ///\nimport os\nimport time\nimport urllib3\nfrom typing import List\nimport requests\nimport numpy as np\nfrom rich import print\n\nurllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)\n\n\ndiabetes_model_base_url = os.getenv(\"DIABETES_MODEL_ROUTE\")\n\nif not diabetes_model_base_url:\n    raise ValueError(\"DIABETES_MODEL_ROUTE environment variable is not set\")\n\ntoken = os.getenv(\"MODEL_TOKEN\")\n\nheaders = {\"Content-Type\": \"application/json\"}\nif token:\n    headers[\"Authorization\"] = f\"Bearer {token}\"\n\nbody = {\"modelId\": \"diabetes\", \"referenceTag\": \"TRAINING\"}\n\n\ndef prepare_request_body(case_data: List[float]):\n    return {\n        \"inputs\": [\n            {\n                \"name\": \"dense_input\",\n                \"shape\": [1, 8],\n                \"datatype\": \"FP32\",\n                \"data\": case_data,\n            }\n        ]\n    }\n\n\ndef simulate_case():\n    return [\n        np.random.randint(0, 7),  # Pregnancies\n        np.random.uniform(70, 140),  # Glucose (mg/dL)\n        np.random.uniform(60, 100),  # BloodPressure (mmHg): normal diastolic range\n        np.random.uniform(10, 40),  # SkinThickness (mm): typical triceps range\n        np.random.uniform(15, 200),  # Insulin (μU/ml): fasting to post-meal range\n        np.random.uniform(18, 45),  # BMI: underweight to obese\n        np.random.uniform(0.1, 1.0),  # DiabetesPedigreeFunction\n        np.random.randint(10, 70),  # Age\n    ]\n\n\ndef parse_response(response: requests.Response):\n    print(\"Outputs: \", response.json()[\"outputs\"])\n    output = response.json()[\"outputs\"][0]\n    diabetes_probability = output[\"data\"][1]\n\n    print(\n        f\"\\nDiabetes Prediction: {'YES' if diabetes_probability > 0.5 else 'NO'} \"\n        f\"(probability: {100 * diabetes_probability:.2f}%)\"\n    )\n\n\ninference_url = f\"{diabetes_model_base_url}/v2/models/diabetes/infer\"\ncase_count = 0\nwhile True:\n    case_data = simulate_case()\n    print(f\"Case {case_count}:\")\n    print(f\" Pregnancies: {case_data[0]}\")\n    print(f\" Glucose: {case_data[1]:.2f}\")\n    print(f\" BloodPressure: {case_data[2]:.2f}\")\n    print(f\" SkinThickness: {case_data[3]:.2f}\")\n    print(f\" Insulin: {case_data[4]:.2f}\")\n    print(f\" BMI: {case_data[5]:.2f}\")\n    print(f\" DiabetesPedigreeFunction: {case_data[6]:.2f}\")\n    print(f\" Age: {case_data[7]}\")\n    request_body = prepare_request_body(case_data)\n    response = requests.post(\n        inference_url, json=request_body, headers=headers, verify=False\n    )\n\n    print(\"\\n\")\n    parse_response(response)\n    print(\"\\n\\n--------------------------------\\n\\n\")\n    time.sleep(1)\n    case_count += 1",
      "autoResize": true,
