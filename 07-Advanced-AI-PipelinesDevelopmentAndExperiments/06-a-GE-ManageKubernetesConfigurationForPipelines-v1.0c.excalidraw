    {
      "id": "dwzNNRd23a0dWhxycDz1i",
      "type": "text",
      "x": -100,
      "y": 21500,
      "width": 1742.4000244140625,
      "height": 4680,
      "angle": 0,
      "strokeColor": "#1e1e1e",
