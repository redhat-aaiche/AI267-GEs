      "link": null,
      "locked": false,
      "text": "--> Responses API :\n\n        ° Agentic by default :\n            - Contains an agentic loop built-in, so i can call multiple tools in a single API\n\n        ° Stateful :\n            -  Allows you to store your history and use it by referring to previous message id",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Responses API :\n\n        ° Agentic by default :\n            - Contains an agentic loop built-in, so i can call multiple tools in a single API\n\n        ° Stateful :\n            -  Allows you to store your history and use it by referring to previous message id",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
