      "text": "[student@workstation monitoring-bias]$ curl -s  -H \"Authorization: Bearer ${TOKEN}\" $TRUSTY_ROUTE/info | jq\n{\n  \"demo-loan-nn-onnx-alpha\": {\n    \"metrics\": {\n      \"scheduledMetadata\": {\n        \"metricCounts\": {}\n      }\n    },\n    \"data\": {\n      \"inputSchema\": {\n        \"items\": {\n          \n          \"Number of Children\": {\n            \"type\": \"DOUBLE\",\n            \"name\": \"customer_data_input-0\",\n            \"columnIndex\": 0\n          },\n          \n          ...\n\n          \"Length of Employment?\": {\n            \"type\": \"DOUBLE\",\n            \"name\": \"customer_data_input-10\",\n            \"columnIndex\": 10\n          }\n        },\n\n        \"nameMapping\": {\n          \"customer_data_input-0\": \"Number of Children\",\n          \"customer_data_input-1\": \"Total Income\",\n          \"customer_data_input-2\": \"Number of Total Family Members\",\n          \"customer_data_input-3\": \"Is Male-Identifying?\",\n          \"customer_data_input-4\": \"Owns Car?\",\n          \"customer_data_input-5\": \"Owns Realty?\",\n          \"customer_data_input-6\": \"Is Partnered?\",\n          \"customer_data_input-7\": \"Is Employed?\",\n          \"customer_data_input-8\": \"Live with Parents?\",\n          \"customer_data_input-9\": \"Age\",\n          \"customer_data_input-10\": \"Length of Employment?\"\n        }\n      },\n      \"outputSchema\": {\n        \"items\": {\n          \"Will Default?\": {\n            \"type\": \"INT64\",\n            \"name\": \"predict\",\n            \"columnIndex\": 11\n          }\n        },\n        \"nameMapping\": {\n          \"predict\": \"Will Default?\"\n        }\n      },\n      \"inputTensorName\": \"input\",\n      \"outputTensorName\": \"output\",\n      \"observations\": 2368\n    }\n  },\n\n\n\n  \"demo-loan-nn-onnx-beta\": {\n    \"metrics\": {\n      \"scheduledMetadata\": {\n        \"metricCounts\": {}\n      }\n    },\n    \"data\": {\n      \"inputSchema\": {\n        \"items\": {\n\n          \"Number of Children\": {\n            \"type\": \"DOUBLE\",\n            \"name\": \"customer_data_input-0\",\n            \"columnIndex\": 0\n          },\n\n          ...\n\n          \"Length of Employment?\": {\n            \"type\": \"DOUBLE\",\n            \"name\": \"customer_data_input-10\",\n            \"columnIndex\": 10\n          }\n        },\n\n        \"nameMapping\": {\n          \"customer_data_input-0\": \"Number of Children\",\n          \"customer_data_input-1\": \"Total Income\",\n          \"customer_data_input-2\": \"Number of Total Family Members\",\n          \"customer_data_input-3\": \"Is Male-Identifying?\",\n          \"customer_data_input-4\": \"Owns Car?\",\n          \"customer_data_input-5\": \"Owns Realty?\",\n          \"customer_data_input-6\": \"Is Partnered?\",\n          \"customer_data_input-7\": \"Is Employed?\",\n          \"customer_data_input-8\": \"Live with Parents?\",\n          \"customer_data_input-9\": \"Age\",\n          \"customer_data_input-10\": \"Length of Employment?\"\n        }\n      },\n      \"outputSchema\": {\n        \"items\": {\n          \"Will Default?\": {\n            \"type\": \"INT64\",\n            \"name\": \"predict\",\n            \"columnIndex\": 11\n          }\n        },\n        \"nameMapping\": {\n          \"predict\": \"Will Default?\"\n        }\n      },\n      \"inputTensorName\": \"input\",\n      \"outputTensorName\": \"output\",\n      \"observations\": 2368\n    }\n  }\n}",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
