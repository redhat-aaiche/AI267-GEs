    {
      "id": "zaQ8BEF7tVuMq3HogNBmR",
      "type": "text",
      "x": 124.51467521938775,
      "y": 114336.14569880627,
      "width": 1326.5999755859375,
      "height": 1710,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "3mIzDotGLElkYpzaRN8WG",
        "psQGieWXBxLlTvaDrU0nH",
        "tFkxQMnOTt5hc0uglbMLu",
        "j8q2IlnHwvSgayQVVAH8F",
        "wt9LbN5a58O7ydx2zTTTy",
        "ArubpfnVkM755KNfBb1Bn",
        "eyuK0294IlMbOPoTfAm2C"
      ],
      "frameId": null,
      "index": "c0bm",
      "roundness": null,
      "seed": 1172794081,
      "version": 818,
      "versionNonce": 1958551073,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791879952284,
      "link": null,
      "locked": false,
      "text": "[student@workstation genai-rag]$ cat query_rag.py \n\"\"\"Query the RAG vector store.\n\nThis script uses the Llama Stack vector stores API to perform a\nsimilarity search and retrieve relevant document chunks.\n\"\"\"\n\nimport logging\n\nimport httpx\nfrom llama_stack_client import LlamaStackClient\n\nlogging.getLogger(\"httpx\").setLevel(logging.WARNING)\n\nLS_URL = \"https://llamastack-api-genai-rag.apps.lab.example.com\"\n\nhttp_client = httpx.Client(verify=False, timeout=300.0)\nclient = LlamaStackClient(base_url=LS_URL, http_client=http_client)\n\n# Get the vector store ID\nstores = client.vector_stores.list()\nvs_id = next(s.id for s in stores.data if s.name == \"rag-docs\")\n\nquery = \"What is model serving in OpenShift AI?\"\nprint(f\"Query: {query}\")\n\n# TODO: add implementation\nresults = client.vector_stores.search(\n    vector_store_id=vs_id,\n    query=query,\n    max_num_results=3,\n)\n\nprint(\"Results:\")\nfor r in results.data:\n    print(f\"Score: {r.score:.4f}\")\n    print(f\"Content: {r.content[0].text[:200]}...\")\n    print(\"---\")",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation genai-rag]$ cat query_rag.py \n\"\"\"Query the RAG vector store.\n\nThis script uses the Llama Stack vector stores API to perform a\nsimilarity search and retrieve relevant document chunks.\n\"\"\"\n\nimport logging\n\nimport httpx\nfrom llama_stack_client import LlamaStackClient\n\nlogging.getLogger(\"httpx\").setLevel(logging.WARNING)\n\nLS_URL = \"https://llamastack-api-genai-rag.apps.lab.example.com\"\n\nhttp_client = httpx.Client(verify=False, timeout=300.0)\nclient = LlamaStackClient(base_url=LS_URL, http_client=http_client)\n\n# Get the vector store ID\nstores = client.vector_stores.list()\nvs_id = next(s.id for s in stores.data if s.name == \"rag-docs\")\n\nquery = \"What is model serving in OpenShift AI?\"\nprint(f\"Query: {query}\")\n\n# TODO: add implementation\nresults = client.vector_stores.search(\n    vector_store_id=vs_id,\n    query=query,\n    max_num_results=3,\n)\n\nprint(\"Results:\")\nfor r in results.data:\n    print(f\"Score: {r.score:.4f}\")\n    print(f\"Content: {r.content[0].text[:200]}...\")\n    print(\"---\")",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1791879939768,
      "labelPosition": null,
      "baseFontSize": null
    },
