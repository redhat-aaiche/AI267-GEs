      "y": 46516.52411120439,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "width": 1176.816650390625,
      "height": 1125,
      "seed": 562408394,
      "groupIds": [
        "Ph5sWcPDy1t_SSWcQB-Ii",
        "CM1cQXh4yfKjdOR_Uo9qD",
        "Y7xcXJVXoEhhzRKLjYLqS"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1793707673466,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Data Science Pipelines is a CORE component of OpenShift AI\n\n--> DSP handles :\n        ° all of the AI/ML workflows\n     and \n        ° automation \n     within OpenShift AI\n\n\n--> DS Pipeline is about the end-to-end model lifecycle\n    of your AI/ML operations :\n\n        ° Can be used during :\n            - Data Collection\n            - Normalization\n            - Training\n        ° ....\n\n\n--> DS Pipelines are based on the Kubeflow pipeline domain-specific\n    language ( DSL ) \nand \n    ° backed by the Tekton engine : v2.8 \n\n    ° backed by the ARGO engine : >= v2.9",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Data Science Pipelines is a CORE component of OpenShift AI\n\n--> DSP handles :\n        ° all of the AI/ML workflows\n     and \n        ° automation \n     within OpenShift AI\n\n\n--> DS Pipeline is about the end-to-end model lifecycle\n    of your AI/ML operations :\n\n        ° Can be used during :\n            - Data Collection\n            - Normalization\n            - Training\n        ° ....\n\n\n--> DS Pipelines are based on the Kubeflow pipeline domain-specific\n    language ( DSL ) \nand \n    ° backed by the Tekton engine : v2.8 \n\n    ° backed by the ARGO engine : >= v2.9",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793610981585,
      "labelPosition": null,
      "baseFontSize": null
    },
