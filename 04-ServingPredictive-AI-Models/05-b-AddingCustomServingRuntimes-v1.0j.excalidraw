    {
      "id": "m31jk9dFIk28VozTE7wqP",
      "type": "text",
      "x": 120,
      "y": 24419.979948866727,
      "width": 1623.5999755859375,
      "height": 270,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "sNLcdmpq5pUMZbB9Fes2w",
        "ikJZTEYoNcfBqxrcSQQH0"
      ],
      "frameId": null,
      "index": "c0UU",
      "roundness": null,
      "seed": 70651005,
      "version": 395,
      "versionNonce": 1225731932,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793703919832,
      "link": null,
      "locked": false,
      "text": "° Because our platform takes a bring your own model approach, we've tried to \n  add in runtimes that cover a variety of popular models today.\n° But you may have your own type of model that you want to be able to deploy\n  within OpenShift AI, in which case, you may need to bring your own model server.\n° In this chapter, we're going to show how to do that through both \n  a single-server model or a multi-server model.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Because our platform takes a bring your own model approach, we've tried to \n  add in runtimes that cover a variety of popular models today.\n° But you may have your own type of model that you want to be able to deploy\n  within OpenShift AI, in which case, you may need to bring your own model server.\n° In this chapter, we're going to show how to do that through both \n  a single-server model or a multi-server model.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793542880860,
      "labelPosition": null,
      "baseFontSize": null
    },
