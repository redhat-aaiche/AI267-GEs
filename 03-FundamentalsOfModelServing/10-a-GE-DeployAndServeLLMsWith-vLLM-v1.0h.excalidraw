      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 709.9755348494193,
      "y": -1364.208743865216,
      "strokeColor": "#a61e4d",
      "backgroundColor": "transparent",
      "width": 567.5833129882812,
      "height": 46.621660570922714,
      "seed": 2114528280,
