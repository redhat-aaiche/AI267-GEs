    {
      "id": "gF6_q5_VbSsLk-btZr2x2",
      "type": "text",
      "x": 100,
      "y": 13260,
      "width": 970.2000122070312,
      "height": 2925,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vSFjYy7snkPHECrefZy9n",
        "TIP4ZVXJn_Ht7dCbiIzjF",
        "vxs1FtD4n_ncSQVxLvvaE"
      ],
      "frameId": null,
      "index": "by5",
