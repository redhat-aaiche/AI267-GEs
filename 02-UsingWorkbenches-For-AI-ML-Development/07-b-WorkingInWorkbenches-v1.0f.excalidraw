      "roundness": null,
      "boundElements": [],
      "updated": 1793700429676,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 8,
      "text": "- You can specify this when you start your training by\n  setting the logdir variable to the path that you want\n  this data to be stored\n\n- You can then run your TensorBoard off this particular\n  log file\n\n- Another aspect here is you can choose the type of data\n  that you're saving to your log directory",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- You can specify this when you start your training by\n  setting the logdir variable to the path that you want\n  this data to be stored\n\n- You can then run your TensorBoard off this particular\n  log file\n\n- Another aspect here is you can choose the type of data\n  that you're saving to your log directory",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793442729204,
      "labelPosition": null,
      "baseFontSize": null
    },
