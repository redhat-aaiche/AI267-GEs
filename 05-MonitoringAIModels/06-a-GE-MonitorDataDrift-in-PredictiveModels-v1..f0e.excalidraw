      "link": null,
      "locked": false,
      "text": "[student@workstation scripts]$ cat check_spd.sh \n#!/bin/bash\n\noc login -u developer -p developer https://api.ocp4.example.com:6443 >/dev/null 2>&1\n\nMM_NAMESPACE=monitoring-bias\n\noc project $MM_NAMESPACE >/dev/null 2>&1\n\nTRUSTY_ROUTE=https://$(oc get route/trustyai-service --template={{.spec.host}})\nTOKEN=${TOKEN:-$(oc whoami -t)}\n\necho \"Sending curl request to /metrics/group/fairness/spd for calculating SPD for Model alpha...\"\ncurl -sk -H \"Authorization: Bearer ${TOKEN}\" -X POST $TRUSTY_ROUTE/metrics/group/fairness/spd \\\n     --header 'Content-Type: application/json' \\\n     --data \"{\n                 \\\"modelId\\\": \\\"demo-loan-nn-onnx-alpha\\\",\n                 \\\"protectedAttribute\\\": \\\"Is Male-Identifying?\\\",\n                 \\\"privilegedAttribute\\\": 1.0,\n                 \\\"unprivilegedAttribute\\\": 0.0,\n                 \\\"outcomeName\\\": \\\"Will Default?\\\",\n                 \\\"favorableOutcome\\\": 0,\n                 \\\"batchSize\\\": 5000\n             }\" | jq .\n\necho\necho \"Sending curl request to /metrics/group/fairness/spd for calculating SPD for Model beta...\"\ncurl -sk -H \"Authorization: Bearer ${TOKEN}\" -X POST $TRUSTY_ROUTE/metrics/group/fairness/spd \\\n     --header 'Content-Type: application/json' \\\n     --data \"{\n                 \\\"modelId\\\": \\\"demo-loan-nn-onnx-beta\\\",\n                 \\\"protectedAttribute\\\": \\\"Is Male-Identifying?\\\",\n                 \\\"privilegedAttribute\\\": 1.0,\n                 \\\"unprivilegedAttribute\\\": 0.0,\n                 \\\"outcomeName\\\": \\\"Will Default?\\\",\n                 \\\"favorableOutcome\\\": 0,\n                 \\\"batchSize\\\": 5000\n             }\" | jq .",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation scripts]$ cat check_spd.sh \n#!/bin/bash\n\noc login -u developer -p developer https://api.ocp4.example.com:6443 >/dev/null 2>&1\n\nMM_NAMESPACE=monitoring-bias\n\noc project $MM_NAMESPACE >/dev/null 2>&1\n\nTRUSTY_ROUTE=https://$(oc get route/trustyai-service --template={{.spec.host}})\nTOKEN=${TOKEN:-$(oc whoami -t)}\n\necho \"Sending curl request to /metrics/group/fairness/spd for calculating SPD for Model alpha...\"\ncurl -sk -H \"Authorization: Bearer ${TOKEN}\" -X POST $TRUSTY_ROUTE/metrics/group/fairness/spd \\\n     --header 'Content-Type: application/json' \\\n     --data \"{\n                 \\\"modelId\\\": \\\"demo-loan-nn-onnx-alpha\\\",\n                 \\\"protectedAttribute\\\": \\\"Is Male-Identifying?\\\",\n                 \\\"privilegedAttribute\\\": 1.0,\n                 \\\"unprivilegedAttribute\\\": 0.0,\n                 \\\"outcomeName\\\": \\\"Will Default?\\\",\n                 \\\"favorableOutcome\\\": 0,\n                 \\\"batchSize\\\": 5000\n             }\" | jq .\n\necho\necho \"Sending curl request to /metrics/group/fairness/spd for calculating SPD for Model beta...\"\ncurl -sk -H \"Authorization: Bearer ${TOKEN}\" -X POST $TRUSTY_ROUTE/metrics/group/fairness/spd \\\n     --header 'Content-Type: application/json' \\\n     --data \"{\n                 \\\"modelId\\\": \\\"demo-loan-nn-onnx-beta\\\",\n                 \\\"protectedAttribute\\\": \\\"Is Male-Identifying?\\\",\n                 \\\"privilegedAttribute\\\": 1.0,\n                 \\\"unprivilegedAttribute\\\": 0.0,\n                 \\\"outcomeName\\\": \\\"Will Default?\\\",\n                 \\\"favorableOutcome\\\": 0,\n                 \\\"batchSize\\\": 5000\n             }\" | jq .",
