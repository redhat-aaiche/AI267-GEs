      "frameId": null,
      "index": "c079",
      "roundness": null,
      "seed": 988543645,
      "version": 1632,
      "versionNonce": 660085053,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793532394859,
      "link": null,
      "locked": false,
      "text": "° We  store the shared Prefix once\n\n==> All 3 chats reference the same  Physical blocks for that prefix with\n     pointers from each request  to the shared region\n\n==> When a chat diverges, it continues by writing new tokens into new blocks, leaving \n     the shared prefix intact\n\n==> The KV memory is saved",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° We  store the shared Prefix once\n\n==> All 3 chats reference the same  Physical blocks for that prefix with\n     pointers from each request  to the shared region\n\n==> When a chat diverges, it continues by writing new tokens into new blocks, leaving \n     the shared prefix intact\n\n==> The KV memory is saved",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1793532391497,
      "baseFontSize": null
    },
