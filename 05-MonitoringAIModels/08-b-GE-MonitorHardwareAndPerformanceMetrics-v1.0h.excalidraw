      "groupIds": [
        "0IerIkrHBMFAVBGlazhoV",
        "FjebdIC4YvPHyjZ2purPE",
        "xBXPV4HqaKrou3WqvzvDb",
        "g_hAzXyWoOqQz3lWbuBVk",
        "z3gjqKxC9AJVpOZy8vQVs"
      ],
      "frameId": null,
      "index": "c01I",
      "roundness": null,
      "seed": 365012827,
      "version": 436,
      "versionNonce": 684915387,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793000475630,
      "link": null,
      "locked": false,
      "text": "#!/bin/bash\n# Send inference requests to the Qwen3-0.6B model to generate vLLM metrics.\n# Usage: ./request_inference_to_qwen3.sh [NUM_REQUESTS] [INTERVAL_SECONDS]\n#\n# Defaults: 20 requests, 10 seconds apart\n# The interval is long because the model runs on CPU with limited resources.\n\nNUM_REQUESTS=${1:-20}\nINTERVAL=${2:-10}\n\nROUTE=$(oc get route qwen3-06b -n monitoring-performance -o jsonpath='{.spec.host}')\nif [ -z \"$ROUTE\" ]; then\n    echo \"ERROR: Could not find the qwen3-06b route in the monitoring-performance namespace.\"\n    echo \"Make sure the model is deployed: oc get routes -n monitoring-performance\"\n    exit 1\nfi\n\nURL=\"https://${ROUTE}/v1/chat/completions\"\n\nPROMPTS=(\n    \"What is Kubernetes?\"\n    \"Explain containers in one sentence.\"\n    \"What is OpenShift?\"\n    \"Define machine learning briefly.\"\n    \"What is model serving?\"\n    \"Explain inference in AI.\"\n    \"What is a neural network?\"\n    \"Define MLOps in one sentence.\"\n    \"What is a GPU?\"\n    \"Explain Prometheus monitoring.\"\n)\n\necho \"Sending ${NUM_REQUESTS} inference requests to ${URL}\"\necho \"Interval: ${INTERVAL}s between requests (CPU model, be patient)\"\necho \"\"\n\nfor i in $(seq 1 \"${NUM_REQUESTS}\"); do\n    # Cycle through prompts\n    IDX=$(( (i - 1) % ${#PROMPTS[@]} ))\n    PROMPT=\"${PROMPTS[$IDX]}\"\n\n    RESPONSE=$(curl -sk -X POST \"${URL}\" \\\n        -H \"Content-Type: application/json\" \\\n        -d \"{\\\"model\\\": \\\"qwen3-06b\\\", \\\"messages\\\": [{\\\"role\\\": \\\"user\\\", \\\"content\\\": \\\"${PROMPT}\\\"}], \\\"max_tokens\\\": 150, \\\"chat_template_kwargs\\\": {\\\"enable_thinking\\\": false}}\")\n    ANSWER=$(echo \"${RESPONSE}\" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d[\"choices\"][0][\"message\"][\"content\"].strip())' 2>/dev/null || echo \"(error parsing response)\")\n    echo \"Request ${i}/${NUM_REQUESTS} - \\\"${PROMPT}\\\"\"\n    echo \"  -> ${ANSWER}\"\n    echo \"\"\n    if [ \"${i}\" -lt \"${NUM_REQUESTS}\" ]; then\n        sleep \"${INTERVAL}\"\n    fi\ndone\n\necho \"\"\necho \"Done. Check the vLLM Grafana dashboard for updated metrics.\"\necho \"Select 'qwen3-06b' in the model_name dropdown.\"",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#!/bin/bash\n# Send inference requests to the Qwen3-0.6B model to generate vLLM metrics.\n# Usage: ./request_inference_to_qwen3.sh [NUM_REQUESTS] [INTERVAL_SECONDS]\n#\n# Defaults: 20 requests, 10 seconds apart\n# The interval is long because the model runs on CPU with limited resources.\n\nNUM_REQUESTS=${1:-20}\nINTERVAL=${2:-10}\n\nROUTE=$(oc get route qwen3-06b -n monitoring-performance -o jsonpath='{.spec.host}')\nif [ -z \"$ROUTE\" ]; then\n    echo \"ERROR: Could not find the qwen3-06b route in the monitoring-performance namespace.\"\n    echo \"Make sure the model is deployed: oc get routes -n monitoring-performance\"\n    exit 1\nfi\n\nURL=\"https://${ROUTE}/v1/chat/completions\"\n\nPROMPTS=(\n    \"What is Kubernetes?\"\n    \"Explain containers in one sentence.\"\n    \"What is OpenShift?\"\n    \"Define machine learning briefly.\"\n    \"What is model serving?\"\n    \"Explain inference in AI.\"\n    \"What is a neural network?\"\n    \"Define MLOps in one sentence.\"\n    \"What is a GPU?\"\n    \"Explain Prometheus monitoring.\"\n)\n\necho \"Sending ${NUM_REQUESTS} inference requests to ${URL}\"\necho \"Interval: ${INTERVAL}s between requests (CPU model, be patient)\"\necho \"\"\n\nfor i in $(seq 1 \"${NUM_REQUESTS}\"); do\n    # Cycle through prompts\n    IDX=$(( (i - 1) % ${#PROMPTS[@]} ))\n    PROMPT=\"${PROMPTS[$IDX]}\"\n\n    RESPONSE=$(curl -sk -X POST \"${URL}\" \\\n        -H \"Content-Type: application/json\" \\\n        -d \"{\\\"model\\\": \\\"qwen3-06b\\\", \\\"messages\\\": [{\\\"role\\\": \\\"user\\\", \\\"content\\\": \\\"${PROMPT}\\\"}], \\\"max_tokens\\\": 150, \\\"chat_template_kwargs\\\": {\\\"enable_thinking\\\": false}}\")\n    ANSWER=$(echo \"${RESPONSE}\" | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d[\"choices\"][0][\"message\"][\"content\"].strip())' 2>/dev/null || echo \"(error parsing response)\")\n    echo \"Request ${i}/${NUM_REQUESTS} - \\\"${PROMPT}\\\"\"\n    echo \"  -> ${ANSWER}\"\n    echo \"\"\n    if [ \"${i}\" -lt \"${NUM_REQUESTS}\" ]; then\n        sleep \"${INTERVAL}\"\n    fi\ndone\n\necho \"\"\necho \"Done. Check the vLLM Grafana dashboard for updated metrics.\"\necho \"Select 'qwen3-06b' in the model_name dropdown.\"",
