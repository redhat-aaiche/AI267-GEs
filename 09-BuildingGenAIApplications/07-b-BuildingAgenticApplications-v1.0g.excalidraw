      "text": "Responses API :\n    ° Server-side agentic \n      orchestration with \n      - tool calling, \n      - MCP, \n      and \n      - file search",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Responses API :\n    ° Server-side agentic \n      orchestration with \n      - tool calling, \n      - MCP, \n      and \n      - file search",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "luMGer_z3gfOT21erNDYv",
      "type": "text",
      "x": 100,
      "y": 99800,
      "width": 1612.816650390625,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e6fcf5",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jxVb_QivuSTv5HSoLf_Ve",
        "yNbMcKsvyb5ZdW1YGlQH5",
        "y87oLwSFi_NJEkGpKDbZt",
        "UIWe0mQEvt3Ls23Z7-SrC",
        "U5MVb6mECMW44f4vP3a59",
