      "link": null,
      "locked": false,
      "text": "# pipeline.py\nfrom kfp import compiler, dsl\nfrom src.my_component import add\n\n@dsl.pipeline\ndef addition_pipeline(x: int, y: int) -> int:\n    task1 = add(a=x, b=y)\n    task2 = add(a=task1.output, b=x)\n    return task2.output\n\ncompiler.Compiler().compile(addition_pipeline, 'pipeline.yaml')",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# pipeline.py\nfrom kfp import compiler, dsl\nfrom src.my_component import add\n\n@dsl.pipeline\ndef addition_pipeline(x: int, y: int) -> int:\n    task1 = add(a=x, b=y)\n    task2 = add(a=task1.output, b=x)\n    return task2.output\n\ncompiler.Compiler().compile(addition_pipeline, 'pipeline.yaml')",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793614397837,
      "labelPosition": null,
      "baseFontSize": null
    },
