    {
      "id": "kJB4AAOyDNRD27htdkPER",
      "type": "text",
      "x": -520,
      "y": 55640,
      "width": 3960,
      "height": 10305,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "KGvfkAqezFGErzUErQP9g"
      ],
      "frameId": null,
      "index": "c0Mh",
