      "seed": 1757242890,
      "version": 408,
      "versionNonce": 316938378,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793609088667,
      "link": null,
      "locked": false,
      "text": "## Troubleshooting\n\n### \"Error id ...\" when uploading data\n\nData already exists. Either:\n- Work with existing data\n- Delete data by removing files from `/inputs` dir in TrustyAI pod and restart\n\n### How to clear TrustyAI data\n\n# SSH into pod\noc rsh $(oc get pod -l app=trustyai-service -o name)\n\n# Inside pod\nrm -rf /inputs/*\nexit\n\n# Restart pod\noc delete pod -l app=trustyai-service",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "## Troubleshooting\n\n### \"Error id ...\" when uploading data\n\nData already exists. Either:\n- Work with existing data\n- Delete data by removing files from `/inputs` dir in TrustyAI pod and restart\n\n### How to clear TrustyAI data\n\n# SSH into pod\noc rsh $(oc get pod -l app=trustyai-service -o name)\n\n# Inside pod\nrm -rf /inputs/*\nexit\n\n# Restart pod\noc delete pod -l app=trustyai-service",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793609083124,
      "labelPosition": null,
      "baseFontSize": null
    },
