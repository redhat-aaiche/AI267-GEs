      "text": "\n[student@workstation monitoring-bias]$ curl -s -H \"Authorization: Bearer $TOKEN\"  \\ \n    https://demo-loan-nn-onnx-alpha-monitoring-bias.apps.lab.example.com/v2/models/demo-loan-nn-onnx-alpha | jq\n{\n  \"name\": \"demo-loan-nn-onnx-alpha\",\n  \"versions\": [\n    \"1\"\n  ],\n  \"platform\": \"OpenVINO\",\n  \"inputs\": [\n    {\n      \"name\": \"customer_data_input\",\n      \"datatype\": \"FP64\",\n      \"shape\": [\n        -1,\n        11\n      ]\n    }\n  ],\n  \"outputs\": [\n    {\n      \"name\": \"predict\",\n      \"datatype\": \"INT64\",\n      \"shape\": [\n        -1\n      ]\n    }\n  ]\n}",
