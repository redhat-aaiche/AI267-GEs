    {
      "type": "text",
      "version": 1282,
      "versionNonce": 1357505110,
      "index": "bpF",
      "isDeleted": true,
      "id": "7ehkNFYQSKkgASLao8WsF",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 754.3463412255578,
      "y": 3011.417562610722,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1287.4000244140625,
      "height": 630,
      "seed": 965739880,
      "groupIds": [
        "lZXQDLwek1llB_j7zxfVY"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1775819729240,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Tekton is the foundation of OpenShift Pipelines\n--> Tekton components :\n    ° Incldude  graphical representations of pipelines in the Web Console\n\n\n--> Tekton lets you create pipelines of repeatable steps.\n     \n    ° Tekton steps happen in a pod specifically created for the task.\n    ° Tekton tasks are therefore isolated from one another and\n      from the rest of the cluster, but you don’t have to manage \n     a dedicated build server.\n\n Tekton’s moving parts are Kubernetes resources, so you can\n  use familiar tools to create, manage, and monitor Tekton pipelines",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Tekton is the foundation of OpenShift Pipelines\n--> Tekton components :\n    ° Incldude  graphical representations of pipelines in the Web Console\n\n\n--> Tekton lets you create pipelines of repeatable steps.\n     \n    ° Tekton steps happen in a pod specifically created for the task.\n    ° Tekton tasks are therefore isolated from one another and\n      from the rest of the cluster, but you don’t have to manage \n     a dedicated build server.\n\n Tekton’s moving parts are Kubernetes resources, so you can\n  use familiar tools to create, manage, and monitor Tekton pipelines",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
