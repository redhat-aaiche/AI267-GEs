      "text": "kind: ConfigMap\napiVersion: v1\nmetadata:\n  name: fms-orchestr8-config-gateway\n  labels:\n    app: fmstack-nlp\ndata:\n  config.yaml: |\n    orchestrator:\n      host: \"localhost\"\n      port: 8032\n    detectors:\n      - name: regex\n        input: true\n        output: true\n        detector_params: \n          regex:\n            - email\n            - us-phone-number\n            - credit-card\n            - \\b(?i:vmware|broadcom|docker|oracle|suse)\\b          \n      - name: hap\n        input: true\n        output: true\n        detector_params: {}\n    routes:\n      - name: all\n        detectors: \n          - regex\n          - hap          \n      - name: hap\n        detectors:\n          - hap            \n      - name: passthrough\n        detectors:",
