    {
      "id": "e_r_ba53YGeXWkX7MLKlg",
      "type": "text",
      "x": 629.8505323062868,
      "y": -6026.106246913091,
      "width": 1623.5999755859375,
      "height": 33.6,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bof",
