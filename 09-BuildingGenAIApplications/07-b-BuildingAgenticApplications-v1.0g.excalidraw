    {
      "id": "Nlf-2th9yP8xU8Owr-InI",
      "type": "text",
      "x": 120,
      "y": 102920,
      "width": 1742.4000244140625,
      "height": 1530,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "#e6fcf5",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Y5Uz0K2YyV6j-svuKHTF_",
        "75t7HRu3RCJQInEt1RR4H",
        "BkmSMtR08Mv-3_BUNQ7GU"
      ],
      "frameId": null,
      "index": "c0eM",
      "roundness": null,
      "seed": 1739180625,
      "version": 130,
      "versionNonce": 472617572,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793725730285,
      "created": 1791807429776,
      "link": null,
      "locked": false,
      "text": "from llama_stack_client import LlamaStackClient\n\n...\n\ndef get_client() -> LlamaStackClient:\n    \"\"\"Create Llama Stack client with SSL verification disabled and extended timeout.\"\"\"\n    return LlamaStackClient(\n        base_url=LLAMA_STACK_URL,\n        http_client=httpx.Client(verify=False, timeout=300.0),\n    )\n...\n\ndef run_agent(client: LlamaStackClient, user_input: str) -> str:\n    \"\"\"Run agent using Responses API - server handles tool execution loop.\"\"\"\n    instructions = (\n        \"You are a helpful todo assistant. Use the available tools to manage tasks.\"\n    )\n    response = client.responses.create(\n        model=LLAMA_STACK_MODEL,\n        input=user_input,\n        tools=[\n            {\"type\": \"mcp\", \"server_label\": MCP_SERVER_LABEL, \"server_url\": MCP_SSE_URL}\n        ],\n        instructions=instructions,\n    )\n\n    for item in response.output:\n        if item.type == \"message\":\n            for content in item.content:\n                if hasattr(content, \"text\"):\n                    return content.text\n    return \"No response\"\n\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from llama_stack_client import LlamaStackClient\n\n...\n\ndef get_client() -> LlamaStackClient:\n    \"\"\"Create Llama Stack client with SSL verification disabled and extended timeout.\"\"\"\n    return LlamaStackClient(\n        base_url=LLAMA_STACK_URL,\n        http_client=httpx.Client(verify=False, timeout=300.0),\n    )\n...\n\ndef run_agent(client: LlamaStackClient, user_input: str) -> str:\n    \"\"\"Run agent using Responses API - server handles tool execution loop.\"\"\"\n    instructions = (\n        \"You are a helpful todo assistant. Use the available tools to manage tasks.\"\n    )\n    response = client.responses.create(\n        model=LLAMA_STACK_MODEL,\n        input=user_input,\n        tools=[\n            {\"type\": \"mcp\", \"server_label\": MCP_SERVER_LABEL, \"server_url\": MCP_SSE_URL}\n        ],\n        instructions=instructions,\n    )\n\n    for item in response.output:\n        if item.type == \"message\":\n            for content in item.content:\n                if hasattr(content, \"text\"):\n                    return content.text\n    return \"No response\"\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "type": "text",
      "version": 3154,
      "versionNonce": 1004025308,
      "index": "c0eN",
      "isDeleted": true,
      "id": "7i-AX42TEaXFJq4VWJkxn",
      "fillStyle": "solid",
