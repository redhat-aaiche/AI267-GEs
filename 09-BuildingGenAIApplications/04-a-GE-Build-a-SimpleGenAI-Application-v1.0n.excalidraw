    {
      "id": "pN-kHtZu8MzyHCWHw71DQ",
      "type": "text",
      "x": -103.13333257039403,
      "y": 88960,
      "width": 1663.199951171875,
      "height": 3285,
      "angle": 0,
      "strokeColor": "#1e1e1e",
