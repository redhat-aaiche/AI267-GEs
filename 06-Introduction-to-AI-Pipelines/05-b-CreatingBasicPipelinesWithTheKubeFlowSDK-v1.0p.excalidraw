      "opacity": 100,
      "groupIds": [
        "iS6i4ihMzZyGqT707qpH7",
        "SRP8VEDQpDf8suUl8q_Jf",
        "vhN7dnWWnUPPiHzI7uXpF",
        "MEhvdEuLWK4G-vUCgFjWK"
      ],
      "frameId": null,
      "index": "c0n2",
      "roundness": null,
      "seed": 1870765974,
      "version": 361,
      "versionNonce": 921692950,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793614230311,
      "link": null,
      "locked": false,
      "text": "[student@workstation ~]$ cat pipeline-manifest.yaml\n\napiVersion: pipelines.kubeflow.org/v2beta1\n\nkind: Pipeline\n\nmetadata:\n  name: my-second-pipeline\n  namespace: dspa-kubeflow\n\nspec:\n  displayName: My Second Pipeline\n\n\n---\napiVersion: pipelines.kubeflow.org/v2beta1\n\nkind: PipelineVersion\n\nmetadata:\n  name: my-second-pipeline-v1\n  namespace: dspa-kubeflow\n\nspec:\n  displayName: My Second Pipeline v1\n  pipelineName: my-second-pipeline\n\n  pipelineSpec:\n\n    # Pipeline specification details\n\n    components:\n      comp-say-hello:\n\n...\n\n    deploymentSpec:\n      executors:\n        exec-say-hello:\n          container:\n            args:\n...\n            command:\n...\n            image: python:3.11\n\n    pipelineInfo:\n      name: hello-pipeline\n\n    root:\n      dag:\n        outputs:\n          parameters:\n            Output:\n              valueFromParameter:\n                outputParameterKey: Output\n                producerSubtask: say-hello\n        tasks:\n          say-hello:\n            cachingOptions:\n              enableCache: true\n            componentRef:\n              name: comp-say-hello\n            inputs:\n              parameters:\n                name:\n                  componentInputParameter: recipient\n            taskInfo:\n              name: say-hello\n   \n   inputDefinitions:\n        parameters:\n          recipient:\n            parameterType: STRING\n      outputDefinitions:\n        parameters:\n          Output:\n            parameterType: STRING\n\n\n    schemaVersion: 2.1.0\n    sdkVersion: kfp-2.15.2",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation ~]$ cat pipeline-manifest.yaml\n\napiVersion: pipelines.kubeflow.org/v2beta1\n\nkind: Pipeline\n\nmetadata:\n  name: my-second-pipeline\n  namespace: dspa-kubeflow\n\nspec:\n  displayName: My Second Pipeline\n\n\n---\napiVersion: pipelines.kubeflow.org/v2beta1\n\nkind: PipelineVersion\n\nmetadata:\n  name: my-second-pipeline-v1\n  namespace: dspa-kubeflow\n\nspec:\n  displayName: My Second Pipeline v1\n  pipelineName: my-second-pipeline\n\n  pipelineSpec:\n\n    # Pipeline specification details\n\n    components:\n      comp-say-hello:\n\n...\n\n    deploymentSpec:\n      executors:\n        exec-say-hello:\n          container:\n            args:\n...\n            command:\n...\n            image: python:3.11\n\n    pipelineInfo:\n      name: hello-pipeline\n\n    root:\n      dag:\n        outputs:\n          parameters:\n            Output:\n              valueFromParameter:\n                outputParameterKey: Output\n                producerSubtask: say-hello\n        tasks:\n          say-hello:\n            cachingOptions:\n              enableCache: true\n            componentRef:\n              name: comp-say-hello\n            inputs:\n              parameters:\n                name:\n                  componentInputParameter: recipient\n            taskInfo:\n              name: say-hello\n   \n   inputDefinitions:\n        parameters:\n          recipient:\n            parameterType: STRING\n      outputDefinitions:\n        parameters:\n          Output:\n            parameterType: STRING\n\n\n    schemaVersion: 2.1.0\n    sdkVersion: kfp-2.15.2",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793614216943,
      "labelPosition": null,
      "baseFontSize": null
