      "fontSize": 28,
      "fontFamily": 3,
      "text": "@dsl.pipeline(name=\"sentiment-analysis\")\ndef pipeline():\n   # Load and preprocess data\n   data_processing_task = process_data()\n   \n         = data_processing_task.outputs[\"texts\"]\n\n          = data_processing_task .outputs[\"labels\"]\n\n\n   # Train the model\n              = train_model(texts=     , labels=      )\n\n    accuracy =          .output",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "@dsl.pipeline(name=\"sentiment-analysis\")\ndef pipeline():\n   # Load and preprocess data\n   data_processing_task = process_data()\n   \n         = data_processing_task.outputs[\"texts\"]\n\n          = data_processing_task .outputs[\"labels\"]\n\n\n   # Train the model\n              = train_model(texts=     , labels=      )\n\n    accuracy =          .output",
