    {
      "id": "qLyu8r5Bzt-Z3ZnbibP92",
      "type": "text",
      "x": 1479.0063105080808,
      "y": 46268.03118944536,
      "width": 1485,
      "height": 1710,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "atyhDitwmMjp8cjZh75L3",
        "XM_wV9M_W9JeYOr6m9lUK",
        "SScTaQYi4-R0e8CHG1KfX",
        "-jJ1Hu6aXwwaTuRzc5JlB",
        "Q-ZbdSV5a7zZoEHcWqavw",
        "7ihNCvq5pArVUJViuX5RC"
      ],
      "frameId": null,
      "index": "c0LT",
      "roundness": null,
      "seed": 1374269825,
      "version": 672,
      "versionNonce": 1445850433,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791879657697,
      "link": null,
      "locked": false,
      "text": "[student@workstation genai-rag]$ cat register_vector_db.py\n\"\"\"Register a vector store with Llama Stack.\n\nThis script connects to Llama Stack, discovers the embedding model,\nand creates a vector store for RAG document storage.\n\"\"\"\n\nimport logging\n\nimport httpx\nfrom llama_stack_client import LlamaStackClient\n\nlogging.getLogger(\"httpx\").setLevel(logging.WARNING)\n\nLS_URL = \"https://llama-stack-genai-rag.apps.ocp4.example.com\"\n\n# Create custom httpx client that ignores SSL verification\n# WARNING: insecure. use for testing only\nhttp_client = httpx.Client(verify=False, timeout=300.0)\n\nclient = LlamaStackClient(base_url=LS_URL, http_client=http_client)\n\n# Get embedding model details\nmodels = client.models.list()\nembedding = next(\n    m for m in models if m.custom_metadata.get(\"model_type\") == \"embedding\"\n)\nembedding_model_id = embedding.id\nprint(f\"Embedding model: {embedding_model_id}\")\n\n# Create a vector store\n# TODO: add implementation\nvs = client.vector_stores.create(\n    name=\"rag-docs\",\n    metadata={\"embedding_model\": embedding_model_id},\n)\n\nprint(f\"Created vector store: {vs.id}\")",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation genai-rag]$ cat register_vector_db.py\n\"\"\"Register a vector store with Llama Stack.\n\nThis script connects to Llama Stack, discovers the embedding model,\nand creates a vector store for RAG document storage.\n\"\"\"\n\nimport logging\n\nimport httpx\nfrom llama_stack_client import LlamaStackClient\n\nlogging.getLogger(\"httpx\").setLevel(logging.WARNING)\n\nLS_URL = \"https://llama-stack-genai-rag.apps.ocp4.example.com\"\n\n# Create custom httpx client that ignores SSL verification\n# WARNING: insecure. use for testing only\nhttp_client = httpx.Client(verify=False, timeout=300.0)\n\nclient = LlamaStackClient(base_url=LS_URL, http_client=http_client)\n\n# Get embedding model details\nmodels = client.models.list()\nembedding = next(\n    m for m in models if m.custom_metadata.get(\"model_type\") == \"embedding\"\n)\nembedding_model_id = embedding.id\nprint(f\"Embedding model: {embedding_model_id}\")\n\n# Create a vector store\n# TODO: add implementation\nvs = client.vector_stores.create(\n    name=\"rag-docs\",\n    metadata={\"embedding_model\": embedding_model_id},\n)\n\nprint(f\"Created vector store: {vs.id}\")",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1791879651595,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "E0toEBhOaC_e9idLTK6Kk",
      "type": "rectangle",
