      "updated": 1793612410145,
      "link": null,
      "locked": false,
      "text": "° How to tell to Elyra which Runtime Image to use \n  during the execution of a \" node \" ?",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° How to tell to Elyra which Runtime Image to use \n  during the execution of a \" node \" ?",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793612405616,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 5765,
      "versionNonce": 508672522,
      "index": "c1Ae",
      "isDeleted": false,
      "id": "sGBLrXp_voqNpHqLlWPlO",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 104.18308296573696,
      "y": 106734.65926377673,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "width": 1713.63330078125,
      "height": 495,
      "seed": 1105185994,
      "groupIds": [
        "yzL4l37R1ptJ8hYlnE_nT",
        "Mi3taoGUDNm_Ab0YuY7_p",
        "as1N0SEPLacRTSdq9HeUv"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1793612410145,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Select the Image to be used during the execution of the Notebook :\n\n        ° 2 ways to it :\n\n            a) - Set the image Globally ( said differently : will be the default )\n\n                ==> Use Pipeline Properties\n\n            b) - Set the image directly in the Node ( said differently : overwrites the default )\n\n                ==> Use Node Properties",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Select the Image to be used during the execution of the Notebook :\n\n        ° 2 ways to it :\n\n            a) - Set the image Globally ( said differently : will be the default )\n\n                ==> Use Pipeline Properties\n\n            b) - Set the image directly in the Node ( said differently : overwrites the default )\n\n                ==> Use Node Properties",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793612405616,
      "labelPosition": null,
      "baseFontSize": null
    },
