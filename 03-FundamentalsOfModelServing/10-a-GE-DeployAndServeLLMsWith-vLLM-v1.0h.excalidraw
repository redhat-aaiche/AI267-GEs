      "link": null,
      "locked": false,
      "text": "#!/bin/bash\n# Test vLLM with large identical prompts from alice-short.txt\n# Usage: ./curl-llm-large.sh NUM_REQUESTS TOKEN [TIMEOUT] [LLM_URL]\n\nNUM_REQUESTS=${1:-50}\nTOKEN=${2}\nTIMEOUT=${3:-30}\nLLM_URL=${4:-\"http://my-llm-predictor.serving-vllm.svc.cluster.local:8080\"}\nRESULTS_DIR=\"/tmp/vllm-large-$$\"\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nALICE_FILE=\"$SCRIPT_DIR/alice-short.txt\"\n\nif [ -z \"$TOKEN\" ]; then\n  echo \"ERROR: TOKEN required\"\n  echo \"Usage: $0 NUM_REQUESTS TOKEN [TIMEOUT] [LLM_URL]\"\n  exit 1\nfi\n\nif [ ! -f \"$ALICE_FILE\" ]; then\n  echo \"ERROR: alice-short.txt not found at $ALICE_FILE\"\n  exit 1\nfi\n\nrm -rf \"$RESULTS_DIR\"\nmkdir -p \"$RESULTS_DIR\"\necho \"Preparing large prompt from alice-short.txt...\"\n\n# Create payload file\npython3 -c \"\nimport json\nwith open('$ALICE_FILE', 'r') as f:\n    content = f.read()\npayload = {\n  'model': 'my-llm',\n  'messages': [\n    {'role': 'system', 'content': 'You are a helpful assistant.'},\n    {'role': 'user', 'content': content}\n  ]\n}\nwith open('$RESULTS_DIR/payload.json', 'w') as f:\n  json.dump(payload, f)\n\"\n\necho \"Sending $NUM_REQUESTS requests to $LLM_URL...\"\nSTART=$(date +%s)\n\nfor i in $(seq 1 $NUM_REQUESTS); do\n  curl -sk -X POST \"$LLM_URL/v1/chat/completions\" \\\n    -H \"Authorization: Bearer $TOKEN\" \\\n    -H \"Content-Type: application/json\" \\\n    --max-time $TIMEOUT \\\n    --data-binary \"@$RESULTS_DIR/payload.json\" \\\n    -o \"$RESULTS_DIR/result-$i.json\" 2>&1 &\ndone\n\nwait\nEND=$(date +%s)\nDURATION=$((END - START))\n\n# Count successes\nSUCCESSFUL=0\nfor i in $(seq 1 $NUM_REQUESTS); do\n  if grep -q '\"choices\"' \"$RESULTS_DIR/result-$i.json\" 2>/dev/null; then\n    ((SUCCESSFUL++))\n  fi\ndone\n\nFAILED=$((NUM_REQUESTS - SUCCESSFUL))\n\necho \"Duration: ${DURATION}s\"\necho \"Success: $SUCCESSFUL/$NUM_REQUESTS\"\necho \"Failed: $FAILED/$NUM_REQUESTS\"",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#!/bin/bash\n# Test vLLM with large identical prompts from alice-short.txt\n# Usage: ./curl-llm-large.sh NUM_REQUESTS TOKEN [TIMEOUT] [LLM_URL]\n\nNUM_REQUESTS=${1:-50}\nTOKEN=${2}\nTIMEOUT=${3:-30}\nLLM_URL=${4:-\"http://my-llm-predictor.serving-vllm.svc.cluster.local:8080\"}\nRESULTS_DIR=\"/tmp/vllm-large-$$\"\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nALICE_FILE=\"$SCRIPT_DIR/alice-short.txt\"\n\nif [ -z \"$TOKEN\" ]; then\n  echo \"ERROR: TOKEN required\"\n  echo \"Usage: $0 NUM_REQUESTS TOKEN [TIMEOUT] [LLM_URL]\"\n  exit 1\nfi\n\nif [ ! -f \"$ALICE_FILE\" ]; then\n  echo \"ERROR: alice-short.txt not found at $ALICE_FILE\"\n  exit 1\nfi\n\nrm -rf \"$RESULTS_DIR\"\nmkdir -p \"$RESULTS_DIR\"\necho \"Preparing large prompt from alice-short.txt...\"\n\n# Create payload file\npython3 -c \"\nimport json\nwith open('$ALICE_FILE', 'r') as f:\n    content = f.read()\npayload = {\n  'model': 'my-llm',\n  'messages': [\n    {'role': 'system', 'content': 'You are a helpful assistant.'},\n    {'role': 'user', 'content': content}\n  ]\n}\nwith open('$RESULTS_DIR/payload.json', 'w') as f:\n  json.dump(payload, f)\n\"\n\necho \"Sending $NUM_REQUESTS requests to $LLM_URL...\"\nSTART=$(date +%s)\n\nfor i in $(seq 1 $NUM_REQUESTS); do\n  curl -sk -X POST \"$LLM_URL/v1/chat/completions\" \\\n    -H \"Authorization: Bearer $TOKEN\" \\\n    -H \"Content-Type: application/json\" \\\n    --max-time $TIMEOUT \\\n    --data-binary \"@$RESULTS_DIR/payload.json\" \\\n    -o \"$RESULTS_DIR/result-$i.json\" 2>&1 &\ndone\n\nwait\nEND=$(date +%s)\nDURATION=$((END - START))\n\n# Count successes\nSUCCESSFUL=0\nfor i in $(seq 1 $NUM_REQUESTS); do\n  if grep -q '\"choices\"' \"$RESULTS_DIR/result-$i.json\" 2>/dev/null; then\n    ((SUCCESSFUL++))\n  fi\ndone\n\nFAILED=$((NUM_REQUESTS - SUCCESSFUL))\n\necho \"Duration: ${DURATION}s\"\necho \"Success: $SUCCESSFUL/$NUM_REQUESTS\"\necho \"Failed: $FAILED/$NUM_REQUESTS\"",
