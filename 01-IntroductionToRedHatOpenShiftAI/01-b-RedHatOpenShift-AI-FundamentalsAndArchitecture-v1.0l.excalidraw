      "boundElements": [],
      "updated": 1793698589716,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> What Red Hat OpenShift AI does for Data Scientists and Platform engineers\n\n    --> OpenShift AI is the foundation for their AI services\n\n--> It is a way for us to provide things like :\n\n        ° model training, \n        ° model hosting, \n        ° monitoring, \n\n    and \n\n        ° security \n\n    in an end to end solution with different types of\n    open source technologies",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> What Red Hat OpenShift AI does for Data Scientists and Platform engineers\n\n    --> OpenShift AI is the foundation for their AI services\n\n--> It is a way for us to provide things like :\n\n        ° model training, \n        ° model hosting, \n        ° monitoring, \n\n    and \n\n        ° security \n\n    in an end to end solution with different types of\n    open source technologies",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793698586852,
      "labelPosition": null,
      "baseFontSize": null
    },
