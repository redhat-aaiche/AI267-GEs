      "link": null,
      "locked": false,
      "text": "initContainers:\n  - args:\n    - sh\n    - -c\n    - 'echo ''Pre-fetching modelcar registry.lab.example.com:8443/redhattraining/models/diabetes:v1:\n      '' && [ -d /models ] && [ \"$$(ls -A /models)\" ] && echo ''OK ... Prefetched\n      and valid (/models exists)'' || (echo ''NOK ... Prefetched but modelcar is invalid\n      (/models does not exist or is empty)'' && exit 1)'\n\n    image: registry.lab.example.com:8443/redhattraining/models/diabetes:v1\n\n    imagePullPolicy: IfNotPresent\n    name: modelcar-init",
      "fontSize": 36,
      "baseFontSize": null,
