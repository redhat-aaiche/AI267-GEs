      "fontSize": 37.29732845673817,
      "fontFamily": 1,
      "text": "Workbench Resource Limits :",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Workbench Resource Limits :",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "2H84Q3T1AEnLD8-MA_9Jc",
      "type": "text",
      "x": -728.3006705854441,
      "y": 60820,
      "width": 1171.9166259765625,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "5oKoVjK5TaCjQ6B1vVSvU",
        "GvhdOdvZ19pXpGoo-Nk_Y",
        "9vZ4vqwlOkxBAAiFDBcZi"
      ],
      "frameId": null,
      "index": "c1PA6",
      "roundness": null,
      "seed": 10421681,
      "version": 1641,
      "versionNonce": 950023957,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793433856345,
      "link": null,
      "locked": false,
      "text": "--> When managing your Workbenches, make sure to consider the\n   type of capacity needed to perform the types of experiments\n   that will happen within the Workbench\n\n\n--> A common issue is not enough resources like CPU or memory \n    are provisioned to the workbench to be able to run the types\n    of model training and validation that will need to happen \n    within the container that's hosting the Workbench\n\n\n--> Example :\n\n        ° The ?? image ?? you see here shows\n          Insufficient CPU",
      "fontSize": 36,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> When managing your Workbenches, make sure to consider the\n   type of capacity needed to perform the types of experiments\n   that will happen within the Workbench\n\n\n--> A common issue is not enough resources like CPU or memory \n    are provisioned to the workbench to be able to run the types\n    of model training and validation that will need to happen \n    within the container that's hosting the Workbench\n\n\n--> Example :\n\n        ° The ?? image ?? you see here shows\n          Insufficient CPU",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
