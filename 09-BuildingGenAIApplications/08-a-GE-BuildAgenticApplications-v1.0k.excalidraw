    {
      "id": "RGW77WO8NYb0Pwf-Fj5Ey",
      "type": "text",
      "x": 342.61466606411454,
      "y": 74155.28143626827,
      "width": 1287,
      "height": 1800,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "u1TYJ456tdn74NxNhaoIy",
        "B5Zhj-0-yEkl38yooVYKJ",
        "I7knXlF5hhFDnLob5qb3Z",
        "z0w-ylB13f7gbv5Tdj295"
      ],
      "frameId": null,
      "index": "c0TQ",
      "roundness": null,
      "seed": 1440427231,
      "version": 368,
      "versionNonce": 747839327,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791809431697,
      "link": null,
      "locked": false,
      "text": "student@workstation genai-agentic]$ cat test_tool_calling.sh\n#!/bin/bash\n# Test model tool-calling capabilities\n#\n# This script sends a request with a tool definition to observe\n# how the model generates structured function calls.\n#\n# The vLLM serving runtime parses the model output and formats it\n# according to the OpenAI tool-calling specification.\n\necho \"Testing tool-calling capabilities...\"\necho \"Endpoint: $VLLM_URL\"\necho \"Model: $MODEL_NAME\"\necho \"\"\n\ncurl -sk \"$VLLM_URL/v1/chat/completions\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"model\": \"'\"$MODEL_NAME\"'\",\n    \"messages\": [\n      {\"role\": \"user\", \"content\": \"Add a task to buy groceries\"}\n    ],\n    \"tools\": [{\n      \"type\": \"function\",\n      \"function\": {\n        \"name\": \"add_task\",\n        \"description\": \"Create a new task with a title\",\n        \"parameters\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"title\": {\n              \"type\": \"string\",\n              \"description\": \"The task title\"\n            }\n          },\n          \"required\": [\"title\"]\n        }\n      }\n    }]\n  }' | jq '.choices[0].message'",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "student@workstation genai-agentic]$ cat test_tool_calling.sh\n#!/bin/bash\n# Test model tool-calling capabilities\n#\n# This script sends a request with a tool definition to observe\n# how the model generates structured function calls.\n#\n# The vLLM serving runtime parses the model output and formats it\n# according to the OpenAI tool-calling specification.\n\necho \"Testing tool-calling capabilities...\"\necho \"Endpoint: $VLLM_URL\"\necho \"Model: $MODEL_NAME\"\necho \"\"\n\ncurl -sk \"$VLLM_URL/v1/chat/completions\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"model\": \"'\"$MODEL_NAME\"'\",\n    \"messages\": [\n      {\"role\": \"user\", \"content\": \"Add a task to buy groceries\"}\n    ],\n    \"tools\": [{\n      \"type\": \"function\",\n      \"function\": {\n        \"name\": \"add_task\",\n        \"description\": \"Create a new task with a title\",\n        \"parameters\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"title\": {\n              \"type\": \"string\",\n              \"description\": \"The task title\"\n            }\n          },\n          \"required\": [\"title\"]\n        }\n      }\n    }]\n  }' | jq '.choices[0].message'",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1791809424373,
      "labelPosition": null,
      "baseFontSize": null
    },
