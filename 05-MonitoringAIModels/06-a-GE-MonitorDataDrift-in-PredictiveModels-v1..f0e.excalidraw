      "isDeleted": false,
      "boundElements": [],
      "updated": 1785574576875,
      "link": null,
      "locked": false,
      "text": "**Parameters explained:**\n- `referenceTag`: \"TRAINING\" - compare against uploaded training data\n- `batchSize`: 100 - analyze every 100 new inference requests\n- `thresholdDelta`: 10.0 - alert if mean shifts by more than 10 units\n- `fitColumns`: which features to monitor for drift",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "**Parameters explained:**\n- `referenceTag`: \"TRAINING\" - compare against uploaded training data\n- `batchSize`: 100 - analyze every 100 new inference requests\n- `thresholdDelta`: 10.0 - alert if mean shifts by more than 10 units\n- `fitColumns`: which features to monitor for drift",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
