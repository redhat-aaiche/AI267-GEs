      "seed": 1469927773,
      "version": 317,
      "versionNonce": 71129341,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793530419213,
      "link": null,
      "locked": false,
      "text": "import torch\n\n# Define your device - GPU if available, else CPU\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n\n# Moving a tensor to the selected device\ntensor = torch.randn(10)  # a random tensor of shape (10,)\n\ntensor = tensor.to(device)  # move tensor to GPU (if available)\n\n# Moving a model to the selected device\nmodel = ...\n\nmodel = model.to(device)  # transfer model to GPU",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "import torch\n\n# Define your device - GPU if available, else CPU\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n\n# Moving a tensor to the selected device\ntensor = torch.randn(10)  # a random tensor of shape (10,)\n\ntensor = tensor.to(device)  # move tensor to GPU (if available)\n\n# Moving a model to the selected device\nmodel = ...\n\nmodel = model.to(device)  # transfer model to GPU",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1793530413532,
      "baseFontSize": null
    },
