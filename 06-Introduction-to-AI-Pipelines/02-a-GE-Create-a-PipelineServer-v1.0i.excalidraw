      "updated": 1793004050401,
      "created": 1793004042827,
      "link": null,
      "locked": false,
      "text": "° Create a DSPA ( Pipeline Server )\n\n° Remember that a S3 Connection is REQUIRED\n\n° Check that a Bucket will be automatically created in the Minio Object Server\n\n° Optionally, using the OpenShift dashboard, have a look to the resources created when you create a DSPA",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Create a DSPA ( Pipeline Server )\n\n° Remember that a S3 Connection is REQUIRED\n\n° Check that a Bucket will be automatically created in the Minio Object Server\n\n° Optionally, using the OpenShift dashboard, have a look to the resources created when you create a DSPA",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
