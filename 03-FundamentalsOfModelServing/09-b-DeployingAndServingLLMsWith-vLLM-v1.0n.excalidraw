    {
      "id": "nVq5rvxn23oQ5-uiXC5C-",
      "type": "text",
      "x": -117.5,
      "y": 3358.6620128522713,
      "width": 859.5833129882812,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "-L2GUHKAjgWdbSATuCI31",
        "Yfr7b-g5F-9hcEw97rl2J",
        "S0c_45VvYbxwRSevWmc20",
        "PZD4-8Xbb-2NGCwjDSNPf",
        "kj1GSImcaByx9TbKTQg81",
        "1HGtfJluD6_EcjllbuoPO",
        "9BfC1IcaimDGpUDG9SU3j"
      ],
      "frameId": null,
      "index": "bvG",
      "roundness": null,
      "seed": 783766771,
      "version": 1458,
      "versionNonce": 620094684,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793702328057,
      "link": null,
      "locked": false,
      "text": "° We load the batch ( 4 requests ) on  the \n  Accelerator and wait for it to finish\n\n° The 3rd request was short, \n° the 2nd one was much longer\n\n° The problem is that we have to WAIT the last\n   request to be processed to run another batch\n \n    ==> hardware resources waste",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° We load the batch ( 4 requests ) on  the \n  Accelerator and wait for it to finish\n\n° The 3rd request was short, \n° the 2nd one was much longer\n\n° The problem is that we have to WAIT the last\n   request to be processed to run another batch\n \n    ==> hardware resources waste",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1793532284139,
      "baseFontSize": null
    },
