      "boundElements": [],
      "updated": 1793442638882,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> If you run out of resources, especially memory, it will    \n   cause the workbench to fail and your experimentation to fail\n\n\n--> It is critical to have a good understanding of the type\n   of data that you're bringing in and also the type of model\n   that you're working with and the types of resources that\n   are necessary to train your model",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> If you run out of resources, especially memory, it will    \n   cause the workbench to fail and your experimentation to fail\n\n\n--> It is critical to have a good understanding of the type\n   of data that you're bringing in and also the type of model\n   that you're working with and the types of resources that\n   are necessary to train your model",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": 1793442636530,
      "labelPosition": null,
      "baseFontSize": null
    },
