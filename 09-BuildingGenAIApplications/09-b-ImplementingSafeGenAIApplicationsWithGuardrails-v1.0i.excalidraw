      "updated": 1789295513592,
      "link": null,
      "locked": false,
      "text": "--> We need to configure the Orchestrator to know about all\n    the different services that it needs to talk to :\n\n        ° the Inference LLM Endpoint\n\n        ° the Detector Servers Endpoints",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> We need to configure the Orchestrator to know about all\n    the different services that it needs to talk to :\n\n        ° the Inference LLM Endpoint\n\n        ° the Detector Servers Endpoints",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1789295502483,
      "baseFontSize": null
    },
    {
      "id": "BJeKNesPI5Rx752zMK6tN",
      "type": "text",
      "x": -143.69792864132614,
      "y": 171020,
      "width": 1900.800048828125,
      "height": 1125,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QmS0zmBb4qgYQuMGLtNAv",
        "EbREi7KAbVBJsX3sGakiJ",
        "NFmtUbRcEYO0YXKX4M2nk",
