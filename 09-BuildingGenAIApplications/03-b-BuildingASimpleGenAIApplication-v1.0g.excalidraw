      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1793724522874,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> When we need to predict categories this is known as Classification\n\n--> Could be :\n\n    ° Binary \n\n    ° Multiple Classification \n\n--> The convention in Binary Classification is to have 2 classes :\n    \n    ° 2 possibles Classes labelled :\n        - class 0\n        - class 1\n\n--> Some examples, the following are Binary Classification :\n\n    ° Spam versus not spam emails\n\n    ° Disease diagnosis",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> When we need to predict categories this is known as Classification\n\n--> Could be :\n\n    ° Binary \n\n    ° Multiple Classification \n\n--> The convention in Binary Classification is to have 2 classes :\n    \n    ° 2 possibles Classes labelled :\n        - class 0\n        - class 1\n\n--> Some examples, the following are Binary Classification :\n\n    ° Spam versus not spam emails\n\n    ° Disease diagnosis",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1791965802696,
      "labelPosition": null,
      "baseFontSize": null
    },
