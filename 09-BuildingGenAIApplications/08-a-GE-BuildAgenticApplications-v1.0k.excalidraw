    {
      "id": "J8F3PW-RBgWML04Qy5f32",
      "type": "text",
      "x": 414.3469701636329,
      "y": 87220.64208361534,
      "width": 1762.199951171875,
      "height": 5895,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "nPV8vx2z4NRVQedlS5714",
        "6DIes8fHGpFm8esVfViYH",
        "YbxszjgTRrocrNNukusIz",
        "5i9a3_bcEfNC6zkOr1DJV"
      ],
      "frameId": null,
      "index": "c0To",
      "roundness": null,
      "seed": 1538406929,
      "version": 478,
      "versionNonce": 1400343921,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791809454865,
      "link": null,
      "locked": false,
      "text": "[student@workstation mcp-todo-app]$ cat deployment.yaml \n---\n# MCP Server Deployment for Agentic Applications\n#\n# This manifest deploys a todo management application with:\n# - todo-api: REST API for direct task management (debugging)\n# - todo-mcp: MCP server exposing tools via Streamable HTTP transport\n#\n# Both containers share a persistent volume to store task data.\n\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: todo-storage\nspec:\n  accessModes:\n    - ReadWriteOnce\n  resources:\n    requests:\n      storage: 100Mi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: todo-app\n  labels:\n    app: todo-app\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app: todo-app\n  template:\n    metadata:\n      labels:\n        app: todo-app\n    spec:\n      containers:\n        - name: todo-api\n          image: registry.lab.example.com:8443/redhattraining/ai0022l-mcp-todo-app:latest\n          ports:\n            - containerPort: 8080\n              name: api\n          env:\n            - name: TODO_STORAGE_FILE\n              value: /data/tasks.json\n          volumeMounts:\n            - name: todo-data\n              mountPath: /data\n          livenessProbe:\n            httpGet:\n              path: /health\n              port: 8080\n            initialDelaySeconds: 5\n            periodSeconds: 10\n          readinessProbe:\n            httpGet:\n              path: /health\n              port: 8080\n            initialDelaySeconds: 5\n            periodSeconds: 5\n        # MCP Server container\n        # Exposes tools via Streamable HTTP transport on port 8081\n        - name: todo-mcp\n          image: registry.lab.example.com:8443/redhattraining/ai0022l-mcp-todo-app:latest\n          command: [\"python\", \"-m\", \"todo_app.mcp_server\"]\n          ports:\n            - containerPort: 8081\n              name: mcp\n          env:\n            - name: TODO_STORAGE_FILE\n              value: /data/tasks.json\n            # Transport configuration for network mode\n            - name: MCP_TRANSPORT\n              value: sse\n            - name: MCP_PORT\n              value: \"8081\"\n          volumeMounts:\n            - name: todo-data\n              mountPath: /data\n          readinessProbe:\n            tcpSocket:\n              port: 8081\n            initialDelaySeconds: 5\n            periodSeconds: 5\n      volumes:\n        - name: todo-data\n          persistentVolumeClaim:\n            claimName: todo-storage\n---\n# Service for REST API (debugging)\napiVersion: v1\nkind: Service\nmetadata:\n  name: todo-app\nspec:\n  selector:\n    app: todo-app\n  ports:\n    - port: 8080\n      targetPort: 8080\n      name: api\n---\n# Service for MCP server\n# Llama Stack connects to this endpoint to execute tools\napiVersion: v1\nkind: Service\nmetadata:\n  name: todo-mcp\nspec:\n  selector:\n    app: todo-app\n  ports:\n    - port: 8081\n      targetPort: 8081\n      name: mcp\n---\n# Route for MCP server (external access)\napiVersion: route.openshift.io/v1\nkind: Route\nmetadata:\n  name: todo-mcp\nspec:\n  to:\n    kind: Service\n    name: todo-mcp\n  port:\n    targetPort: 8081\n  tls:\n    termination: edge\n    insecureEdgeTerminationPolicy: Redirect",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation mcp-todo-app]$ cat deployment.yaml \n---\n# MCP Server Deployment for Agentic Applications\n#\n# This manifest deploys a todo management application with:\n# - todo-api: REST API for direct task management (debugging)\n# - todo-mcp: MCP server exposing tools via Streamable HTTP transport\n#\n# Both containers share a persistent volume to store task data.\n\napiVersion: v1\nkind: PersistentVolumeClaim\nmetadata:\n  name: todo-storage\nspec:\n  accessModes:\n    - ReadWriteOnce\n  resources:\n    requests:\n      storage: 100Mi\n---\napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: todo-app\n  labels:\n    app: todo-app\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app: todo-app\n  template:\n    metadata:\n      labels:\n        app: todo-app\n    spec:\n      containers:\n        - name: todo-api\n          image: registry.lab.example.com:8443/redhattraining/ai0022l-mcp-todo-app:latest\n          ports:\n            - containerPort: 8080\n              name: api\n          env:\n            - name: TODO_STORAGE_FILE\n              value: /data/tasks.json\n          volumeMounts:\n            - name: todo-data\n              mountPath: /data\n          livenessProbe:\n            httpGet:\n              path: /health\n              port: 8080\n            initialDelaySeconds: 5\n            periodSeconds: 10\n          readinessProbe:\n            httpGet:\n              path: /health\n              port: 8080\n            initialDelaySeconds: 5\n            periodSeconds: 5\n        # MCP Server container\n        # Exposes tools via Streamable HTTP transport on port 8081\n        - name: todo-mcp\n          image: registry.lab.example.com:8443/redhattraining/ai0022l-mcp-todo-app:latest\n          command: [\"python\", \"-m\", \"todo_app.mcp_server\"]\n          ports:\n            - containerPort: 8081\n              name: mcp\n          env:\n            - name: TODO_STORAGE_FILE\n              value: /data/tasks.json\n            # Transport configuration for network mode\n            - name: MCP_TRANSPORT\n              value: sse\n            - name: MCP_PORT\n              value: \"8081\"\n          volumeMounts:\n            - name: todo-data\n              mountPath: /data\n          readinessProbe:\n            tcpSocket:\n              port: 8081\n            initialDelaySeconds: 5\n            periodSeconds: 5\n      volumes:\n        - name: todo-data\n          persistentVolumeClaim:\n            claimName: todo-storage\n---\n# Service for REST API (debugging)\napiVersion: v1\nkind: Service\nmetadata:\n  name: todo-app\nspec:\n  selector:\n    app: todo-app\n  ports:\n    - port: 8080\n      targetPort: 8080\n      name: api\n---\n# Service for MCP server\n# Llama Stack connects to this endpoint to execute tools\napiVersion: v1\nkind: Service\nmetadata:\n  name: todo-mcp\nspec:\n  selector:\n    app: todo-app\n  ports:\n    - port: 8081\n      targetPort: 8081\n      name: mcp\n---\n# Route for MCP server (external access)\napiVersion: route.openshift.io/v1\nkind: Route\nmetadata:\n  name: todo-mcp\nspec:\n  to:\n    kind: Service\n    name: todo-mcp\n  port:\n    targetPort: 8081\n  tls:\n    termination: edge\n    insecureEdgeTerminationPolicy: Redirect",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1791809447739,
