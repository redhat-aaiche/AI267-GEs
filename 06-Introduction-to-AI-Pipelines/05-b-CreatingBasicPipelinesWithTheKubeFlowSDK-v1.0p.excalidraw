    {
      "type": "text",
      "version": 3051,
      "versionNonce": 403633508,
      "index": "c13S",
      "isDeleted": true,
      "id": "fhtLJZICVfDUVO-3h-5L5",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 119.54899136307591,
      "y": 118473.27251910217,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1529.9500000000003,
      "height": 950,
      "seed": 339062410,
      "groupIds": [
        "8KSlY1IJRO8oMDLSyv-eN",
        "0Cf8zMYUNIXmkspmZSU2j",
        "43lkGGf6uDIO-JTJcv-jO",
        "HmDDwPnEKEUAx-KiQ-g-8",
        "TxVr3pbnoNVMirNSiHw2Q",
        "ATPjUWaqzk10e4fM-S8MQ"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1793710645510,
      "link": null,
      "locked": false,
      "fontSize": 38,
      "fontFamily": 5,
      "text": "--> ELYRA kubeflow pipelines Editor also uses COMPONENTS :\n\n--> You can see in the palette has custom components \n\n\n--> When are you going to use component or notebook ?\n    \n    • The advantage of notebook: you have access to the source code. \n       Which is ideal when you are working in a development mode on a project \n    \n    • When moving to production, it is not ideal to use notebooks. \n      So you extract the code and move it into some self contained piece \n      of executable that you can make available to users and so they can\n      reuse over and over in a project\n\n     In a way it provides with an abstraction layer, that gives you a lot\n     more flexibility when you are trying to build more pipelines\n\n\n     A component implements a machine learning task",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> ELYRA kubeflow pipelines Editor also uses COMPONENTS :\n\n--> You can see in the palette has custom components \n\n\n--> When are you going to use component or notebook ?\n    \n    • The advantage of notebook: you have access to the source code. \n       Which is ideal when you are working in a development mode on a project \n    \n    • When moving to production, it is not ideal to use notebooks. \n      So you extract the code and move it into some self contained piece \n      of executable that you can make available to users and so they can\n      reuse over and over in a project\n\n     In a way it provides with an abstraction layer, that gives you a lot\n     more flexibility when you are trying to build more pipelines\n\n\n     A component implements a machine learning task",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793614276624,
      "labelPosition": null,
      "baseFontSize": null
    },
