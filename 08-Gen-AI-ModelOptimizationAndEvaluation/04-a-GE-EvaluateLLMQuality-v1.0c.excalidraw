      "versionNonce": 1456380950,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1775819729240,
      "link": null,
      "locked": false,
      "text": "- See on the Red Hat Partner Connect portal.",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
