      "version": 468,
      "versionNonce": 1724751386,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "cKBCMsKEwJz-FsC2rRqAy",
          "type": "arrow"
        },
        {
          "id": "4HpGhLl1kME_UEU9oTeFa",
