    {
      "id": "a4Pqkqroh0N1sUiGO3wzU",
      "type": "text",
      "x": 162.1996420089069,
      "y": 18073.75,
      "width": 1698.0167236328125,
      "height": 495,
      "angle": 0,
      "strokeColor": "#c2255c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "R4w_GL9h9mq08twVCFfZH",
        "_pGGwALwp6ZKHKV5lK-Kp",
        "8MdGBktFXnL_uKOEgYGqF",
        "UJClQpeSEqbpcnydV8sOS",
        "scTFpRqnH_nLgAuZNsEnK"
      ],
      "frameId": null,
      "index": "c04T",
      "roundness": null,
      "seed": 1077494773,
      "version": 240,
      "versionNonce": 363265749,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793441551461,
      "link": null,
      "locked": false,
      "text": "What Is OCI ?\n\n        ° The Open Container Initiative (OCI) standardizes how containerized applications\n          and artifacts are managed. Founded in 2015 by Docker and others under the Linux\n          Foundation, OCI ensures interoperability and vendor neutrality in container technologies.\n          It evolved from Docker’s proprietary format to avoid lock-in, becoming an open, \n          extensible ecosystem\n\n        ° While OCI began with container images, it now supports diverse artifacts like Helm\n          charts and generative AI models through its OCI artifacts specification. This makes\n          registries highly versatile for modern workload",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What Is OCI ?\n\n        ° The Open Container Initiative (OCI) standardizes how containerized applications\n          and artifacts are managed. Founded in 2015 by Docker and others under the Linux\n          Foundation, OCI ensures interoperability and vendor neutrality in container technologies.\n          It evolved from Docker’s proprietary format to avoid lock-in, becoming an open, \n          extensible ecosystem\n\n        ° While OCI began with container images, it now supports diverse artifacts like Helm\n          charts and generative AI models through its OCI artifacts specification. This makes\n          registries highly versatile for modern workload",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793441545381,
      "labelPosition": null,
      "baseFontSize": null
    },
