      "updated": 1793358701434,
      "created": 1793358694518,
      "link": null,
      "locked": false,
      "text": "  - name: modelcar\n    image: registry.lab.example.com:8443/redhattraining/models/diabetes:v1\n    imagePullPolicy: IfNotPresent\n    args:\n      - sh\n      - -c\n      - ln -sf /proc/$$$$/root/models /mnt/models && sleep infinity\n\n    volumeMounts:\n    - mountPath: /mnt\n      name: kserve-provision-location\n   ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  - name: modelcar\n    image: registry.lab.example.com:8443/redhattraining/models/diabetes:v1\n    imagePullPolicy: IfNotPresent\n    args:\n      - sh\n      - -c\n      - ln -sf /proc/$$$$/root/models /mnt/models && sleep infinity\n\n    volumeMounts:\n    - mountPath: /mnt\n      name: kserve-provision-location\n   ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
