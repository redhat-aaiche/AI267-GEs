      "locked": false,
      "fontSize": 36,
      "fontFamily": 5,
      "text": "--> Secret : \n\n        ° Use the secret predefined in the environment you will run\n          the pipeline ( configured in the remote Kubernetes secrets )\n\n        ° The secret will be available to the notebook so that if\n           somebody looks at the pipeline, he will not able to see\n           the sensitive data which will be only available when the\n           notebook is executed",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Secret : \n\n        ° Use the secret predefined in the environment you will run\n          the pipeline ( configured in the remote Kubernetes secrets )\n\n        ° The secret will be available to the notebook so that if\n           somebody looks at the pipeline, he will not able to see\n           the sensitive data which will be only available when the\n           notebook is executed",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793612319359,
      "labelPosition": null,
      "baseFontSize": null
    },
