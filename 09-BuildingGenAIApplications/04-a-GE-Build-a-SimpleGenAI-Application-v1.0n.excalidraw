      "boundElements": [],
      "updated": 1791898626643,
      "link": null,
      "locked": false,
      "text": "[student@workstation genai-app]$ cat test-llama-stack.py \nimport logging\n\nimport httpx\nimport rich\nfrom llama_stack_client import LlamaStackClient\n\nlogging.getLogger(\"httpx\").setLevel(logging.WARNING)\n\n# TODO: Set Llama Stack URL\n# LS_URL = \"changeme\"\n\nLS_URL = \"https://llamastack-api-genai-app.apps.lab.example.com\"\n\n\n# Create custom httpx client that ignores SSL verification\n# (insecure; for testing only)\nhttp_client = httpx.Client(verify=False, timeout=300.0)\n\n# TODO: Instantiate Llama Stack client\n# client = LlamaStackClient()\n\nclient = LlamaStackClient(\n    base_url=LS_URL,\n    http_client=http_client,  # Pass the custom client here\n)\n\n\ndef responses_api_streaming(client, model_id):\n    print(\"\\n---RESPONSES API (STREAMING)---\\n\")\n\n    try:\n        # TODO: Use the new OpenAI Responses API to return a streaming response\n        # stream = None\n\n        stream = client.responses.create(\n            model=model_id,\n            input=\"Tell me some facts about Mongolia in 2-3 sentences.\",\n            stream=True,\n            temperature=0.3,\n        )        \n\n        # TODO: Loop through stream and print the chunked responses\n        # print(stream)\n\n        for event in stream:\n            if event.type == \"response.output_text.delta\":\n                rich.print(event.delta, end=\"\", flush=True)\n            elif event.type == \"response.error\":\n                print(f\"\\nError occurred: {event.error}\")        \n\n\n    except Exception as e:\n        print(f\"[ERROR] Error with responses API: {e}\")\n\n\ndef main():\n    try:\n        models = client.models.list()\n    except Exception as e:\n        print(f\"An error occurred listing models: {e}\")\n        return\n\n    inference_model_id = next(\n        (m.id for m in models\n         if m.custom_metadata.get(\"model_type\") == \"llm\"),\n        None,\n    )\n\n    if not inference_model_id:\n        print(\"No LLM model found. Exiting.\")\n        return\n\n    rich.print(f\"\\nUsing model: {inference_model_id}\\n\")\n\n    responses_api_streaming(client, inference_model_id)\n    print(\"\\n\")\n\n\nif __name__ == \"__main__\":\n    main()",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation genai-app]$ cat test-llama-stack.py \nimport logging\n\nimport httpx\nimport rich\nfrom llama_stack_client import LlamaStackClient\n\nlogging.getLogger(\"httpx\").setLevel(logging.WARNING)\n\n# TODO: Set Llama Stack URL\n# LS_URL = \"changeme\"\n\nLS_URL = \"https://llamastack-api-genai-app.apps.lab.example.com\"\n\n\n# Create custom httpx client that ignores SSL verification\n# (insecure; for testing only)\nhttp_client = httpx.Client(verify=False, timeout=300.0)\n\n# TODO: Instantiate Llama Stack client\n# client = LlamaStackClient()\n\nclient = LlamaStackClient(\n    base_url=LS_URL,\n    http_client=http_client,  # Pass the custom client here\n)\n\n\ndef responses_api_streaming(client, model_id):\n    print(\"\\n---RESPONSES API (STREAMING)---\\n\")\n\n    try:\n        # TODO: Use the new OpenAI Responses API to return a streaming response\n        # stream = None\n\n        stream = client.responses.create(\n            model=model_id,\n            input=\"Tell me some facts about Mongolia in 2-3 sentences.\",\n            stream=True,\n            temperature=0.3,\n        )        \n\n        # TODO: Loop through stream and print the chunked responses\n        # print(stream)\n\n        for event in stream:\n            if event.type == \"response.output_text.delta\":\n                rich.print(event.delta, end=\"\", flush=True)\n            elif event.type == \"response.error\":\n                print(f\"\\nError occurred: {event.error}\")        \n\n\n    except Exception as e:\n        print(f\"[ERROR] Error with responses API: {e}\")\n\n\ndef main():\n    try:\n        models = client.models.list()\n    except Exception as e:\n        print(f\"An error occurred listing models: {e}\")\n        return\n\n    inference_model_id = next(\n        (m.id for m in models\n         if m.custom_metadata.get(\"model_type\") == \"llm\"),\n        None,\n    )\n\n    if not inference_model_id:\n        print(\"No LLM model found. Exiting.\")\n        return\n\n    rich.print(f\"\\nUsing model: {inference_model_id}\\n\")\n\n    responses_api_streaming(client, inference_model_id)\n    print(\"\\n\")\n\n\nif __name__ == \"__main__\":\n    main()",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1791898610479,
      "labelPosition": null,
      "baseFontSize": null
    },
