      "frameId": null,
      "index": "c0ad",
      "roundness": null,
      "seed": 1235269334,
      "version": 721,
      "versionNonce": 427935190,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793614169773,
      "link": null,
      "locked": false,
      "text": "from kfp import dsl\n\n\n@dsl.component\n\ndef say_hello(name: str) -> str:\n    hello_text = f'Hello, {name}!'\n    print(hello_text)\n    return hello_text\n\n\n\n@dsl.pipeline\n\ndef hello_pipeline(recipient: str) -> str:\n\n\n\n    hello_task = say_hello(name=recipient)\n\n\n\n    return hello_task.output",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from kfp import dsl\n\n\n@dsl.component\n\ndef say_hello(name: str) -> str:\n    hello_text = f'Hello, {name}!'\n    print(hello_text)\n    return hello_text\n\n\n\n@dsl.pipeline\n\ndef hello_pipeline(recipient: str) -> str:\n\n\n\n    hello_task = say_hello(name=recipient)\n\n\n\n    return hello_task.output",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793614157797,
      "labelPosition": null,
      "baseFontSize": null
    },
