      "seed": 640774257,
      "version": 378,
      "versionNonce": 716515135,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791809346525,
      "created": 1791809322588,
      "link": null,
      "locked": false,
      "text": "[student@workstation client-chat-app]$ cat agent_config.env \n# Agent Configuration for genai-agentic lab\n#\n# These environment variables configure the todo agent client.\n# Fill in the values during the exercise.\n\n# Llama Stack server URL\nLLAMA_STACK_URL=https://llamastack-api-genai-agentic.apps.lab.example.com\n\n# Model identifier (as registered with vLLM)\nLLAMA_STACK_MODEL=vllm-inference/qwen3-06b\n\n# MCP server endpoint\nMCP_SSE_URL=http://todo-mcp.genai-agentic.svc:8081/mcp\n\n# Label to identify the MCP server in tool calls\nMCP_SERVER_LABEL=todo-tools",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation client-chat-app]$ cat agent_config.env \n# Agent Configuration for genai-agentic lab\n#\n# These environment variables configure the todo agent client.\n# Fill in the values during the exercise.\n\n# Llama Stack server URL\nLLAMA_STACK_URL=https://llamastack-api-genai-agentic.apps.lab.example.com\n\n# Model identifier (as registered with vLLM)\nLLAMA_STACK_MODEL=vllm-inference/qwen3-06b\n\n# MCP server endpoint\nMCP_SSE_URL=http://todo-mcp.genai-agentic.svc:8081/mcp\n\n# Label to identify the MCP server in tool calls\nMCP_SERVER_LABEL=todo-tools",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
