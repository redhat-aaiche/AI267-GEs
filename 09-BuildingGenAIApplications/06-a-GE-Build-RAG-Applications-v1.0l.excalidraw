      "groupIds": [
        "jB5g6yCwkL7jG54aDUNCG",
        "w3Hwg-WsbalyDqC72PArd",
        "-EglK_pogrym_IKWN8JSD",
        "zlGkUunu8MtKnmtAV69UK",
        "hgTkYm6ozc6gh40rmLWCx",
        "mH7pzWzYAn2Q6Pm3nAtWW",
        "eyuK0294IlMbOPoTfAm2C"
      ],
      "frameId": null,
      "index": "c0cQ",
      "roundness": null,
      "seed": 307820001,
      "version": 1261,
      "versionNonce": 2029676833,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791879952284,
      "link": null,
      "locked": false,
      "text": "[student@workstation genai-rag]$ cat rag_application.py\n\"\"\"RAG-powered question answering.\n\nThis script searches the vector store for relevant document chunks\nand uses them as context for the LLM to answer questions.\n\nUsage:\n    uv run rag_application.py \"Your question here\"\n\"\"\"\n\nimport logging\nimport re\nimport sys\n\nimport httpx\nfrom llama_stack_client import LlamaStackClient\n\nlogging.getLogger(\"httpx\").setLevel(logging.WARNING)\n\nLS_URL = \"https://llamastack-api-genai-rag.apps.lab.example.com\"\n\nhttp_client = httpx.Client(verify=False, timeout=300.0)\nclient = LlamaStackClient(base_url=LS_URL, http_client=http_client)\n\n# Get the LLM model ID\nmodels = client.models.list()\nmodel_id = next(\n    m.id for m in models\n    if m.custom_metadata.get(\"model_type\") == \"llm\"\n    and \"/\" not in m.custom_metadata.get(\"provider_resource_id\", \"/\")\n)\n\n# Get the vector store ID\nstores = client.vector_stores.list()\nvs_id = next(s.id for s in stores.data if s.name == \"rag-docs\")\n\n# Get the question from command-line arguments\nif len(sys.argv) < 2:\n    print('Usage: uv run rag_application.py \"Your question here\"')\n    sys.exit(1)\n\nquestion = sys.argv[1]\n\n# Step 1: Search the vector store for relevant chunks\nresults = client.vector_stores.search(\n    vector_store_id=vs_id,\n    query=question,\n    max_num_results=3,\n)\n\n# Step 2: Build context from retrieved chunks\ncontext = \"\\n\".join(r.content[0].text for r in results.data)\n\n# TODO: add implementation\nprompt = (\n    \"Use the following context to answer the question. \"\n    \"If the context does not contain relevant information, \"\n    \"say that you do not have enough information to answer.\\n\\n\"\n    f\"Context:\\n{context}\\n\\n\"\n    f\"Question: {question}\"\n)\n\nresponse = client.chat.completions.create(\n    model=model_id,\n    messages=[{\"role\": \"user\", \"content\": prompt}],\n)\n\ntext = response.choices[0].message.content\ntext = re.sub(r\"<think>.*?</think>\", \"\", text, flags=re.DOTALL).strip()\nprint(text)",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation genai-rag]$ cat rag_application.py\n\"\"\"RAG-powered question answering.\n\nThis script searches the vector store for relevant document chunks\nand uses them as context for the LLM to answer questions.\n\nUsage:\n    uv run rag_application.py \"Your question here\"\n\"\"\"\n\nimport logging\nimport re\nimport sys\n\nimport httpx\nfrom llama_stack_client import LlamaStackClient\n\nlogging.getLogger(\"httpx\").setLevel(logging.WARNING)\n\nLS_URL = \"https://llamastack-api-genai-rag.apps.lab.example.com\"\n\nhttp_client = httpx.Client(verify=False, timeout=300.0)\nclient = LlamaStackClient(base_url=LS_URL, http_client=http_client)\n\n# Get the LLM model ID\nmodels = client.models.list()\nmodel_id = next(\n    m.id for m in models\n    if m.custom_metadata.get(\"model_type\") == \"llm\"\n    and \"/\" not in m.custom_metadata.get(\"provider_resource_id\", \"/\")\n)\n\n# Get the vector store ID\nstores = client.vector_stores.list()\nvs_id = next(s.id for s in stores.data if s.name == \"rag-docs\")\n\n# Get the question from command-line arguments\nif len(sys.argv) < 2:\n    print('Usage: uv run rag_application.py \"Your question here\"')\n    sys.exit(1)\n\nquestion = sys.argv[1]\n\n# Step 1: Search the vector store for relevant chunks\nresults = client.vector_stores.search(\n    vector_store_id=vs_id,\n    query=question,\n    max_num_results=3,\n)\n\n# Step 2: Build context from retrieved chunks\ncontext = \"\\n\".join(r.content[0].text for r in results.data)\n\n# TODO: add implementation\nprompt = (\n    \"Use the following context to answer the question. \"\n    \"If the context does not contain relevant information, \"\n    \"say that you do not have enough information to answer.\\n\\n\"\n    f\"Context:\\n{context}\\n\\n\"\n    f\"Question: {question}\"\n)\n\nresponse = client.chat.completions.create(\n    model=model_id,\n    messages=[{\"role\": \"user\", \"content\": prompt}],\n)\n\ntext = response.choices[0].message.content\ntext = re.sub(r\"<think>.*?</think>\", \"\", text, flags=re.DOTALL).strip()\nprint(text)",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1791879939769,
      "labelPosition": null,
      "baseFontSize": null
