    {
      "id": "lm2tQ-lsWxyLNmBcUwGek",
      "type": "text",
      "x": 121.66036414565747,
      "y": 28279.272144381728,
      "width": 1623.5999755859375,
      "height": 45,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#f8f9fa",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dotted",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [
        "AFqaVXl6W1M7PMttNQzk8",
        "rGXqOvR4JrOgyPmZbn_FS",
        "7-6XxdPiktRlCuBJr4v1A"
      ],
      "frameId": null,
      "index": "c0EE",
      "roundness": null,
      "seed": 185947357,
      "version": 177,
      "versionNonce": 537502948,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793701882179,
      "link": null,
      "locked": false,
      "text": "https://developer.nvidia.com/blog/mastering-llm-techniques-inference-optimization/",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "https://developer.nvidia.com/blog/mastering-llm-techniques-inference-optimization/",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1793530250149,
      "baseFontSize": null
    },
    {
      "id": "yVYLQEKY2vK3uhICDbm8S",
      "type": "text",
      "x": 115.18536821466773,
      "y": 28387.605477715064,
      "width": 1526.0167236328125,
      "height": 585,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "OQdgmJ9gb9aHbdBGJzf4U",
        "AFqaVXl6W1M7PMttNQzk8",
        "rGXqOvR4JrOgyPmZbn_FS",
        "7-6XxdPiktRlCuBJr4v1A"
      ],
      "frameId": null,
      "index": "c0EF",
      "roundness": null,
      "seed": 179351869,
      "version": 376,
      "versionNonce": 2054851420,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793701882179,
      "link": null,
      "locked": false,
      "text": "--> Key-Value Caching :\n\n        ° One common optimization for the decode phase is KV caching. \n          The decode phase generates a single token at each time step, \n          but each token depends on the key and value tensors of all previous\n          tokens (including the input tokens’ KV tensors computed at prefill, \n          and any new KV tensors computed until the current time step). \n\n        ° To avoid recomputing all these tensors for all tokens at each time step, \n          it’s possible to cache them in GPU memory. Every iteration, when new elements\n          are computed, they are simply added to the running cache to be used in the\n          next iteration. \n         In some implementations, there is one KV cache for each layer of the model.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Key-Value Caching :\n\n        ° One common optimization for the decode phase is KV caching. \n          The decode phase generates a single token at each time step, \n          but each token depends on the key and value tensors of all previous\n          tokens (including the input tokens’ KV tensors computed at prefill, \n          and any new KV tensors computed until the current time step). \n\n        ° To avoid recomputing all these tensors for all tokens at each time step, \n          it’s possible to cache them in GPU memory. Every iteration, when new elements\n          are computed, they are simply added to the running cache to be used in the\n          next iteration. \n         In some implementations, there is one KV cache for each layer of the model.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1793530250149,
      "baseFontSize": null
    },
