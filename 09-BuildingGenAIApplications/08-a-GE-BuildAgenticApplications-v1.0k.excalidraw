    {
      "id": "v-WATdE9lmjX-_r3w9rD1",
      "type": "text",
      "x": 100,
      "y": 8280,
      "width": 970.2000122070312,
      "height": 2925,
      "angle": 0,
      "strokeColor": "#0c8599",
