      "angle": 0,
      "x": 211.23283188062044,
      "y": 88055.36664832756,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "width": 877.3999999999999,
      "height": 315,
      "seed": 727536693,
      "groupIds": [
        "dato8vETVr-iOJiklCisB",
        "3TneCjrVJM0tectEzE1wI",
        "VYhHDhQXD2gHO3Gmfyq9q",
        "6Jyjx32SN-hbw72M549R_",
        "cIj8VUKU1KOddTy7xFaBT",
