    {
      "type": "text",
      "version": 934,
      "versionNonce": 2076575196,
      "index": "bqi",
      "isDeleted": true,
      "id": "bLW4KBAt7dwt2aT4s66Q7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -931.5333333333328,
      "y": 328.9863124802364,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e7f5ff",
      "width": 941.5999999999999,
      "height": 765,
      "seed": 293710550,
      "groupIds": [
        "O9pIZm-9Hfp2lGBnhUk03"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1793709734204,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 8,
      "text": "° you can run ALL the cells :\n    ==> then open notebook \n        and click that “run all cells”\n\n° Instead, you can take the notebook\n  and then submit for execution in a\n  remote environment\n  - for example if you have access to\n    a particular server that has the \n    resources that you need to run \n    the notebook in an acceptable\n    amount of time, \n        ==> then you can submit your\n            notebook to that machine\n            and get access the results\n            within your jupyterlab\n            environment",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° you can run ALL the cells :\n    ==> then open notebook \n        and click that “run all cells”\n\n° Instead, you can take the notebook\n  and then submit for execution in a\n  remote environment\n  - for example if you have access to\n    a particular server that has the \n    resources that you need to run \n    the notebook in an acceptable\n    amount of time, \n        ==> then you can submit your\n            notebook to that machine\n            and get access the results\n            within your jupyterlab\n            environment",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793612050083,
      "labelPosition": null,
      "baseFontSize": null
    },
