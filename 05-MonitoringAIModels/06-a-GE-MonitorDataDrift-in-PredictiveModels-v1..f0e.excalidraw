      "seed": 1508769414,
      "version": 510,
      "versionNonce": 1912681030,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1785409478753,
      "link": null,
      "locked": false,
      "text": "[student@workstation scripts]$ cat apply_name_mapping.sh \n#!/bin/bash\n\noc login -u developer -p developer https://api.ocp4.example.com:6443 >/dev/null 2>&1\n\nMM_NAMESPACE=monitoring-bias\n\noc project $MM_NAMESPACE >/dev/null 2>&1\n\nMODEL_ALPHA=demo-loan-nn-onnx-alpha\nMODEL_BETA=demo-loan-nn-onnx-beta\nTRUSTY_ROUTE=https://$(oc get route/trustyai-service --template={{.spec.host}})\nTOKEN=${TOKEN:-$(oc whoami -t)}\n\nfor model in $MODEL_ALPHA $MODEL_BETA; do\n  echo \"Sending curl request for applying input and output field name mapping for model $model...\"\n  curl -sk  -H \"Authorization: Bearer ${TOKEN}\" -X POST --location $TRUSTY_ROUTE/info/names \\\n      -H \"Content-Type: application/json\" \\\n      -d \"{\n          \\\"modelId\\\": \\\"$model\\\",\n          \\\"inputMapping\\\":\n              {\n                  \\\"customer_data_input-0\\\": \\\"Number of Children\\\",\n                  \\\"customer_data_input-1\\\": \\\"Total Income\\\",\n                  \\\"customer_data_input-2\\\": \\\"Number of Total Family Members\\\",\n                  \\\"customer_data_input-3\\\": \\\"Is Male-Identifying?\\\",\n                  \\\"customer_data_input-4\\\": \\\"Owns Car?\\\",\n                  \\\"customer_data_input-5\\\": \\\"Owns Realty?\\\",\n                  \\\"customer_data_input-6\\\": \\\"Is Partnered?\\\",\n                  \\\"customer_data_input-7\\\": \\\"Is Employed?\\\",\n                  \\\"customer_data_input-8\\\": \\\"Live with Parents?\\\",\n                  \\\"customer_data_input-9\\\": \\\"Age\\\",\n                  \\\"customer_data_input-10\\\": \\\"Length of Employment?\\\"\n              },\n          \\\"outputMapping\\\":\n              {\n                  \\\"predict\\\": \\\"Will Default?\\\"\n              }\n      }\"\n  echo\ndone",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation scripts]$ cat apply_name_mapping.sh \n#!/bin/bash\n\noc login -u developer -p developer https://api.ocp4.example.com:6443 >/dev/null 2>&1\n\nMM_NAMESPACE=monitoring-bias\n\noc project $MM_NAMESPACE >/dev/null 2>&1\n\nMODEL_ALPHA=demo-loan-nn-onnx-alpha\nMODEL_BETA=demo-loan-nn-onnx-beta\nTRUSTY_ROUTE=https://$(oc get route/trustyai-service --template={{.spec.host}})\nTOKEN=${TOKEN:-$(oc whoami -t)}\n\nfor model in $MODEL_ALPHA $MODEL_BETA; do\n  echo \"Sending curl request for applying input and output field name mapping for model $model...\"\n  curl -sk  -H \"Authorization: Bearer ${TOKEN}\" -X POST --location $TRUSTY_ROUTE/info/names \\\n      -H \"Content-Type: application/json\" \\\n      -d \"{\n          \\\"modelId\\\": \\\"$model\\\",\n          \\\"inputMapping\\\":\n              {\n                  \\\"customer_data_input-0\\\": \\\"Number of Children\\\",\n                  \\\"customer_data_input-1\\\": \\\"Total Income\\\",\n                  \\\"customer_data_input-2\\\": \\\"Number of Total Family Members\\\",\n                  \\\"customer_data_input-3\\\": \\\"Is Male-Identifying?\\\",\n                  \\\"customer_data_input-4\\\": \\\"Owns Car?\\\",\n                  \\\"customer_data_input-5\\\": \\\"Owns Realty?\\\",\n                  \\\"customer_data_input-6\\\": \\\"Is Partnered?\\\",\n                  \\\"customer_data_input-7\\\": \\\"Is Employed?\\\",\n                  \\\"customer_data_input-8\\\": \\\"Live with Parents?\\\",\n                  \\\"customer_data_input-9\\\": \\\"Age\\\",\n                  \\\"customer_data_input-10\\\": \\\"Length of Employment?\\\"\n              },\n          \\\"outputMapping\\\":\n              {\n                  \\\"predict\\\": \\\"Will Default?\\\"\n              }\n      }\"\n  echo\ndone",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
