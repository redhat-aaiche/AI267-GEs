    {
      "id": "Jzm5JW4qG77oS2SZNkXez",
      "type": "text",
      "x": 371.6012382605534,
      "y": 54083.29798251379,
      "width": 831.5999755859375,
      "height": 1035,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "OhOF3BKfEahyQwcqIUeq0",
        "Ec0NjU_1mmASKff8vWXUe",
        "J8d_sSqCaWtn-OAc4yRMC",
        "dVkHxE5zXLqTAufvax48J"
