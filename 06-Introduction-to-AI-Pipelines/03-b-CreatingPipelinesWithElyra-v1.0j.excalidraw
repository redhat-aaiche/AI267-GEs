      "link": null,
      "locked": false,
      "text": " ° Will make\n   the S3 data connection\n   credentials available\n   to all nodes ",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " ° Will make\n   the S3 data connection\n   credentials available\n   to all nodes ",
      "autoResize": true,
      "lineHeight": 1.25,
