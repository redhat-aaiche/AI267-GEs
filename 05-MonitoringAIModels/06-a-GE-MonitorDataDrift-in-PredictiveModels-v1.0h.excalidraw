      "link": null,
      "locked": false,
      "text": "[student@workstation monitoring-drift]$ curl -s \\\n-H \"Authorization: Bearer ${TOKEN}\" \\\n${TRUSTY_ROUTE}/info | jq .\n{\n  \"diabetes\": {\n    \"metrics\": {\n      \"scheduledMetadata\": {\n        \"metricCounts\": {}\n      }\n    },\n    \"data\": {\n\n      \"inputSchema\": {\n        \"items\": {\n\n          \"Pregnancies\": {\n            \"type\": \"FLOAT\",\n            \"name\": \"dense_input-0\",\n            \"columnIndex\": 0\n          },\n\n...\n\n           \"Age\": {\n            \"type\": \"FLOAT\",\n            \"name\": \"dense_input-7\",\n            \"columnIndex\": 7\n          }\n        },\n\n        \"nameMapping\": {\n          \"dense_input-0\": \"Pregnancies\",\n          \"dense_input-1\": \"Glucose\",\n          \"dense_input-2\": \"BloodPressure\",\n          \"dense_input-3\": \"SkinThickness\",\n          \"dense_input-4\": \"Insulin\",\n          \"dense_input-5\": \"BMI\",\n          \"dense_input-6\": \"DiabetesPedigreeFunction\",\n          \"dense_input-7\": \"Age\"\n        }\n      },\n\n      \"outputSchema\": {\n        \"items\": {\n\n          \"Diabetes\": {\n            \"type\": \"FLOAT\",\n            \"name\": \"dense_2-1\",\n            \"columnIndex\": 9\n          },\n\n          \"No Diabetes\": {\n            \"type\": \"FLOAT\",\n            \"name\": \"dense_2-0\",\n            \"columnIndex\": 8\n          }\n        },\n\n        \"nameMapping\": {\n          \"dense_2-0\": \"No Diabetes\",\n          \"dense_2-1\": \"Diabetes\"\n        }\n\n      },\n      \"inputTensorName\": \"input\",\n      \"outputTensorName\": \"output\",\n      \"observations\": 768\n    }\n  }\n}",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation monitoring-drift]$ curl -s \\\n-H \"Authorization: Bearer ${TOKEN}\" \\\n${TRUSTY_ROUTE}/info | jq .\n{\n  \"diabetes\": {\n    \"metrics\": {\n      \"scheduledMetadata\": {\n        \"metricCounts\": {}\n      }\n    },\n    \"data\": {\n\n      \"inputSchema\": {\n        \"items\": {\n\n          \"Pregnancies\": {\n            \"type\": \"FLOAT\",\n            \"name\": \"dense_input-0\",\n            \"columnIndex\": 0\n          },\n\n...\n\n           \"Age\": {\n            \"type\": \"FLOAT\",\n            \"name\": \"dense_input-7\",\n            \"columnIndex\": 7\n          }\n        },\n\n        \"nameMapping\": {\n          \"dense_input-0\": \"Pregnancies\",\n          \"dense_input-1\": \"Glucose\",\n          \"dense_input-2\": \"BloodPressure\",\n          \"dense_input-3\": \"SkinThickness\",\n          \"dense_input-4\": \"Insulin\",\n          \"dense_input-5\": \"BMI\",\n          \"dense_input-6\": \"DiabetesPedigreeFunction\",\n          \"dense_input-7\": \"Age\"\n        }\n      },\n\n      \"outputSchema\": {\n        \"items\": {\n\n          \"Diabetes\": {\n            \"type\": \"FLOAT\",\n            \"name\": \"dense_2-1\",\n            \"columnIndex\": 9\n          },\n\n          \"No Diabetes\": {\n            \"type\": \"FLOAT\",\n            \"name\": \"dense_2-0\",\n            \"columnIndex\": 8\n          }\n        },\n\n        \"nameMapping\": {\n          \"dense_2-0\": \"No Diabetes\",\n          \"dense_2-1\": \"Diabetes\"\n        }\n\n      },\n      \"inputTensorName\": \"input\",\n      \"outputTensorName\": \"output\",\n      \"observations\": 768\n    }\n  }\n}",
