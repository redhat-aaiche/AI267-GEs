      "link": null,
      "locked": false,
      "text": "° Core idea :\n\n\n        ==> Virtual Memory System from Operating  systems\n\n\n\n        ==> Divide KV Cache into Pages\n             Store non-contiguously, no Waste\n\n\n        ==> Share Pages Across Requests\n            Memory savings",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Core idea :\n\n\n        ==> Virtual Memory System from Operating  systems\n\n\n\n        ==> Divide KV Cache into Pages\n             Store non-contiguously, no Waste\n\n\n        ==> Share Pages Across Requests\n            Memory savings",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
