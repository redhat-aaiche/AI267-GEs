      "seed": 2113979819,
      "version": 619,
      "versionNonce": 718094027,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786531679500,
      "link": null,
      "locked": false,
      "text": "° Extension of safetensors\n\n° Defines how the quantized weights and parameters are compressed and saved to disk\n\n° Compression schemes map to formats :\n\n    - e.g. W4A16 - weights are quantized to INT4, packed into INT32 and then saved to disk\n\n° Models saved with this format can seamlessly be loaded and run through vLLM\n\n° ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Extension of safetensors\n\n° Defines how the quantized weights and parameters are compressed and saved to disk\n\n° Compression schemes map to formats :\n\n    - e.g. W4A16 - weights are quantized to INT4, packed into INT32 and then saved to disk\n\n° Models saved with this format can seamlessly be loaded and run through vLLM\n\n° ",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
