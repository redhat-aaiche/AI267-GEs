      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 10.883333333375504,
      "y": 33351.68126864574,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 973.3,
      "height": 855,
      "seed": 911271946,
      "groupIds": [
        "VxukqgXsfq73-S6B59R6C",
        "Iivv4X0immavvXcQc_3s_",
        "wdeftAfklIVVI2G8HsLZs",
        "apf52gQZ9uYsRgRyNKi-h",
        "f35SnKiznqdOpMedJi2Xd",
        "wOa4Unl52GC76tupGBC2r",
        "MipTt3Bo7lLFCOfpejp-E",
        "BGCqsayWqwpLb-mdPx0ia"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1793709698747,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Elyra supports \" !! 3 !! \" Runtimes :\n\n    ° Local mode :\n        - use the runtime local to your laptop\n\n    ° Apache Airflow :\n        - package the pipeline and \n        - deploy for execution \n          in an Apache Airflow Server\n\n    ° Kubeflow Pipelines :\n        - package the pipeline and\n        - deploy for execution in a \n          Kubeflow Pipeline Runtime\n\n    ° OpenShift Pipelines :\n        - It looks like Kubeflow !!\n        or\n        - It is a custom Runtime",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Elyra supports \" !! 3 !! \" Runtimes :\n\n    ° Local mode :\n        - use the runtime local to your laptop\n\n    ° Apache Airflow :\n        - package the pipeline and \n        - deploy for execution \n          in an Apache Airflow Server\n\n    ° Kubeflow Pipelines :\n        - package the pipeline and\n        - deploy for execution in a \n          Kubeflow Pipeline Runtime\n\n    ° OpenShift Pipelines :\n        - It looks like Kubeflow !!\n        or\n        - It is a custom Runtime",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793612154995,
      "labelPosition": null,
      "baseFontSize": null
    },
