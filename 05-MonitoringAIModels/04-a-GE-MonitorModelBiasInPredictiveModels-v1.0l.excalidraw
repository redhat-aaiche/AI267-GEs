      "link": null,
      "locked": false,
      "text": "[student@workstation monitoring-bias]$ oc get route\nNAME                      HOST/PORT                                                      PATH   SERVICES                            PORT    TERMINATION          WILDCARD\ndemo-loan-nn-onnx-alpha   demo-loan-nn-onnx-alpha-monitoring-bias.apps.lab.example.com          demo-loan-nn-onnx-alpha-predictor   https   reencrypt/Redirect   None\ndemo-loan-nn-onnx-beta    demo-loan-nn-onnx-beta-monitoring-bias.apps.lab.example.com           demo-loan-nn-onnx-beta-predictor    https   reencrypt/Redirect   None\ntrustyai-service          trustyai-service-monitoring-bias.apps.lab.example.com                 trustyai-service-tls                https   reencrypt/Redirect   None\n[student@workstation monitoring-bias]$ TOKEN=$(oc whoami -t)\n[student@workstation monitoring-bias]$ curl -s -H \"Authorization: Bearer $TOKEN\"  \\ \n    https://demo-loan-nn-onnx-alpha-monitoring-bias.apps.lab.example.com/v2/models/demo-loan-nn-onnx-alpha | jq\n{\n  \"name\": \"demo-loan-nn-onnx-alpha\",\n  \"versions\": [\n    \"1\"\n  ],\n  \"platform\": \"OpenVINO\",\n  \"inputs\": [\n    {\n      \"name\": \"customer_data_input\",\n      \"datatype\": \"FP64\",\n      \"shape\": [\n        -1,\n        11\n      ]\n    }\n  ],\n  \"outputs\": [\n    {\n      \"name\": \"predict\",\n      \"datatype\": \"INT64\",\n      \"shape\": [\n        -1\n      ]\n    }\n  ]\n}",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation monitoring-bias]$ oc get route\nNAME                      HOST/PORT                                                      PATH   SERVICES                            PORT    TERMINATION          WILDCARD\ndemo-loan-nn-onnx-alpha   demo-loan-nn-onnx-alpha-monitoring-bias.apps.lab.example.com          demo-loan-nn-onnx-alpha-predictor   https   reencrypt/Redirect   None\ndemo-loan-nn-onnx-beta    demo-loan-nn-onnx-beta-monitoring-bias.apps.lab.example.com           demo-loan-nn-onnx-beta-predictor    https   reencrypt/Redirect   None\ntrustyai-service          trustyai-service-monitoring-bias.apps.lab.example.com                 trustyai-service-tls                https   reencrypt/Redirect   None\n[student@workstation monitoring-bias]$ TOKEN=$(oc whoami -t)\n[student@workstation monitoring-bias]$ curl -s -H \"Authorization: Bearer $TOKEN\"  \\ \n    https://demo-loan-nn-onnx-alpha-monitoring-bias.apps.lab.example.com/v2/models/demo-loan-nn-onnx-alpha | jq\n{\n  \"name\": \"demo-loan-nn-onnx-alpha\",\n  \"versions\": [\n    \"1\"\n  ],\n  \"platform\": \"OpenVINO\",\n  \"inputs\": [\n    {\n      \"name\": \"customer_data_input\",\n      \"datatype\": \"FP64\",\n      \"shape\": [\n        -1,\n        11\n      ]\n    }\n  ],\n  \"outputs\": [\n    {\n      \"name\": \"predict\",\n      \"datatype\": \"INT64\",\n      \"shape\": [\n        -1\n      ]\n    }\n  ]\n}",
