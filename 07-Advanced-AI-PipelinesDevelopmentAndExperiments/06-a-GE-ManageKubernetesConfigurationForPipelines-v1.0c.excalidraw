      "updated": 1786960086113,
      "link": null,
      "locked": false,
      "text": "[student@workstation dspa-config]$ cat pipeline.py \n\"\"\"\nPipeline for managing Kubernetes configuration with kfp-kubernetes.\n\nThis pipeline defines three components:\n- load_data: Reads database credentials from environment variables.\n- train_model: Trains a simple model (requires more resources).\n- evaluate_model: Evaluates the trained model and prints results.\n\nStudents must complete the TODO sections to:\n1. Inject a Kubernetes secret as environment variables.\n2. Disable caching on the data loading task.\n3. Set resource requests on the training task.\n\"\"\"\n\nfrom kfp import compiler, dsl\nfrom kfp import kubernetes  # noqa: F401\n\n\nBASE_IMAGE = \"registry.lab.example.com:8443/redhattraining/ai0020l-base:3.3.0\"\n\n\n@dsl.component(base_image=BASE_IMAGE)\ndef load_data() -> str:\n    \"\"\"Load data using database credentials from environment variables.\"\"\"\n    import os\n\n    db_user = os.environ.get(\"DB_USER\", \"\")\n    db_password = os.environ.get(\"DB_PASSWORD\", \"\")\n\n    if not db_user or not db_password:\n        raise ValueError(\n            \"DB_USER and DB_PASSWORD environment variables are not set. \"\n            \"Use kfp-kubernetes to inject the db-credentials secret.\"\n        )\n\n    print(f\"Connected to database as user: {db_user}\")\n    print(f\"Password length: {len(db_password)} characters\")\n\n    data_summary = f\"Loaded 1000 records from database as {db_user}\"\n    print(data_summary)\n    return data_summary\n\n\n@dsl.component(base_image=BASE_IMAGE)\ndef train_model(data_summary: str) -> float:\n    \"\"\"Train a simple model on the loaded data.\"\"\"\n    print(f\"Training model with: {data_summary}\")\n\n    # Simulate model training\n    import random\n\n    random.seed(42)\n    accuracy = 0.85 + random.uniform(0, 0.10)\n    print(f\"Model training complete. Accuracy: {accuracy:.4f}\")\n    return accuracy\n\n\n@dsl.component(base_image=BASE_IMAGE)\ndef evaluate_model(accuracy: float):\n    \"\"\"Evaluate the trained model and print results.\"\"\"\n    threshold = 0.80\n    print(f\"Model accuracy: {accuracy:.4f}\")\n    print(f\"Threshold: {threshold:.2f}\")\n\n    if accuracy >= threshold:\n        print(\"PASSED: Model meets the minimum accuracy threshold.\")\n    else:\n        raise ValueError(\n            f\"FAILED: Model accuracy {accuracy:.4f} \"\n            f\"is below the threshold {threshold:.2f}.\"\n        )\n\n\n@dsl.pipeline(name=\"dspa-config-pipeline\")\ndef pipeline():\n    \"\"\"Pipeline that demonstrates Kubernetes configuration with KFP.\"\"\"\n    # Load data from the database\n    load_task = load_data()\n\n    # TODO: Use kubernetes.use_secret_as_env() to inject the\n    #       \"db-credentials\" secret into the load_task.\n    #       Map the \"username\" key to the \"DB_USER\" env var,\n    #       and the \"password\" key to the \"DB_PASSWORD\" env var.\n    #       You need two separate use_secret_as_env() calls.\n\n    # TODO: Disable caching on the load_task by calling\n    #       load_task.set_caching_options(False)\n\n    # Train the model\n    train_task = train_model(data_summary=load_task.output)\n\n    # TODO: Set resource requests on the train_task:\n    #       - Memory: \"512Mi\" using train_task.set_memory_request()\n    #       - CPU: \"250m\" using train_task.set_cpu_request()\n\n    # Evaluate the model\n    evaluate_model(accuracy=train_task.output)\n\n\nif __name__ == \"__main__\":\n    outfile = \"pipeline.yaml\"\n    compiler.Compiler().compile(pipeline, outfile)\n    print(f\"Pipeline compiled.\\nUse the RHOAI dashboard to import the '{outfile}' file\")",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation dspa-config]$ cat pipeline.py \n\"\"\"\nPipeline for managing Kubernetes configuration with kfp-kubernetes.\n\nThis pipeline defines three components:\n- load_data: Reads database credentials from environment variables.\n- train_model: Trains a simple model (requires more resources).\n- evaluate_model: Evaluates the trained model and prints results.\n\nStudents must complete the TODO sections to:\n1. Inject a Kubernetes secret as environment variables.\n2. Disable caching on the data loading task.\n3. Set resource requests on the training task.\n\"\"\"\n\nfrom kfp import compiler, dsl\nfrom kfp import kubernetes  # noqa: F401\n\n\nBASE_IMAGE = \"registry.lab.example.com:8443/redhattraining/ai0020l-base:3.3.0\"\n\n\n@dsl.component(base_image=BASE_IMAGE)\ndef load_data() -> str:\n    \"\"\"Load data using database credentials from environment variables.\"\"\"\n    import os\n\n    db_user = os.environ.get(\"DB_USER\", \"\")\n    db_password = os.environ.get(\"DB_PASSWORD\", \"\")\n\n    if not db_user or not db_password:\n        raise ValueError(\n            \"DB_USER and DB_PASSWORD environment variables are not set. \"\n            \"Use kfp-kubernetes to inject the db-credentials secret.\"\n        )\n\n    print(f\"Connected to database as user: {db_user}\")\n    print(f\"Password length: {len(db_password)} characters\")\n\n    data_summary = f\"Loaded 1000 records from database as {db_user}\"\n    print(data_summary)\n    return data_summary\n\n\n@dsl.component(base_image=BASE_IMAGE)\ndef train_model(data_summary: str) -> float:\n    \"\"\"Train a simple model on the loaded data.\"\"\"\n    print(f\"Training model with: {data_summary}\")\n\n    # Simulate model training\n    import random\n\n    random.seed(42)\n    accuracy = 0.85 + random.uniform(0, 0.10)\n    print(f\"Model training complete. Accuracy: {accuracy:.4f}\")\n    return accuracy\n\n\n@dsl.component(base_image=BASE_IMAGE)\ndef evaluate_model(accuracy: float):\n    \"\"\"Evaluate the trained model and print results.\"\"\"\n    threshold = 0.80\n    print(f\"Model accuracy: {accuracy:.4f}\")\n    print(f\"Threshold: {threshold:.2f}\")\n\n    if accuracy >= threshold:\n        print(\"PASSED: Model meets the minimum accuracy threshold.\")\n    else:\n        raise ValueError(\n            f\"FAILED: Model accuracy {accuracy:.4f} \"\n            f\"is below the threshold {threshold:.2f}.\"\n        )\n\n\n@dsl.pipeline(name=\"dspa-config-pipeline\")\ndef pipeline():\n    \"\"\"Pipeline that demonstrates Kubernetes configuration with KFP.\"\"\"\n    # Load data from the database\n    load_task = load_data()\n\n    # TODO: Use kubernetes.use_secret_as_env() to inject the\n    #       \"db-credentials\" secret into the load_task.\n    #       Map the \"username\" key to the \"DB_USER\" env var,\n    #       and the \"password\" key to the \"DB_PASSWORD\" env var.\n    #       You need two separate use_secret_as_env() calls.\n\n    # TODO: Disable caching on the load_task by calling\n    #       load_task.set_caching_options(False)\n\n    # Train the model\n    train_task = train_model(data_summary=load_task.output)\n\n    # TODO: Set resource requests on the train_task:\n    #       - Memory: \"512Mi\" using train_task.set_memory_request()\n    #       - CPU: \"250m\" using train_task.set_cpu_request()\n\n    # Evaluate the model\n    evaluate_model(accuracy=train_task.output)\n\n\nif __name__ == \"__main__\":\n    outfile = \"pipeline.yaml\"\n    compiler.Compiler().compile(pipeline, outfile)\n    print(f\"Pipeline compiled.\\nUse the RHOAI dashboard to import the '{outfile}' file\")",
      "autoResize": true,
      "lineHeight": 1.25
    },
