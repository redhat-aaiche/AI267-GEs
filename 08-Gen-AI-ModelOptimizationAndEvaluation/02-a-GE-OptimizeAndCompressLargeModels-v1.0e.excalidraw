      "boundElements": [],
      "updated": 1775819729240,
      "link": null,
      "locked": false,
      "fontSize": 37.29732845673817,
      "fontFamily": 1,
      "text": "OpenShift Pipelines Resources :",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OpenShift Pipelines Resources :",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "FDcZzsrGXW3UhFH3_uGxV",
      "type": "text",
      "x": 692.517198972954,
      "y": -1254.2729135797567,
      "width": 1148,
      "height": 369.6,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bp5",
      "roundness": null,
      "seed": 116388456,
      "version": 34,
      "versionNonce": 724206666,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1775819729240,
      "link": null,
      "locked": false,
      "text": "- Tekton constructs pipelines from a list of Tasks, and therefore\n  the Task is the basic unit of OpenShift Pipelines as well. \n  A Task contains one or more steps. A Task occupies a pod, and\n  each of its steps runs as a container in that pod. Tasks execute \n  steps in serial order, starting each step on the completion of\n  the one before it. A pipeline executes a set of these Tasks. \n  Unlike the steps within them, all of a pipeline’s Tasks run at once\n  in parallel unless a Task is configured to wait on another. \n  A PipelineRun represents a single execution of a pipeline. \n  Each run can be configured with parameters read from the environment\n  or from programmatic input (Figure 5-5).",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Tekton constructs pipelines from a list of Tasks, and therefore\n  the Task is the basic unit of OpenShift Pipelines as well. \n  A Task contains one or more steps. A Task occupies a pod, and\n  each of its steps runs as a container in that pod. Tasks execute \n  steps in serial order, starting each step on the completion of\n  the one before it. A pipeline executes a set of these Tasks. \n  Unlike the steps within them, all of a pipeline’s Tasks run at once\n  in parallel unless a Task is configured to wait on another. \n  A PipelineRun represents a single execution of a pipeline. \n  Each run can be configured with parameters read from the environment\n  or from programmatic input (Figure 5-5).",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "CyrbmUwH_78LYDr-n_gva",
      "type": "image",
      "x": 773.5171989729538,
      "y": -714.2729135797565,
      "width": 838,
      "height": 296,
      "angle": 0,
      "strokeColor": "transparent",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
