    {
      "id": "5g7NcN5pSdp9orBpGIN8u",
      "type": "text",
      "x": -120,
      "y": 100280,
      "width": 1663.199951171875,
      "height": 3555,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "WQiFRg4Vuy9ioKuFoIPdt",
        "86uATA1oT5qDPZVVSBYU7",
        "iZYJ0zRhyL0MpJF7D5Z5x",
        "zoKNgGq1dA0GxZncQWvH-"
      ],
      "frameId": null,
      "index": "c0Zm",
      "roundness": null,
      "seed": 354795347,
      "version": 515,
      "versionNonce": 1616542195,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791898543598,
      "created": 1791898526136,
      "link": null,
      "locked": false,
      "text": "[student@workstation genai-app]$ cat llm_client.py \nimport os\n\nimport httpx\nfrom dotenv import load_dotenv\nfrom openai import OpenAI\n\n\nclass LLMClient:\n    \"\"\"Client for interacting with OpenAI-compatible LLM APIs.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initialize the OpenAI client with environment variables.\"\"\"\n        load_dotenv()\n\n        # Create custom httpx client that ignores SSL verification\n        # WARNING: insecure. use for testing only\n        http_client = httpx.Client(verify=False, timeout=300.0)\n\n        # The OpenAI client looks for OPENAI_API_KEY and OPENAI_BASE_URL by default.\n        self.client = OpenAI(http_client=http_client)\n        self.model_name = os.getenv(\"MODEL_NAME\", \"Qwen/Qwen3-0.6B\")\n\n    def query_streaming(self, query, temperature, history):\n        \"\"\"\n        Query the LLM with streaming response.\n\n        Yields updated chat history with assistant's response incrementally.\n        \"\"\"\n        if not query or not query.strip():\n            return history if history else []\n\n        # Build messages from history\n        messages = history.copy() if history else []\n        messages.append({\"role\": \"user\", \"content\": query})\n\n        # TODO: Create streaming completion\n        #stream = None\n        stream = self.client.chat.completions.create(\n            model=self.model_name,\n            temperature=float(temperature),\n            messages=messages,\n            stream=True,\n        )\n\n        # Initialize assistant message\n        assistant_message = \"\"\n\n        # Add user message to history\n        new_history = history.copy() if history else []\n        new_history.append({\"role\": \"user\", \"content\": query})\n\n        # Stream the response\n        for chunk in stream:\n            if chunk.choices and len(chunk.choices) > 0:\n                content = chunk.choices[0].delta.content\n\n                if content:\n                    assistant_message += content\n\n                    # Update or append assistant message\n                    if len(new_history) > len(history):\n                        if new_history[-1][\"role\"] == \"assistant\":\n                            new_history[-1] = {\n                                \"role\": \"assistant\",\n                                \"content\": assistant_message,\n                            }\n                        else:\n                            new_history.append(\n                                {\"role\": \"assistant\", \"content\": assistant_message}\n                            )\n\n                    yield new_history\n\n        return new_history\n\n    def get_model_name(self):\n        \"\"\"Return the currently configured model name.\"\"\"\n        return self.model_name",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation genai-app]$ cat llm_client.py \nimport os\n\nimport httpx\nfrom dotenv import load_dotenv\nfrom openai import OpenAI\n\n\nclass LLMClient:\n    \"\"\"Client for interacting with OpenAI-compatible LLM APIs.\"\"\"\n\n    def __init__(self):\n        \"\"\"Initialize the OpenAI client with environment variables.\"\"\"\n        load_dotenv()\n\n        # Create custom httpx client that ignores SSL verification\n        # WARNING: insecure. use for testing only\n        http_client = httpx.Client(verify=False, timeout=300.0)\n\n        # The OpenAI client looks for OPENAI_API_KEY and OPENAI_BASE_URL by default.\n        self.client = OpenAI(http_client=http_client)\n        self.model_name = os.getenv(\"MODEL_NAME\", \"Qwen/Qwen3-0.6B\")\n\n    def query_streaming(self, query, temperature, history):\n        \"\"\"\n        Query the LLM with streaming response.\n\n        Yields updated chat history with assistant's response incrementally.\n        \"\"\"\n        if not query or not query.strip():\n            return history if history else []\n\n        # Build messages from history\n        messages = history.copy() if history else []\n        messages.append({\"role\": \"user\", \"content\": query})\n\n        # TODO: Create streaming completion\n        #stream = None\n        stream = self.client.chat.completions.create(\n            model=self.model_name,\n            temperature=float(temperature),\n            messages=messages,\n            stream=True,\n        )\n\n        # Initialize assistant message\n        assistant_message = \"\"\n\n        # Add user message to history\n        new_history = history.copy() if history else []\n        new_history.append({\"role\": \"user\", \"content\": query})\n\n        # Stream the response\n        for chunk in stream:\n            if chunk.choices and len(chunk.choices) > 0:\n                content = chunk.choices[0].delta.content\n\n                if content:\n                    assistant_message += content\n\n                    # Update or append assistant message\n                    if len(new_history) > len(history):\n                        if new_history[-1][\"role\"] == \"assistant\":\n                            new_history[-1] = {\n                                \"role\": \"assistant\",\n                                \"content\": assistant_message,\n                            }\n                        else:\n                            new_history.append(\n                                {\"role\": \"assistant\", \"content\": assistant_message}\n                            )\n\n                    yield new_history\n\n        return new_history\n\n    def get_model_name(self):\n        \"\"\"Return the currently configured model name.\"\"\"\n        return self.model_name",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
