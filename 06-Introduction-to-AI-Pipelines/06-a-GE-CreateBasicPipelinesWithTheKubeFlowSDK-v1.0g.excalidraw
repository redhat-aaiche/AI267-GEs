      "fontSize": 28,
      "fontFamily": 3,
      "text": "@dsl.pipeline(name=\"sentiment-analysis\")\n\ndef pipeline():\n\n   # Load and preprocess data\n\n                       = process_data()\n   \n\n   texts =                    .outputs[\"texts\"]\n\n\n  \n   labels =                    .outputs[\"labels\"]\n\n\n\n    # Train the model\n\n              = train_model(texts=     , labels=      )\n\n    accuracy =          .output",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "@dsl.pipeline(name=\"sentiment-analysis\")\n\ndef pipeline():\n\n   # Load and preprocess data\n\n                       = process_data()\n   \n\n   texts =                    .outputs[\"texts\"]\n\n\n  \n   labels =                    .outputs[\"labels\"]\n\n\n\n    # Train the model\n\n              = train_model(texts=     , labels=      )\n\n    accuracy =          .output",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
