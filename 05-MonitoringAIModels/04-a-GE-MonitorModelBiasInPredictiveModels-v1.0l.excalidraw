      "updated": 1785406023887,
      "link": null,
      "locked": false,
      "text": "[student@workstation scripts]$ cat send_real_data.sh \n#!/bin/bash\n\nSCRIPT_DIR=$(cd \"$(dirname \"$0\")\" && pwd)\n\necho \"Sending real-world data for inference...\"\n\nfor batch in \"01\" \"02\" \"03\" \"04\" \"05\" \"06\" \"07\" \"08\"; do\n  echo \"Sending real-world data in batch $batch...\"\n  \"$SCRIPT_DIR/send_data_batch\" \"$SCRIPT_DIR/../data/batch_$batch.json\"\n  sleep 5\ndone",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation scripts]$ cat send_real_data.sh \n#!/bin/bash\n\nSCRIPT_DIR=$(cd \"$(dirname \"$0\")\" && pwd)\n\necho \"Sending real-world data for inference...\"\n\nfor batch in \"01\" \"02\" \"03\" \"04\" \"05\" \"06\" \"07\" \"08\"; do\n  echo \"Sending real-world data in batch $batch...\"\n  \"$SCRIPT_DIR/send_data_batch\" \"$SCRIPT_DIR/../data/batch_$batch.json\"\n  sleep 5\ndone",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
