      "link": null,
      "locked": false,
      "text": "\n\n\n\n\n---\nkind: ConfigMap\napiVersion: v1\nmetadata:\n\n  name: fms-orchestr8-config-gateway\n\n  labels:\n    app: fmstack-nlp\n\ndata:\n\n  config.yaml: |\n\n    orchestrator:\n      host: \"localhost\"\n      port: 8032\n\n\n    detectors:\n\n      - name: regex\n        input: true\n        output: true\n        detector_params:\n          regex:\n            - email\n            - us-phone-number\n            - credit-card\n            - \\b(?i:vmware|broadcom|docker|oracle|suse)\\b\n\n\n\n\n      - name: hap\n        input: true\n        output: true\n        detector_params: {}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n    routes\n\n      - name: all\n        detectors:\n          - regex\n          - hap\n\n\n      - name: passthrough\n        detectors:\n\n\n",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\n\n\n\n---\nkind: ConfigMap\napiVersion: v1\nmetadata:\n\n  name: fms-orchestr8-config-gateway\n\n  labels:\n    app: fmstack-nlp\n\ndata:\n\n  config.yaml: |\n\n    orchestrator:\n      host: \"localhost\"\n      port: 8032\n\n\n    detectors:\n\n      - name: regex\n        input: true\n        output: true\n        detector_params:\n          regex:\n            - email\n            - us-phone-number\n            - credit-card\n            - \\b(?i:vmware|broadcom|docker|oracle|suse)\\b\n\n\n\n\n      - name: hap\n        input: true\n        output: true\n        detector_params: {}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n    routes\n\n      - name: all\n        detectors:\n          - regex\n          - hap\n\n\n      - name: passthrough\n        detectors:\n\n\n",
      "autoResize": true,
