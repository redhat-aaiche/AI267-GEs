      "text": "[student@workstation dspa-artifacts]$ cat pipeline.py \n# ruff: noqa\n\"\"\"\nSentiment analysis pipeline using KFP artifacts.\n\nThis pipeline demonstrates how to use KFP artifact types to pass data\nbetween pipeline components: Dataset, Model, Metrics,\nClassificationMetrics, and Markdown.\n\"\"\"\n\nimport warnings\n\nwarnings.filterwarnings(\"ignore\", category=SyntaxWarning)\n\nfrom kfp import compiler\nfrom kfp.dsl import (\n    component,\n    pipeline,\n    importer,\n    Input,\n    Output,\n    Dataset,\n    Model,\n    Metrics,\n    ClassificationMetrics,\n    Markdown,\n)\n\nBASE_IMAGE = \"registry.lab.example.com:8443/redhattraining/ai0020l-base:3.3.0\"\n\n\n@component(\n    base_image=BASE_IMAGE,\n)\ndef preprocess_data(\n    dataset: Input[Dataset],\n    train_dataset: Output[Dataset],\n    test_dataset: Output[Dataset],\n):\n    \"\"\"Clean text data and split into training and testing subsets.\"\"\"\n    import pandas as pd\n    from sklearn.model_selection import train_test_split\n\n    # Read data from the input dataset artifact\n    data = pd.read_csv(dataset.path)\n\n    # Clean whitespace from comments\n    data[\"comment\"] = data[\"comment\"].str.strip()\n\n    # Convert sentiment text into numeric labels\n    class_ids = {\"positive\": 1, \"negative\": 0}\n    data[\"label\"] = data.sentiment.map(class_ids)\n\n    # Generate train / test subsets\n    X_train, X_test, y_train, y_test = train_test_split(\n        data.comment, data.label, test_size=0.2, random_state=83\n    )\n\n    # Save train / test datasets to output artifact paths\n    train_data = pd.DataFrame({\"text\": X_train, \"label\": y_train})\n    train_data.to_csv(train_dataset.path, index=False)\n\n    test_data = pd.DataFrame({\"text\": X_test, \"label\": y_test})\n    test_data.to_csv(test_dataset.path, index=False)\n\n\n@component(\n    base_image=BASE_IMAGE,\n)\ndef train_model(dataset: Input[Dataset], model: Output[Model]):\n    \"\"\"Train a Naive Bayes classifier on the training dataset.\"\"\"\n    import joblib\n    import pandas as pd\n    from sklearn.pipeline import make_pipeline\n    from sklearn.feature_extraction.text import TfidfVectorizer\n    from sklearn.naive_bayes import MultinomialNB\n\n    train_dataset = pd.read_csv(dataset.path)\n    X_train = train_dataset.text\n    y_train = train_dataset.label\n\n    # Create and train the model\n    classifier = make_pipeline(TfidfVectorizer(), MultinomialNB())\n    classifier.fit(X_train, y_train)\n\n    # Save the model to the output artifact path\n    joblib.dump(classifier, model.path)\n\n\n@component(\n    base_image=BASE_IMAGE,\n)\ndef evaluate_model(\n    model: Input[Model],\n    test_dataset: Input[Dataset],\n    metrics: Output[Metrics],\n    classification_metrics: Output[ClassificationMetrics],\n    report: Output[Markdown],\n):\n    \"\"\"Evaluate the trained model and produce metrics and a report.\"\"\"\n    import joblib\n    import pandas as pd\n    from sklearn.metrics import confusion_matrix, accuracy_score\n\n    # Load the model from the input artifact path\n    classifier = joblib.load(model.path)\n\n    # Load the test set from the input artifact path\n    test_data = pd.read_csv(test_dataset.path)\n    X_test = test_data.text\n    y_test = test_data.label\n\n    # Predict the sentiment on the test set\n    predictions = classifier.predict(X_test)\n\n    # Compute accuracy\n    score = accuracy_score(y_test, predictions)\n\n    classes = [\"negative\", \"positive\"]\n    conf_matrix = confusion_matrix(y_test, predictions).tolist()\n\n    # Log metrics\n    metrics.log_metric(\"accuracy\", score)\n    classification_metrics.log_confusion_matrix(classes, conf_matrix)\n\n    # Generate a Markdown report\n    content = \"# Sentiment Prediction Report on Test Set\\n\\n\"\n    for text, prediction, expected in zip(X_test, predictions, y_test):\n        predicted_class = classes[int(prediction)]\n        expected_class = classes[int(expected)]\n        content += (\n            f\"- Text: {text}, \"\n            f\"Prediction: {predicted_class}, \"\n            f\"Expected: {expected_class}\\n\"\n        )\n\n    # Write the report to the output artifact path\n    with open(report.path, \"w\") as f:\n        f.write(content)\n\n\n@pipeline(name=\"sentiment-artifacts\")\ndef sentiment_pipeline(\n    s3_data_path: str = \"s3://dspa-artifacts/data/data.csv\",\n) -> Model:\n    \"\"\"Sentiment analysis pipeline with artifacts.\"\"\"\n\n    # Import data from S3\n    import_data_task = importer(\n        artifact_uri=s3_data_path,\n        artifact_class=Dataset,\n        reimport=False,\n    )\n\n    # Preprocess and split data\n    preprocess_task = preprocess_data(\n        dataset=import_data_task.output,\n    )\n\n    # Train the model\n    train_task = train_model(\n        dataset=preprocess_task.outputs[\"train_dataset\"],\n    )\n    model = train_task.output\n\n    # Evaluate the model\n    evaluate_model(\n        model=model,\n        test_dataset=preprocess_task.outputs[\"test_dataset\"],\n    )\n\n    return model\n\n\nif __name__ == \"__main__\":\n    outfile = \"pipeline.yaml\"\n    compiler.Compiler().compile(sentiment_pipeline, outfile)\n    print(f\"Pipeline compiled.\\nUse the RHOAI dashboard to import the '{outfile}' file\")",
