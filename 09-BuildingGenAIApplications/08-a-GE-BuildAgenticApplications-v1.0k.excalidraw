      "created": 1791809447740,
      "link": null,
      "locked": false,
      "text": "° Deploy an MCP Server\n\n° Check the MCP Server is ready\n\n° List the tools the MCP Server is exposing ",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Deploy an MCP Server\n\n° Check the MCP Server is ready\n\n° List the tools the MCP Server is exposing ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "VSO5XRDuoWS1NGsGkUHhl",
      "type": "text",
      "x": 110.11466606411949,
      "y": 97933.64569880627,
      "width": 1722.5999755859375,
      "height": 9540,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "seGi2QrTNy1OsbjY7-xm1",
        "yrIKdTUixcSBO5ejz-K5x"
      ],
      "frameId": null,
      "index": "c0X8",
      "roundness": null,
      "seed": 134725247,
      "version": 438,
      "versionNonce": 1644626719,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791809467515,
      "link": null,
      "locked": false,
      "text": "[student@workstation mcp-todo-app]$ cat src/todo_app/mcp_server.py\n\"\"\"MCP server for the tasks application.\n\nSupports both stdio (local) and HTTP (network) transports.\nSet MCP_TRANSPORT=http and MCP_PORT=8081 for network mode.\n\"\"\"\n\nimport asyncio\nimport os\nfrom contextlib import asynccontextmanager\n\nfrom mcp.server import Server\nfrom mcp.server.stdio import stdio_server\nfrom mcp.server.streamable_http_manager import StreamableHTTPSessionManager\nfrom mcp.types import TextContent, Tool\nfrom starlette.applications import Starlette\nfrom starlette.requests import Request\nfrom starlette.responses import JSONResponse\nfrom starlette.routing import Mount, Route\n\nfrom .storage import storage\n\nserver = Server(\"todo-mcp\")\n\n\ndef _format_task(task: dict) -> str:\n    status = \"[x]\" if task[\"done\"] else \"[ ]\"\n    return f\"{status} ID {task['id']} ({task['due_date']}): {task['title']}\"\n\n\n@server.list_tools()\nasync def list_tools() -> list[Tool]:\n    return [\n        Tool(\n            name=\"add_task\",\n            description=\"Create a new task with a title and optional due date\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"title\": {\n                        \"type\": \"string\",\n                        \"description\": \"The task title/description\",\n                    },\n                    \"due_date\": {\n                        \"type\": \"string\",\n                        \"description\": \"Due date in YYYY-MM-DD format\",\n                    },\n                },\n                \"required\": [\"title\"],\n            },\n        ),\n        Tool(\n            name=\"complete_task\",\n            description=\"Mark a task as completed by its ID\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"task_id\": {\n                        \"type\": \"integer\",\n                        \"description\": \"The ID of the task to complete\",\n                    },\n                },\n                \"required\": [\"task_id\"],\n            },\n        ),\n        Tool(\n            name=\"get_tasks_for_date\",\n            description=\"Get all tasks for a specific date\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"due_date\": {\n                        \"type\": \"string\",\n                        \"description\": \"Date in YYYY-MM-DD format\",\n                    },\n                },\n                \"required\": [\"due_date\"],\n            },\n        ),\n        Tool(\n            name=\"get_pending_tasks\",\n            description=\"Get all incomplete tasks\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {},\n            },\n        ),\n        Tool(\n            name=\"search_tasks\",\n            description=\"Search tasks by keyword in title\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"keyword\": {\n                        \"type\": \"string\",\n                        \"description\": \"Keyword to search for\",\n                    },\n                },\n                \"required\": [\"keyword\"],\n            },\n        ),\n    ]\n\n\n@server.call_tool()\nasync def call_tool(name: str, arguments: dict) -> list[TextContent]:\n    if name == \"add_task\":\n        title = arguments[\"title\"]\n        due_date = arguments.get(\"due_date\")\n        task = storage.add_task(title, due_date)\n        return [\n            TextContent(\n                type=\"text\",\n                text=f\"Task created: {_format_task(task)}\",\n            )\n        ]\n\n    elif name == \"complete_task\":\n        task_id = arguments[\"task_id\"]\n        task = storage.complete_task(task_id)\n        if not task:\n            return [TextContent(type=\"text\", text=f\"Task {task_id} not found\")]\n        return [TextContent(type=\"text\", text=f\"Task completed: {_format_task(task)}\")]\n\n    elif name == \"get_tasks_for_date\":\n        due_date = arguments[\"due_date\"]\n        tasks = storage.get_tasks_by_date(due_date)\n        if not tasks:\n            return [TextContent(type=\"text\", text=f\"No tasks for {due_date}\")]\n        result = f\"Tasks for {due_date}:\\n\"\n        result += \"\\n\".join(_format_task(t) for t in tasks)\n        return [TextContent(type=\"text\", text=result)]\n\n    elif name == \"get_pending_tasks\":\n        tasks = storage.get_pending_tasks()\n        if not tasks:\n            return [TextContent(type=\"text\", text=\"No pending tasks\")]\n        result = f\"Pending tasks ({len(tasks)}):\\n\"\n        result += \"\\n\".join(_format_task(t) for t in tasks)\n        return [TextContent(type=\"text\", text=result)]\n\n    elif name == \"search_tasks\":\n        keyword = arguments[\"keyword\"]\n        tasks = storage.search_tasks(keyword)\n        if not tasks:\n            return [TextContent(type=\"text\", text=f\"No tasks found for '{keyword}'\")]\n        result = f\"Found {len(tasks)} task(s):\\n\"\n        result += \"\\n\".join(_format_task(t) for t in tasks)\n        return [TextContent(type=\"text\", text=result)]\n\n    return [TextContent(type=\"text\", text=f\"Unknown tool: {name}\")]\n\n\nasync def run_stdio_server():\n    \"\"\"Run MCP server over stdio (local mode).\"\"\"\n    async with stdio_server() as (read_stream, write_stream):\n        init_options = server.create_initialization_options()\n        await server.run(read_stream, write_stream, init_options)\n\n\ndef create_http_app() -> Starlette:\n    \"\"\"Create Starlette app with Streamable HTTP transport for MCP.\"\"\"\n    # Create session manager for handling MCP connections\n    session_manager = StreamableHTTPSessionManager(\n        app=server,\n        json_response=False,\n        stateless=True,  # Stateless mode for simpler operation\n    )\n\n    # Health check endpoint\n    async def health(request: Request) -> JSONResponse:\n        return JSONResponse({\"status\": \"ok\"})\n\n    # ASGI app wrapper for session manager\n    class MCPApp:\n        async def __call__(self, scope, receive, send):\n            await session_manager.handle_request(scope, receive, send)\n\n    mcp_app = MCPApp()\n\n    # Lifespan context for the session manager\n    @asynccontextmanager\n    async def lifespan(app: Starlette):\n        async with session_manager.run():\n            yield\n\n    # Create routes - Mount passes raw ASGI to the app\n    routes = [\n        Route(\"/health\", health),\n        Mount(\"/mcp\", app=mcp_app),\n        Mount(\"/sse\", app=mcp_app),\n    ]\n\n    return Starlette(routes=routes, lifespan=lifespan)\n\n\ndef main():\n    transport = os.environ.get(\"MCP_TRANSPORT\", \"stdio\")\n\n    if transport in (\"sse\", \"http\"):\n        import uvicorn\n\n        port = int(os.environ.get(\"MCP_PORT\", \"8081\"))\n        print(f\"Starting MCP server with Streamable HTTP transport on port {port}\")\n        app = create_http_app()\n        uvicorn.run(app, host=\"0.0.0.0\", port=port)\n    else:\n        asyncio.run(run_stdio_server())\n\n\nif __name__ == \"__main__\":\n    main()",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation mcp-todo-app]$ cat src/todo_app/mcp_server.py\n\"\"\"MCP server for the tasks application.\n\nSupports both stdio (local) and HTTP (network) transports.\nSet MCP_TRANSPORT=http and MCP_PORT=8081 for network mode.\n\"\"\"\n\nimport asyncio\nimport os\nfrom contextlib import asynccontextmanager\n\nfrom mcp.server import Server\nfrom mcp.server.stdio import stdio_server\nfrom mcp.server.streamable_http_manager import StreamableHTTPSessionManager\nfrom mcp.types import TextContent, Tool\nfrom starlette.applications import Starlette\nfrom starlette.requests import Request\nfrom starlette.responses import JSONResponse\nfrom starlette.routing import Mount, Route\n\nfrom .storage import storage\n\nserver = Server(\"todo-mcp\")\n\n\ndef _format_task(task: dict) -> str:\n    status = \"[x]\" if task[\"done\"] else \"[ ]\"\n    return f\"{status} ID {task['id']} ({task['due_date']}): {task['title']}\"\n\n\n@server.list_tools()\nasync def list_tools() -> list[Tool]:\n    return [\n        Tool(\n            name=\"add_task\",\n            description=\"Create a new task with a title and optional due date\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"title\": {\n                        \"type\": \"string\",\n                        \"description\": \"The task title/description\",\n                    },\n                    \"due_date\": {\n                        \"type\": \"string\",\n                        \"description\": \"Due date in YYYY-MM-DD format\",\n                    },\n                },\n                \"required\": [\"title\"],\n            },\n        ),\n        Tool(\n            name=\"complete_task\",\n            description=\"Mark a task as completed by its ID\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"task_id\": {\n                        \"type\": \"integer\",\n                        \"description\": \"The ID of the task to complete\",\n                    },\n                },\n                \"required\": [\"task_id\"],\n            },\n        ),\n        Tool(\n            name=\"get_tasks_for_date\",\n            description=\"Get all tasks for a specific date\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"due_date\": {\n                        \"type\": \"string\",\n                        \"description\": \"Date in YYYY-MM-DD format\",\n                    },\n                },\n                \"required\": [\"due_date\"],\n            },\n        ),\n        Tool(\n            name=\"get_pending_tasks\",\n            description=\"Get all incomplete tasks\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {},\n            },\n        ),\n        Tool(\n            name=\"search_tasks\",\n            description=\"Search tasks by keyword in title\",\n            inputSchema={\n                \"type\": \"object\",\n                \"properties\": {\n                    \"keyword\": {\n                        \"type\": \"string\",\n                        \"description\": \"Keyword to search for\",\n                    },\n                },\n                \"required\": [\"keyword\"],\n            },\n        ),\n    ]\n\n\n@server.call_tool()\nasync def call_tool(name: str, arguments: dict) -> list[TextContent]:\n    if name == \"add_task\":\n        title = arguments[\"title\"]\n        due_date = arguments.get(\"due_date\")\n        task = storage.add_task(title, due_date)\n        return [\n            TextContent(\n                type=\"text\",\n                text=f\"Task created: {_format_task(task)}\",\n            )\n        ]\n\n    elif name == \"complete_task\":\n        task_id = arguments[\"task_id\"]\n        task = storage.complete_task(task_id)\n        if not task:\n            return [TextContent(type=\"text\", text=f\"Task {task_id} not found\")]\n        return [TextContent(type=\"text\", text=f\"Task completed: {_format_task(task)}\")]\n\n    elif name == \"get_tasks_for_date\":\n        due_date = arguments[\"due_date\"]\n        tasks = storage.get_tasks_by_date(due_date)\n        if not tasks:\n            return [TextContent(type=\"text\", text=f\"No tasks for {due_date}\")]\n        result = f\"Tasks for {due_date}:\\n\"\n        result += \"\\n\".join(_format_task(t) for t in tasks)\n        return [TextContent(type=\"text\", text=result)]\n\n    elif name == \"get_pending_tasks\":\n        tasks = storage.get_pending_tasks()\n        if not tasks:\n            return [TextContent(type=\"text\", text=\"No pending tasks\")]\n        result = f\"Pending tasks ({len(tasks)}):\\n\"\n        result += \"\\n\".join(_format_task(t) for t in tasks)\n        return [TextContent(type=\"text\", text=result)]\n\n    elif name == \"search_tasks\":\n        keyword = arguments[\"keyword\"]\n        tasks = storage.search_tasks(keyword)\n        if not tasks:\n            return [TextContent(type=\"text\", text=f\"No tasks found for '{keyword}'\")]\n        result = f\"Found {len(tasks)} task(s):\\n\"\n        result += \"\\n\".join(_format_task(t) for t in tasks)\n        return [TextContent(type=\"text\", text=result)]\n\n    return [TextContent(type=\"text\", text=f\"Unknown tool: {name}\")]\n\n\nasync def run_stdio_server():\n    \"\"\"Run MCP server over stdio (local mode).\"\"\"\n    async with stdio_server() as (read_stream, write_stream):\n        init_options = server.create_initialization_options()\n        await server.run(read_stream, write_stream, init_options)\n\n\ndef create_http_app() -> Starlette:\n    \"\"\"Create Starlette app with Streamable HTTP transport for MCP.\"\"\"\n    # Create session manager for handling MCP connections\n    session_manager = StreamableHTTPSessionManager(\n        app=server,\n        json_response=False,\n        stateless=True,  # Stateless mode for simpler operation\n    )\n\n    # Health check endpoint\n    async def health(request: Request) -> JSONResponse:\n        return JSONResponse({\"status\": \"ok\"})\n\n    # ASGI app wrapper for session manager\n    class MCPApp:\n        async def __call__(self, scope, receive, send):\n            await session_manager.handle_request(scope, receive, send)\n\n    mcp_app = MCPApp()\n\n    # Lifespan context for the session manager\n    @asynccontextmanager\n    async def lifespan(app: Starlette):\n        async with session_manager.run():\n            yield\n\n    # Create routes - Mount passes raw ASGI to the app\n    routes = [\n        Route(\"/health\", health),\n        Mount(\"/mcp\", app=mcp_app),\n        Mount(\"/sse\", app=mcp_app),\n    ]\n\n    return Starlette(routes=routes, lifespan=lifespan)\n\n\ndef main():\n    transport = os.environ.get(\"MCP_TRANSPORT\", \"stdio\")\n\n    if transport in (\"sse\", \"http\"):\n        import uvicorn\n\n        port = int(os.environ.get(\"MCP_PORT\", \"8081\"))\n        print(f\"Starting MCP server with Streamable HTTP transport on port {port}\")\n        app = create_http_app()\n        uvicorn.run(app, host=\"0.0.0.0\", port=port)\n    else:\n        asyncio.run(run_stdio_server())\n\n\nif __name__ == \"__main__\":\n    main()",
