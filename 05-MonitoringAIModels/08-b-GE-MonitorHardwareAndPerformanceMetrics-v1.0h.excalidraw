      "text": "[student@workstation monitoring-performance]$ oc get ServingRuntime/kserve-ovms -o yaml\napiVersion: serving.kserve.io/v1alpha1\nkind: ServingRuntime\nmetadata:\n  annotations:\n    ...\n  labels:\n    opendatahub.io/dashboard: \"true\"\n  name: kserve-ovms\n  namespace: monitoring-performance\n\nspec:\n  annotations:\n    opendatahub.io/kserve-runtime: ovms\n\n    prometheus.io/path: /metrics\n    prometheus.io/port: \"8888\"\n\n  containers:\n  - args:\n    - --model_name={{.Name}}\n    - --port=8001\n    - --rest_port=8888\n    - --model_path=/mnt/models\n    - --file_system_poll_wait_seconds=0\n    - --grpc_bind_address=0.0.0.0\n    - --rest_bind_address=0.0.0.0\n    - --target_device=AUTO\n\n    - --metrics_enable\n\n    image: registry.redhat.io/rhoai/odh-openvino-model-server-rhel9@sha256:def...6\n    name: kserve-container\n    ports:\n    - containerPort: 8888\n      protocol: TCP\n    volumeMounts:\n    - mountPath: /dev/shm\n      name: shm\n  multiModel: false\n  protocolVersions:\n  - v2\n  - grpc-v2\n  supportedModelFormats:\n  - autoSelect: true\n    name: openvino_ir\n    version: opset13\n  - name: onnx\n    version: \"1\"\n  - autoSelect: true\n    name: tensorflow\n    version: \"1\"\n  - autoSelect: true\n    name: tensorflow\n    version: \"2\"\n  - autoSelect: true\n    name: paddle\n    version: \"2\"\n  - autoSelect: true\n    name: pytorch\n    version: \"2\"\n  volumes:\n  - emptyDir:\n      medium: Memory\n      sizeLimit: 2Gi\n    name: shm\n\n\n[student@workstation monitoring-performance]$ oc get InferenceService/distilbert -o yaml\napiVersion: serving.kserve.io/v1beta1\nkind: InferenceService\nmetadata:\n  annotations:\n    ...\n  labels:\n    ...\n  name: distilbert\n  namespace: monitoring-performance\n\nspec:\n  predictor:\n    automountServiceAccountToken: false\n    maxReplicas: 1\n    minReplicas: 1\n    model:\n      modelFormat:\n        name: onnx\n        version: \"1\"\n      name: \"\"\n      resources:\n        limits:\n          cpu: \"2\"\n          memory: 4Gi\n        requests:\n          cpu: \"1\"\n          memory: 2Gi\n      runtime: kserve-ovms\n      storageUri: oci://registry.lab.example.com:8443/redhattraining/models/distilbert:2.25\n    timeout: 300\n",
