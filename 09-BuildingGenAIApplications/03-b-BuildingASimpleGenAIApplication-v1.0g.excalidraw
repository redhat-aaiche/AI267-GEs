    {
      "type": "text",
      "version": 2056,
      "versionNonce": 515699164,
      "index": "bq6",
      "isDeleted": true,
      "id": "CR_U-DJH-bXjjBHLVjT42",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2.283345540364735,
      "y": 395.38095238097594,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "width": 1099.0167236328125,
      "height": 90,
      "seed": 1769605546,
      "groupIds": [
        "RfjRRge_o7OQ6u6AJQri5",
        "KGt6potpGHuJOy2bbv72f"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1793724511885,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Most of the tasks solved by the use of Machine Learning\n    fall into these categories :",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Most of the tasks solved by the use of Machine Learning\n    fall into these categories :",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1791965780418,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 1501,
      "versionNonce": 1831381476,
      "index": "bq7",
      "isDeleted": true,
      "id": "Ak-25FhhXlVj4HsxveZ-b",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 9.188087100074199,
      "y": -275.70833333337214,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "width": 1623.5999755859375,
      "height": 585,
      "seed": 1503609962,
      "groupIds": [
        "RfjRRge_o7OQ6u6AJQri5",
        "KGt6potpGHuJOy2bbv72f"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1793724511885,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 8,
      "text": "--> In Machine Learning, we also have the concept of problem types\n\n--> This is the type of outcome or target variable that you\n    want the model to be producing\n\n- Some common ones are regression, which is typically a numeric value of some sort\n\n- You may have a classification, which is some type of label for image detection, \n  that would be cat or dog or blue or yellow. Okay\n\n- You may have even a generation outcome\n- This is what LLMs produce when they're producing text or images based off of\n  some type of prompt that you have provided",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> In Machine Learning, we also have the concept of problem types\n\n--> This is the type of outcome or target variable that you\n    want the model to be producing\n\n- Some common ones are regression, which is typically a numeric value of some sort\n\n- You may have a classification, which is some type of label for image detection, \n  that would be cat or dog or blue or yellow. Okay\n\n- You may have even a generation outcome\n- This is what LLMs produce when they're producing text or images based off of\n  some type of prompt that you have provided",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1791965780418,
      "labelPosition": null,
      "baseFontSize": null
    },
