      "opacity": 100,
      "groupIds": [
        "6J1H7_5_frwjroRAVnjsl",
        "vpKTKaq6EQ_bz7SenM1xD",
        "5lPfKFU9mbtXna9AiZ20u",
        "ZCHMT2q84BI0uBTubzLIV",
        "A2pnOXoDIMvOg9WIGCrMf",
        "JjSWn8mnCOm_jqszC31rR",
