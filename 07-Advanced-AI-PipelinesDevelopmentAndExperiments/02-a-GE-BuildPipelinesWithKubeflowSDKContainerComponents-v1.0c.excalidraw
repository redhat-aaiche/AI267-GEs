    {
      "id": "eL462_0Iprls6rziDE-mZ",
      "type": "text",
      "x": 1000,
      "y": 13360,
      "width": 1742.4000244140625,
      "height": 4410,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "U1QyPMpa3ZNX_gDz9-BW_"
      ],
      "frameId": null,
      "index": "c0D9",
      "roundness": null,
      "seed": 1004621054,
      "version": 14,
      "versionNonce": 370033634,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786953193246,
      "link": null,
      "locked": false,
      "text": "[student@workstation dspa-containers]$ cat pipeline.py \n\"\"\"\nSentiment analysis pipeline using KFP lightweight components.\n\nThis pipeline defines three components:\n- process_data: Loads and validates text samples for sentiment analysis.\n- train_model: Trains a Naive Bayes classifier on the processed data.\n- verify_accuracy: Checks that the trained model meets a minimum accuracy.\n\nIMPORTANT: The process_data component imports a local 'utils' module.\nThis import fails at runtime because KFP lightweight components only copy\nthe function body into the container, not adjacent Python files.\n\"\"\"\n\nfrom kfp import compiler, dsl\nfrom typing import List, NamedTuple\n\n\nBASE_IMAGE = \"registry.lab.example.com:8443/redhattraining/ai0020l-base:3.3.0\"\n\n\n@dsl.component(base_image=BASE_IMAGE)\ndef process_data() -> NamedTuple(\"outputs\", texts=List[str], labels=List[int]):\n    \"\"\"Load and validate sample data for sentiment analysis.\"\"\"\n\n    from utils import validate_samples\n\n    raw_texts = [\n        \"I love this product\",\n        \"Terrible experience\",\n        \"Great quality and fast shipping\",\n        \"Worst purchase ever\",\n        \"Highly recommended\",\n        \"Do not buy this\",\n        \"Exceeded my expectations\",\n        \"Very disappointing\",\n    ]\n    raw_labels = [1, 0, 1, 0, 1, 0, 1, 0]\n\n    texts, labels = validate_samples(raw_texts, raw_labels)\n\n    from collections import namedtuple\n\n    outputs = namedtuple(\"outputs\", [\"texts\", \"labels\"])\n    return outputs(texts=texts, labels=labels)\n\n\n@dsl.component(base_image=BASE_IMAGE)\ndef train_model(texts: list, labels: list) -> float:\n    \"\"\"Train a Naive Bayes classifier and return the accuracy.\"\"\"\n    from sklearn.feature_extraction.text import CountVectorizer\n    from sklearn.naive_bayes import MultinomialNB\n\n    vectorizer = CountVectorizer()\n    X = vectorizer.fit_transform(texts)\n\n    model = MultinomialNB()\n    model.fit(X, labels)\n\n    accuracy = model.score(X, labels)\n    print(f\"Model accuracy: {accuracy:.2f}\")\n    return accuracy\n\n\n@dsl.component(base_image=BASE_IMAGE)\ndef verify_accuracy(accuracy: float, threshold: float):\n    \"\"\"Verify that the model accuracy meets the minimum threshold.\"\"\"\n    if accuracy < threshold:\n        raise ValueError(\n            f\"The model did not achieve the minimum accuracy of \"\n            f\"{threshold * 100:.0f}%. Actual: {accuracy * 100:.0f}%.\"\n        )\n    print(\n        f\"Model accuracy {accuracy * 100:.0f}% \"\n        f\"meets the minimum threshold of {threshold * 100:.0f}%.\"\n    )\n\n\n@dsl.pipeline(name=\"sentiment-analysis\")\ndef pipeline():\n    \"\"\"Sentiment analysis pipeline.\"\"\"\n    # Load and preprocess data\n    data_task = process_data()\n    texts = data_task.outputs[\"texts\"]\n    labels = data_task.outputs[\"labels\"]\n\n    # Train the model\n    train_task = train_model(texts=texts, labels=labels)\n    accuracy = train_task.output\n\n    # Verify the model accuracy\n    verify_accuracy(accuracy=accuracy, threshold=0.5)\n\n\nif __name__ == \"__main__\":\n    outfile = \"pipeline.yaml\"\n    compiler.Compiler().compile(pipeline, outfile)\n    print(f\"Pipeline compiled.\\nUse the RHOAI dashboard to import the '{outfile}' file\")",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation dspa-containers]$ cat pipeline.py \n\"\"\"\nSentiment analysis pipeline using KFP lightweight components.\n\nThis pipeline defines three components:\n- process_data: Loads and validates text samples for sentiment analysis.\n- train_model: Trains a Naive Bayes classifier on the processed data.\n- verify_accuracy: Checks that the trained model meets a minimum accuracy.\n\nIMPORTANT: The process_data component imports a local 'utils' module.\nThis import fails at runtime because KFP lightweight components only copy\nthe function body into the container, not adjacent Python files.\n\"\"\"\n\nfrom kfp import compiler, dsl\nfrom typing import List, NamedTuple\n\n\nBASE_IMAGE = \"registry.lab.example.com:8443/redhattraining/ai0020l-base:3.3.0\"\n\n\n@dsl.component(base_image=BASE_IMAGE)\ndef process_data() -> NamedTuple(\"outputs\", texts=List[str], labels=List[int]):\n    \"\"\"Load and validate sample data for sentiment analysis.\"\"\"\n\n    from utils import validate_samples\n\n    raw_texts = [\n        \"I love this product\",\n        \"Terrible experience\",\n        \"Great quality and fast shipping\",\n        \"Worst purchase ever\",\n        \"Highly recommended\",\n        \"Do not buy this\",\n        \"Exceeded my expectations\",\n        \"Very disappointing\",\n    ]\n    raw_labels = [1, 0, 1, 0, 1, 0, 1, 0]\n\n    texts, labels = validate_samples(raw_texts, raw_labels)\n\n    from collections import namedtuple\n\n    outputs = namedtuple(\"outputs\", [\"texts\", \"labels\"])\n    return outputs(texts=texts, labels=labels)\n\n\n@dsl.component(base_image=BASE_IMAGE)\ndef train_model(texts: list, labels: list) -> float:\n    \"\"\"Train a Naive Bayes classifier and return the accuracy.\"\"\"\n    from sklearn.feature_extraction.text import CountVectorizer\n    from sklearn.naive_bayes import MultinomialNB\n\n    vectorizer = CountVectorizer()\n    X = vectorizer.fit_transform(texts)\n\n    model = MultinomialNB()\n    model.fit(X, labels)\n\n    accuracy = model.score(X, labels)\n    print(f\"Model accuracy: {accuracy:.2f}\")\n    return accuracy\n\n\n@dsl.component(base_image=BASE_IMAGE)\ndef verify_accuracy(accuracy: float, threshold: float):\n    \"\"\"Verify that the model accuracy meets the minimum threshold.\"\"\"\n    if accuracy < threshold:\n        raise ValueError(\n            f\"The model did not achieve the minimum accuracy of \"\n            f\"{threshold * 100:.0f}%. Actual: {accuracy * 100:.0f}%.\"\n        )\n    print(\n        f\"Model accuracy {accuracy * 100:.0f}% \"\n        f\"meets the minimum threshold of {threshold * 100:.0f}%.\"\n    )\n\n\n@dsl.pipeline(name=\"sentiment-analysis\")\ndef pipeline():\n    \"\"\"Sentiment analysis pipeline.\"\"\"\n    # Load and preprocess data\n    data_task = process_data()\n    texts = data_task.outputs[\"texts\"]\n    labels = data_task.outputs[\"labels\"]\n\n    # Train the model\n    train_task = train_model(texts=texts, labels=labels)\n    accuracy = train_task.output\n\n    # Verify the model accuracy\n    verify_accuracy(accuracy=accuracy, threshold=0.5)\n\n\nif __name__ == \"__main__\":\n    outfile = \"pipeline.yaml\"\n    compiler.Compiler().compile(pipeline, outfile)\n    print(f\"Pipeline compiled.\\nUse the RHOAI dashboard to import the '{outfile}' file\")",
      "autoResize": true,
      "lineHeight": 1.25
    },
