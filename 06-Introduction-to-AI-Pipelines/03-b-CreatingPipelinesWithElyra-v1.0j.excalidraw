      "version": 744,
      "versionNonce": 329814364,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793709734204,
      "link": null,
      "locked": false,
      "text": "° instead of doing an ssh connection\n  to a “powerful machine” and run the\n  script there– here it is done for you",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° instead of doing an ssh connection\n  to a “powerful machine” and run the\n  script there– here it is done for you",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793612050083,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "line",
      "version": 834,
      "versionNonce": 1172882020,
      "index": "bqh",
      "isDeleted": true,
      "id": "tm_N_Ibx3CVrr9RwfjHVY",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 228.46666666666715,
      "y": 446.4863124802364,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e7f5ff",
      "width": 395,
      "height": 77.5,
      "seed": 82038166,
