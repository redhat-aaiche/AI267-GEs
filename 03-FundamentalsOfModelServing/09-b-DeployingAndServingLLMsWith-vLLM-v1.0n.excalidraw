      "versionNonce": 1393262003,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793532346066,
      "link": null,
      "locked": false,
      "text": "( * ) Pages from the VRAM GPU Cache\n      might be moved to CPU RAM\n\n        ==> Why : think when we don't have \n             anymore space in the VRAM Cache\n                ==> you either move the KV to the CPU Memory\n                     done for long sequences\n                ==> or you discard them for short sequences\n                     then they will recomputed",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "( * ) Pages from the VRAM GPU Cache\n      might be moved to CPU RAM\n\n        ==> Why : think when we don't have \n             anymore space in the VRAM Cache\n                ==> you either move the KV to the CPU Memory\n                     done for long sequences\n                ==> or you discard them for short sequences\n                     then they will recomputed",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1793532342970,
      "baseFontSize": null
    },
