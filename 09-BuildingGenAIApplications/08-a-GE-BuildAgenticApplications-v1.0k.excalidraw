      "seed": 102920433,
      "version": 1855,
      "versionNonce": 622720753,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791809255047,
      "link": null,
      "locked": false,
      "text": "apiVersion: datasciencecluster.opendatahub.io/v2\nkind: DataScienceCluster\nmetadata:\n  labels:\n    app.kubernetes.io/part-of: rhods-operator\n    ...\n\n  name: default-dsc\n  ...\n\nspec:\n\n  components:\n\n    aipipelines:\n      managementState: Managed\n\n    dashboard:\n      managementState: Managed\n\n    feastoperator: {}\n\n    kserve:\n      managementState: Managed\n      modelsAsService:\n        managementState: Removed\n      nim:\n        managementState: Managed\n      rawDeploymentServiceConfig: Headless\n\n    kueue:\n      defaultClusterQueueName: default\n      defaultLocalQueueName: default\n\n\n    llamastackoperator:\n      managementState: Managed\n\n\n\n\n    mlflowoperator:\n      managementState: Removed\n\n    modelregistry:\n      registriesNamespace: rhoai-model-registries\n\n    ray:\n      managementState: Removed\n\n    trainer:\n      managementState: Removed\n\n    trainingoperator: {}\n\n    trustyai:\n      eval:\n        lmeval:\n          permitCodeExecution: deny\n          permitOnline: deny\n      managementState: Managed\n\n    workbenches:\n      managementState: Managed\n      workbenchNamespace: rhods-notebooks",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
