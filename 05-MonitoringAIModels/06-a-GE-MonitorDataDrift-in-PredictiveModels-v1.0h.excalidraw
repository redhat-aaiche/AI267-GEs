      "updated": 1792929865748,
      "link": null,
      "locked": false,
      "text": "#!/bin/bash\n# View TrustyAI drift metrics through the API\n\necho \"=== 1. Check scheduled drift monitoring requests ===\"\ncurl -sk -H \"Authorization: Bearer ${TOKEN}\" \\\n  ${TRUSTY_ROUTE}/metrics/drift/meanshift/requests | jq .\n\necho -e \"\\n=== 2. Get current drift metric values ===\"\ncurl -sk -H \"Authorization: Bearer ${TOKEN}\" \\\n  -X POST ${TRUSTY_ROUTE}/metrics/drift/meanshift \\\n  -H 'Content-Type: application/json' \\\n  -d '{\n    \"modelId\": \"diabetes\",\n    \"referenceTag\": \"TRAINING\"\n  }' | jq .\n\necho -e \"\\n=== 3. Check all metric requests ===\"\ncurl -sk -H \"Authorization: Bearer ${TOKEN}\" \\\n  ${TRUSTY_ROUTE}/metrics/all/requests | jq .\n\necho -e \"\\n=== 4. Check TrustyAI Prometheus metrics endpoint ===\"\ncurl -sk -H \"Authorization: Bearer ${TOKEN}\" \\\n  ${TRUSTY_ROUTE}/q/metrics | grep trustyai",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#!/bin/bash\n# View TrustyAI drift metrics through the API\n\necho \"=== 1. Check scheduled drift monitoring requests ===\"\ncurl -sk -H \"Authorization: Bearer ${TOKEN}\" \\\n  ${TRUSTY_ROUTE}/metrics/drift/meanshift/requests | jq .\n\necho -e \"\\n=== 2. Get current drift metric values ===\"\ncurl -sk -H \"Authorization: Bearer ${TOKEN}\" \\\n  -X POST ${TRUSTY_ROUTE}/metrics/drift/meanshift \\\n  -H 'Content-Type: application/json' \\\n  -d '{\n    \"modelId\": \"diabetes\",\n    \"referenceTag\": \"TRAINING\"\n  }' | jq .\n\necho -e \"\\n=== 3. Check all metric requests ===\"\ncurl -sk -H \"Authorization: Bearer ${TOKEN}\" \\\n  ${TRUSTY_ROUTE}/metrics/all/requests | jq .\n\necho -e \"\\n=== 4. Check TrustyAI Prometheus metrics endpoint ===\"\ncurl -sk -H \"Authorization: Bearer ${TOKEN}\" \\\n  ${TRUSTY_ROUTE}/q/metrics | grep trustyai",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1792929847156,
      "labelPosition": null,
      "baseFontSize": null
    },
