      "boundElements": [],
      "updated": 1789295513592,
      "created": 1789295502483,
      "link": null,
      "locked": false,
      "text": "kind: ConfigMap\napiVersion: v1\nmetadata:\n  name: fms-orchestr8-config-nlp\ndata:\n  config.yaml: |\n    chat_generation:\n      service:\n        hostname: qwen3-predictor.genai-guardrails.svc.cluster.local\n        port: 8080\n    detectors:\n      regex:\n        type: text_contents\n        service:\n            hostname: \"127.0.0.1\"\n            port: 8080\n        chunker_id: whole_doc_chunker\n        default_threshold: 0.5\n      hap:\n        type: text_contents\n        service:\n          hostname: ibm-hate-and-profanity-detector-predictor.genai-guardrails.svc.cluster.local\n          port: 8000\n        chunker_id: whole_doc_chunker\n        default_threshold: 0.5",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "kind: ConfigMap\napiVersion: v1\nmetadata:\n  name: fms-orchestr8-config-nlp\ndata:\n  config.yaml: |\n    chat_generation:\n      service:\n        hostname: qwen3-predictor.genai-guardrails.svc.cluster.local\n        port: 8080\n    detectors:\n      regex:\n        type: text_contents\n        service:\n            hostname: \"127.0.0.1\"\n            port: 8080\n        chunker_id: whole_doc_chunker\n        default_threshold: 0.5\n      hap:\n        type: text_contents\n        service:\n          hostname: ibm-hate-and-profanity-detector-predictor.genai-guardrails.svc.cluster.local\n          port: 8000\n        chunker_id: whole_doc_chunker\n        default_threshold: 0.5",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
