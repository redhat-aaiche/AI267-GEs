      "link": null,
      "locked": false,
      "text": "[student@workstation model-evaljob]$ cat eval-1.yaml \n\napiVersion: trustyai.opendatahub.io/v1alpha1\n\nkind: LMEvalJob\n\nmetadata:\n  name: eval-1\n\nspec:\n  model: local-completions\n  modelArgs:\n  - name: model\n    value: granite\n  - name: base_url\n    value: https://granite-model-evaljob.apps.lab.example.com/v1/completions\n  - name: num_concurrent\n    value: \"1\"\n  - name: max_retries\n    value: \"3\"\n  - name: tokenized_requests\n    value: \"False\"\n  - name: tokenizer\n    value: ibm-granite/granite-4.0-h-350m\n  - name: verify_certificate\n    value: \"False\"\n  taskList:\n    taskNames:\n    - openbookqa\n  allowOnline: true\n  allowCodeExecution: true\n  batchSize: \"1\"\n  limit: \"50\"\n  logSamples: true\n  outputs:\n    pvcManaged:\n      size: 100Mi",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation model-evaljob]$ cat eval-1.yaml \n\napiVersion: trustyai.opendatahub.io/v1alpha1\n\nkind: LMEvalJob\n\nmetadata:\n  name: eval-1\n\nspec:\n  model: local-completions\n  modelArgs:\n  - name: model\n    value: granite\n  - name: base_url\n    value: https://granite-model-evaljob.apps.lab.example.com/v1/completions\n  - name: num_concurrent\n    value: \"1\"\n  - name: max_retries\n    value: \"3\"\n  - name: tokenized_requests\n    value: \"False\"\n  - name: tokenizer\n    value: ibm-granite/granite-4.0-h-350m\n  - name: verify_certificate\n    value: \"False\"\n  taskList:\n    taskNames:\n    - openbookqa\n  allowOnline: true\n  allowCodeExecution: true\n  batchSize: \"1\"\n  limit: \"50\"\n  logSamples: true\n  outputs:\n    pvcManaged:\n      size: 100Mi",
