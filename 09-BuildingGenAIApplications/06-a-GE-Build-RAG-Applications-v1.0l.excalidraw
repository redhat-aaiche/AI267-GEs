      "text": "[student@workstation genai-rag]$ cat ingest_documents.py\n\"\"\"Ingest documents into the RAG vector store.\n\nThis script reads Markdown documents from the docs/ directory,\nuploads them as files, and attaches them to the vector store.\n\"\"\"\n\nimport logging\nimport os\n\nimport httpx\nfrom llama_stack_client import LlamaStackClient\n\nlogging.getLogger(\"httpx\").setLevel(logging.WARNING)\n\nLS_URL = \"https://llama-stack-genai-rag.apps.ocp4.example.com\"\n\nhttp_client = httpx.Client(verify=False, timeout=300.0)\nclient = LlamaStackClient(base_url=LS_URL, http_client=http_client)\n\n# Get the vector store ID\nstores = client.vector_stores.list()\nvs_id = next(s.id for s in stores.data if s.name == \"rag-docs\")\nprint(f\"Vector store: {vs_id}\")\n\n# Read and upload documents from docs/ directory\ndocs_dir = \"docs\"\nprint(f\"Reading documents from {docs_dir}/...\")\n\nfor filename in sorted(os.listdir(docs_dir)):\n    if filename.endswith(\".md\"):\n        filepath = os.path.join(docs_dir, filename)\n        # TODO: add implementation\n\n        f = client.files.create(\n            file=open(filepath, \"rb\"),\n            purpose=\"assistants\",\n        )\n        client.vector_stores.files.create(\n            vector_store_id=vs_id,\n            file_id=f.id,\n        )        \n\n        print(f\"  Uploaded: {filename}\")\n\nprint(\"Done\")",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation genai-rag]$ cat ingest_documents.py\n\"\"\"Ingest documents into the RAG vector store.\n\nThis script reads Markdown documents from the docs/ directory,\nuploads them as files, and attaches them to the vector store.\n\"\"\"\n\nimport logging\nimport os\n\nimport httpx\nfrom llama_stack_client import LlamaStackClient\n\nlogging.getLogger(\"httpx\").setLevel(logging.WARNING)\n\nLS_URL = \"https://llama-stack-genai-rag.apps.ocp4.example.com\"\n\nhttp_client = httpx.Client(verify=False, timeout=300.0)\nclient = LlamaStackClient(base_url=LS_URL, http_client=http_client)\n\n# Get the vector store ID\nstores = client.vector_stores.list()\nvs_id = next(s.id for s in stores.data if s.name == \"rag-docs\")\nprint(f\"Vector store: {vs_id}\")\n\n# Read and upload documents from docs/ directory\ndocs_dir = \"docs\"\nprint(f\"Reading documents from {docs_dir}/...\")\n\nfor filename in sorted(os.listdir(docs_dir)):\n    if filename.endswith(\".md\"):\n        filepath = os.path.join(docs_dir, filename)\n        # TODO: add implementation\n\n        f = client.files.create(\n            file=open(filepath, \"rb\"),\n            purpose=\"assistants\",\n        )\n        client.vector_stores.files.create(\n            vector_store_id=vs_id,\n            file_id=f.id,\n        )        \n\n        print(f\"  Uploaded: {filename}\")\n\nprint(\"Done\")",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1791879651595,
      "labelPosition": null,
      "baseFontSize": null
    },
