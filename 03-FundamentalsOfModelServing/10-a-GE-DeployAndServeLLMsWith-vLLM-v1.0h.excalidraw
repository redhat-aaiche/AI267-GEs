      "opacity": 100,
      "angle": 0,
      "x": 540.2505363752967,
      "y": -10169.237199294048,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "width": 1395.63330078125,
      "height": 270,
      "seed": 1513243669,
