      "originalText": "[student@workstation genai-guardrails]$ cat guardrails_client.py\nimport re\n\nimport requests\nimport urllib3\n\nurllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)\n\n# TODO: Add Guardrails Gateway hostname and URLs\n#GUARDRAILS_GATEWAY = \"changeme\"\n#URL_PASSTHROUGH = \"changeme\"\n#URL_GUARDRAILS = \"changeme\"\nGUARDRAILS_GATEWAY = \"https://gorch-gateway-genai-guardrails.apps.lab.example.com\"\nURL_PASSTHROUGH = f\"{GUARDRAILS_GATEWAY}/passthrough/v1/chat/completions\"\nURL_GUARDRAILS = f\"{GUARDRAILS_GATEWAY}/all/v1/chat/completions\"\n\nMODEL_NAME = \"qwen3\"\nTEMPERATURE = 0.3\nMAX_TOKENS = 5000\n\n\ndef _extract_thinking(content: str) -> tuple[str, str]:\n    \"\"\"\n    Separate the <think>…</think> reasoning block from the final answer.\n\n    Returns:\n        (thinking_content, answer)\n        Both strings are stripped. thinking_content is empty when no block exists.\n    \"\"\"\n    match = re.search(r\"<think>(.*?)</think>(.*)\", content, flags=re.DOTALL)\n    if match:\n        return match.group(1).strip(), match.group(2).strip()\n    return \"\", content.strip()\n\n\ndef _build_payload(message: str) -> dict:\n    return {\n        \"model\": MODEL_NAME,\n        \"messages\": [{\"role\": \"user\", \"content\": message}],\n        \"temperature\": TEMPERATURE,\n        \"max_tokens\": MAX_TOKENS,\n    }\n\n\ndef _build_headers() -> dict:\n    return {\"Content-Type\": \"application/json\"}\n\n\ndef _has_detections(response_json: dict) -> bool:\n    detections = response_json.get(\"detections\")\n    if not detections:\n        return False\n    return any(v is not None and v for v in detections.values())\n\n\ndef format_warnings(response_json: dict) -> str:\n    \"\"\"\n    Format warnings and detection details from a guardrails response into\n    a human-readable string.\n    \"\"\"\n    lines = []\n\n    for warning in response_json.get(\"warnings\") or []:\n        warning_type = warning.get(\"type\", \"UNKNOWN\")\n        warning_msg = warning.get(\"message\", \"\")\n        lines.append(f\"[{warning_type}] {warning_msg}\")\n\n    detections = response_json.get(\"detections\") or {}\n    for schema_name, detection_list in detections.items():\n        if not detection_list:\n            continue\n        lines.append(f\"\\n{schema_name.upper()} Detections:\")\n        for detection_group in detection_list:\n            for result in detection_group.get(\"results\") or []:\n                score = result.get(\"score\", 0.0)\n                lines.append(\n                    f\"  • Detector : {result.get('detector_id')}\\n\"\n                    f\"    Type     : {result.get('detection_type')}\\n\"\n                    f\"    Score    : {score:.4f}\\n\"\n                    f'    Flagged  : \"{result.get(\"text\")}\"'\n                )\n\n    return \"\\n\".join(lines)\n\n\ndef parse_response(response_json: dict) -> tuple[str, str, str]:\n    \"\"\"\n    Parse the JSON response from the LLM/guardrails gateway.\n\n    Returns:\n        (answer, thinking, warnings_text)\n        - answer      : the model's final answer (empty when blocked).\n        - thinking    : Qwen3 chain-of-thought content (empty when absent).\n        - warnings_text: formatted guardrails warnings (empty when safe).\n    \"\"\"\n    if _has_detections(response_json) or response_json.get(\"warnings\"):\n        return \"\", \"\", format_warnings(response_json)\n\n    choices = response_json.get(\"choices\") or []\n    if choices:\n        raw_content = choices[0].get(\"message\", {}).get(\"content\", \"\")\n        thinking, answer = _extract_thinking(raw_content)\n        return answer, thinking, \"\"\n\n    return \"No response received from the model.\", \"\", \"\"\n\n\ndef send_query(message: str, apply_guardrails: bool) -> tuple[str, str, str]:\n    \"\"\"\n    Send a query to the LLM gateway with or without guardrails.\n\n    Args:\n        message:          The user's input text.\n        apply_guardrails: If True, routes through the guardrails endpoint.\n\n    Returns:\n        (answer, thinking, warnings_text)\n    \"\"\"\n    if not message or not message.strip():\n        return \"\", \"\", \"\"\n\n    url = URL_GUARDRAILS if apply_guardrails else URL_PASSTHROUGH\n    payload = _build_payload(message)\n    headers = _build_headers()\n\n    try:\n        response = requests.post(\n            url, headers=headers, json=payload, verify=False, timeout=120\n        )\n    except requests.exceptions.RequestException as exc:\n        return f\"Connection error: {exc}\", \"\", \"\"\n\n    if response.status_code != 200:\n        return f\"HTTP {response.status_code}: {response.text}\", \"\", \"\"\n\n    try:\n        response_json = response.json()\n    except ValueError:\n        return \"Could not parse server response as JSON.\", \"\", \"\"\n\n    return parse_response(response_json)",
