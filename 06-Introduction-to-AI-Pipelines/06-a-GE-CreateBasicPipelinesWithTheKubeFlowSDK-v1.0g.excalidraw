      "text": "if __name__ == \"__main__\":\n    outfile = \"pipeline.yaml\"\n\n    # Compile the pipeline\n    compiler.Compiler().compile(pipeline, outfile)\n\n    print(\n        \"Pipeline compiled.\\n\"\n        f\"Use the RHOAI dashboard to import the '{outfile}' file\"\n    )",
