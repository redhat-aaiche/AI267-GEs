      ],
      "frameId": null,
      "index": "c042",
      "roundness": null,
      "seed": 1634997065,
      "version": 1177,
      "versionNonce": 1378816612,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793725905059,
      "created": 1789295053759,
      "link": null,
      "locked": false,
      "text": "° Next, we have the Detector Servers\n\n° These are contained microservices for those individual detection algorithms\n\n° So for example if we had a prompt injection detector that would live in its own server,\n\n° if we had a detector to flag :\n    - for unacceptable language \n  or \n    - for, is this a chemistry topic\n      that the model is being asked for that would live in its own server",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Next, we have the Detector Servers\n\n° These are contained microservices for those individual detection algorithms\n\n° So for example if we had a prompt injection detector that would live in its own server,\n\n° if we had a detector to flag :\n    - for unacceptable language \n  or \n    - for, is this a chemistry topic\n      that the model is being asked for that would live in its own server",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
