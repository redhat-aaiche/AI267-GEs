      "text": "[student@workstation ~]$ curl -sk -X POST \\\n  \"https://qwen3-06b-serving-catalog.apps.lab.example.com/v1/chat/completions\" \\\n  -H \"Content-Type: application/json\" \\\n  --data '{\n  \"model\": \"qwen3-06b\",\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"You are a helpful assistant\"},\n    {\"role\": \"user\", \"content\": \"Explain very briefly what machine learning is.\"}\n  ],\n  \"max_tokens\": 300\n  }' | jq '.choices[0].message.content'",
