      "boundElements": [],
      "updated": 1791807025952,
      "created": 1791807020088,
      "link": null,
      "locked": false,
      "text": "° We pass the input to the Model,\n\n° The Model figures out whether it needs\n  to call a function or not\n\n° If you did not pass any of your function to the\n  model :\n        ==> The model would have either pulled the weather \n              from the internet \n        or\n\n       ==> just hallucinated\n       \n         or\n\n       ==> told you it does not have access to the data\n\n\n° If you pass  your functions to the\n  model :\n\n        ==> Now the Model knows what are the functions\n             that you have in your server\n\n\n        ==> Now the Model can tell to you :\n                \"I should invoke the get_weather function\"\n             and :\n                \"Here are the data you should use to \n                 execute the function\"",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° We pass the input to the Model,\n\n° The Model figures out whether it needs\n  to call a function or not\n\n° If you did not pass any of your function to the\n  model :\n        ==> The model would have either pulled the weather \n              from the internet \n        or\n\n       ==> just hallucinated\n       \n         or\n\n       ==> told you it does not have access to the data\n\n\n° If you pass  your functions to the\n  model :\n\n        ==> Now the Model knows what are the functions\n             that you have in your server\n\n\n        ==> Now the Model can tell to you :\n                \"I should invoke the get_weather function\"\n             and :\n                \"Here are the data you should use to \n                 execute the function\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Yd568SjyYQCf47ZWNKmV4",
      "type": "text",
      "x": 1960,
      "y": -1566.9037838719032,
      "width": 800,
      "height": 315,
      "angle": 0,
      "strokeColor": "#a61e4d",
      "backgroundColor": "#99e9f2",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "LjzWTYRrFnvE7p3ZUQ1hH",
        "TlRxD0Cjc-UNWh3pjUhvW",
        "7wYW3sFdO1p-hKrhxhOFN",
        "Q8iSpSomA7x3vd7VxG0Pc"
      ],
      "frameId": null,
      "index": "bsg",
      "roundness": null,
      "seed": 21168081,
      "version": 527,
      "versionNonce": 649169969,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791807025952,
      "created": 1791807020088,
      "link": null,
      "locked": false,
      "text": "° Function calling is the ability to \n  reliably connect the LLM to external \n  tools to enable effective tool usage\n  and interaction woth external APIs\n\n° This is often a fine-tuned feature,   \n  not available to all Models",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Function calling is the ability to \n  reliably connect the LLM to external \n  tools to enable effective tool usage\n  and interaction woth external APIs\n\n° This is often a fine-tuned feature,    \n  not available to all Models",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
