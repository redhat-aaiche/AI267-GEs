      "version": 229,
      "versionNonce": 1687058227,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793530341442,
      "link": null,
      "locked": false,
      "text": "° Do you know why commercial LLM APIs\n  charge input tokens at a much lower \n  rate than ouput tokens ?",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Do you know why commercial LLM APIs\n  charge input tokens at a much lower \n  rate than ouput tokens ?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1793530335787,
      "baseFontSize": null
    },
    {
      "type": "text",
      "version": 615,
      "versionNonce": 79632595,
      "index": "c15e",
      "isDeleted": false,
      "id": "El9VwX8Y8sooHV0wNkDmf",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 299.38204118198473,
      "y": 66222.5,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "width": 2574.199951171875,
      "height": 431.99999999999994,
      "seed": 604203507,
      "groupIds": [
        "Hw50Yy1cNsqIpYiUPzkgf",
        "UJ0DyQHDk7l9taLyWnST7",
        "LzVigUmP_-191JStICv8F"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1793530341442,
      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 3,
      "text": "==> Answer :\n\n    ° Even though the prefill phase also generates only a single token, it takes much longer than a single decode step, \n      because all input tokens need to be processed. \n         \n    ° On the other hand, the prefill phase is much faster with respect to the number of input tokens than\n      a decode phase for the same number of output tokens\n\n    ° ==> this difference is the reason why commercial LLM APIs charge input tokens at a much lower rate than ouput tokens\n",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "==> Answer :\n\n    ° Even though the prefill phase also generates only a single token, it takes much longer than a single decode step, \n      because all input tokens need to be processed. \n         \n    ° On the other hand, the prefill phase is much faster with respect to the number of input tokens than\n      a decode phase for the same number of output tokens\n\n    ° ==> this difference is the reason why commercial LLM APIs charge input tokens at a much lower rate than ouput tokens\n",
      "autoResize": true,
      "lineHeight": 1.2,
      "labelPosition": null,
      "created": 1793530335787,
      "baseFontSize": null
    },
