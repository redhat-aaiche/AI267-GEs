      "text": "#!/usr/bin/env python3\n\"\"\"Convert diabetes CSV to TrustyAI training data format.\n\nThis script converts a diabetes dataset CSV file to the KServe Inference\nRequest/Response format required by TrustyAI for uploading training data.\n\"\"\"\n# /// script\n# requires-python = \">=3.11\"\n# dependencies = []\n# ///\n\nimport csv\nimport json\nfrom pathlib import Path\n\n\ndef convert_csv_to_trustyai(csv_path: Path, model_name: str) -> dict:\n    \"\"\"Convert CSV file to TrustyAI training data format.\n\n    Args:\n        csv_path: Path to the CSV file\n        model_name: Name of the model in TrustyAI\n\n    Returns:\n        Dictionary in TrustyAI format\n    \"\"\"\n    features_data = []\n    outcomes_data = []\n\n    with open(csv_path) as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            # Extract features (all columns except 'Outcome')\n            features = [\n                float(row[\"Pregnancies\"]),\n                float(row[\"Glucose\"]),\n                float(row[\"BloodPressure\"]),\n                float(row[\"SkinThickness\"]),\n                float(row[\"Insulin\"]),\n                float(row[\"BMI\"]),\n                float(row[\"DiabetesPedigreeFunction\"]),\n                float(row[\"Age\"]),\n            ]\n            features_data.append(features)\n\n            # Extract outcome (target value)\n            outcome = float(row[\"Outcome\"])\n            no_diabetes = 1 - outcome\n            diabetes = outcome\n            outcomes_data.append([no_diabetes, diabetes])\n\n    num_samples = len(features_data)\n    num_features = len(features_data[0])\n\n    # Build TrustyAI format\n    trustyai_data = {\n        \"model_name\": model_name,\n        \"data_tag\": \"TRAINING\",\n        \"request\": {\n            \"inputs\": [\n                {\n                    \"name\": \"dense_input\",\n                    \"shape\": [num_samples, num_features],\n                    \"datatype\": \"FP32\",\n                    \"data\": features_data,\n                }\n            ]\n        },\n        \"response\": {\n            \"outputs\": [\n                {\n                    \"name\": \"dense_2\",\n                    \"shape\": [num_samples, 2],\n                    \"datatype\": \"FP32\",\n                    \"data\": outcomes_data,\n                }\n            ]\n        },\n    }\n\n    return trustyai_data\n\n\ndef main():\n    \"\"\"Main function.\"\"\"\n    csv_path = Path(__file__).parent / \"diabetes.csv\"\n    output_path = Path(__file__).parent / \"trustyai_training_data.json\"\n    model_name = \"diabetes\"\n\n    print(f\"Converting {csv_path} to TrustyAI format...\")\n    trustyai_data = convert_csv_to_trustyai(csv_path, model_name)\n\n    print(f\"Writing to {output_path}...\")\n    with open(output_path, \"w\") as f:\n        json.dump(trustyai_data, f, indent=2)\n\n    num_samples = len(trustyai_data[\"request\"][\"inputs\"][0][\"data\"])\n    print(f\"✓ Converted {num_samples} samples\")\n    print(f\"✓ Model name (Inference Service Name): {model_name}\")\n    print(\"\\nNext, upload training data:\")\n    print(\"\\n  curl $TRUSTY_ROUTE/data/upload \\\\\")\n    print('    -H \"Authorization: Bearer ${TOKEN}\" \\\\')\n    print('    -H \"Content-Type: application/json\" \\\\')\n    print(f\"    -d @{output_path.name}\")\n\n\nif __name__ == \"__main__\":\n    main()",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#!/usr/bin/env python3\n\"\"\"Convert diabetes CSV to TrustyAI training data format.\n\nThis script converts a diabetes dataset CSV file to the KServe Inference\nRequest/Response format required by TrustyAI for uploading training data.\n\"\"\"\n# /// script\n# requires-python = \">=3.11\"\n# dependencies = []\n# ///\n\nimport csv\nimport json\nfrom pathlib import Path\n\n\ndef convert_csv_to_trustyai(csv_path: Path, model_name: str) -> dict:\n    \"\"\"Convert CSV file to TrustyAI training data format.\n\n    Args:\n        csv_path: Path to the CSV file\n        model_name: Name of the model in TrustyAI\n\n    Returns:\n        Dictionary in TrustyAI format\n    \"\"\"\n    features_data = []\n    outcomes_data = []\n\n    with open(csv_path) as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            # Extract features (all columns except 'Outcome')\n            features = [\n                float(row[\"Pregnancies\"]),\n                float(row[\"Glucose\"]),\n                float(row[\"BloodPressure\"]),\n                float(row[\"SkinThickness\"]),\n                float(row[\"Insulin\"]),\n                float(row[\"BMI\"]),\n                float(row[\"DiabetesPedigreeFunction\"]),\n                float(row[\"Age\"]),\n            ]\n            features_data.append(features)\n\n            # Extract outcome (target value)\n            outcome = float(row[\"Outcome\"])\n            no_diabetes = 1 - outcome\n            diabetes = outcome\n            outcomes_data.append([no_diabetes, diabetes])\n\n    num_samples = len(features_data)\n    num_features = len(features_data[0])\n\n    # Build TrustyAI format\n    trustyai_data = {\n        \"model_name\": model_name,\n        \"data_tag\": \"TRAINING\",\n        \"request\": {\n            \"inputs\": [\n                {\n                    \"name\": \"dense_input\",\n                    \"shape\": [num_samples, num_features],\n                    \"datatype\": \"FP32\",\n                    \"data\": features_data,\n                }\n            ]\n        },\n        \"response\": {\n            \"outputs\": [\n                {\n                    \"name\": \"dense_2\",\n                    \"shape\": [num_samples, 2],\n                    \"datatype\": \"FP32\",\n                    \"data\": outcomes_data,\n                }\n            ]\n        },\n    }\n\n    return trustyai_data\n\n\ndef main():\n    \"\"\"Main function.\"\"\"\n    csv_path = Path(__file__).parent / \"diabetes.csv\"\n    output_path = Path(__file__).parent / \"trustyai_training_data.json\"\n    model_name = \"diabetes\"\n\n    print(f\"Converting {csv_path} to TrustyAI format...\")\n    trustyai_data = convert_csv_to_trustyai(csv_path, model_name)\n\n    print(f\"Writing to {output_path}...\")\n    with open(output_path, \"w\") as f:\n        json.dump(trustyai_data, f, indent=2)\n\n    num_samples = len(trustyai_data[\"request\"][\"inputs\"][0][\"data\"])\n    print(f\"✓ Converted {num_samples} samples\")\n    print(f\"✓ Model name (Inference Service Name): {model_name}\")\n    print(\"\\nNext, upload training data:\")\n    print(\"\\n  curl $TRUSTY_ROUTE/data/upload \\\\\")\n    print('    -H \"Authorization: Bearer ${TOKEN}\" \\\\')\n    print('    -H \"Content-Type: application/json\" \\\\')\n    print(f\"    -d @{output_path.name}\")\n\n\nif __name__ == \"__main__\":\n    main()",
