      "link": null,
      "locked": false,
      "fontSize": 36,
      "fontFamily": 8,
      "text": "--> There's some examples here in the material that you\n    can follow through, about how you can run it within\n    your workbench",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> There's some examples here in the material that you\n    can follow through, about how you can run it within\n    your workbench",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793442729204,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "type": "text",
