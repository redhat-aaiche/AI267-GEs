    {
      "id": "3E4ZC6wECwMCnQ3y2XXsn",
      "type": "text",
      "x": -52.52582118340115,
      "y": 163306.02309054043,
      "width": 1603.800048828125,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
