      "text": "[student@workstation monitoring-performance]$ DISTILBERT_ROUTE=$(oc get route distilbert -o jsonpath='{.spec.host}')\n\n[student@workstation monitoring-performance]$ curl -sk https://${DISTILBERT_ROUTE}/metrics | grep '^ovms_requests_success' | grep -v gRPC\n\n\novms_requests_success{api=\"KServe\",interface=\"REST\",method=\"ModelReady\",name=\"distilbert\"} 0\n\novms_requests_success{api=\"KServe\",interface=\"REST\",method=\"ModelInfer\",name=\"distilbert\",version=\"1\"} 10\n\novms_requests_success{api=\"KServe\",interface=\"REST\",method=\"ModelMetadata\",name=\"distilbert\",version=\"1\"} 0\novms_requests_success{api=\"TensorFlowServing\",interface=\"REST\",method=\"GetModelMetadata\",name=\"distilbert\",version=\"1\"} 0\novms_requests_success{api=\"TensorFlowServing\",interface=\"REST\",method=\"Predict\",name=\"distilbert\",version=\"1\"} 0\novms_requests_success{api=\"TensorFlowServing\",interface=\"REST\",method=\"GetModelStatus\",name=\"distilbert\"} 0\n",
