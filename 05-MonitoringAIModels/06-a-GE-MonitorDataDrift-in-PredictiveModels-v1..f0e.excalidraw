      "updated": 1785408887753,
      "link": null,
      "locked": false,
      "text": "[student@workstation ~]$ oc get route\nNAME               HOST/PORT                                                PATH   SERVICES               PORT    TERMINATION          WILDCARD\ndiabetes           diabetes-monitoring-drift.apps.lab.example.com                  diabetes-predictor     http    edge/Redirect        None\ntrustyai-service   trustyai-service-monitoring-drift.apps.lab.example.com          trustyai-service-tls   https   reencrypt/Redirect   None\n[student@workstation ~]$ \n[student@workstation ~]$ TOKEN=$(oc whoami -t)\n[student@workstation ~]$ \n[student@workstation ~]$ curl -s -H \"Authorization: Bearer $TOKEN\" https://diabetes-monitoring-drift.apps.lab.example.com/v2/models/diabetes | jq\n{\n  \"name\": \"diabetes\",\n  \"versions\": [\n    \"1\"\n  ],\n  \"platform\": \"OpenVINO\",\n  \"inputs\": [\n    {\n      \"name\": \"dense_input\",\n      \"datatype\": \"FP32\",\n      \"shape\": [\n        -1,\n        8\n      ]\n    }\n  ],\n  \"outputs\": [\n    {\n      \"name\": \"dense_2\",\n      \"datatype\": \"FP32\",\n      \"shape\": [\n        -1,\n        2\n      ]\n    }\n  ]\n}",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation ~]$ oc get route\nNAME               HOST/PORT                                                PATH   SERVICES               PORT    TERMINATION          WILDCARD\ndiabetes           diabetes-monitoring-drift.apps.lab.example.com                  diabetes-predictor     http    edge/Redirect        None\ntrustyai-service   trustyai-service-monitoring-drift.apps.lab.example.com          trustyai-service-tls   https   reencrypt/Redirect   None\n[student@workstation ~]$ \n[student@workstation ~]$ TOKEN=$(oc whoami -t)\n[student@workstation ~]$ \n[student@workstation ~]$ curl -s -H \"Authorization: Bearer $TOKEN\" https://diabetes-monitoring-drift.apps.lab.example.com/v2/models/diabetes | jq\n{\n  \"name\": \"diabetes\",\n  \"versions\": [\n    \"1\"\n  ],\n  \"platform\": \"OpenVINO\",\n  \"inputs\": [\n    {\n      \"name\": \"dense_input\",\n      \"datatype\": \"FP32\",\n      \"shape\": [\n        -1,\n        8\n      ]\n    }\n  ],\n  \"outputs\": [\n    {\n      \"name\": \"dense_2\",\n      \"datatype\": \"FP32\",\n      \"shape\": [\n        -1,\n        2\n      ]\n    }\n  ]\n}",
      "autoResize": true,
