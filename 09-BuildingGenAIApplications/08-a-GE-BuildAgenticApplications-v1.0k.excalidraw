      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "BkweXhGz9ErUv_iixwS3T",
        "qW-Tol66xacJx0Xhw-35t",
        "VaEpCPENxUC95N2jJgkdJ",
        "3uFvttCCU4LX7SkC1fYs2"
      ],
      "frameId": null,
      "index": "c0jO",
