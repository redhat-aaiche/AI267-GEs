      "created": 1790328593429,
      "link": null,
      "locked": false,
      "text": "° Prepare the demo\n° Remind that project names are used in FQDN :\n        - If creating Route using the default hostname\n        - RFC ...\n° If you are coming from OpenShift : naming is different\n  it is more user ( Data Scientist ) friendly \n        - e.g. Permission ( Contributor instead of OpenShift RBAC naming )",
      "fontSize": 95.99999999999996,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Prepare the demo\n° Remind that project names are used in FQDN :\n        - If creating Route using the default hostname\n        - RFC ...\n° If you are coming from OpenShift : naming is different\n  it is more user ( Data Scientist ) friendly \n        - e.g. Permission ( Contributor instead of OpenShift RBAC naming )",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
