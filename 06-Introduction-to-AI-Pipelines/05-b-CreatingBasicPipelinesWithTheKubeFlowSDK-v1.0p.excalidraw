      "versionNonce": 407878500,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793711010077,
      "link": null,
      "locked": false,
      "text": "° Some Requirements :\n    - all the dependencies need to \n      be in the function body\n\n° Monolitic approach :\n    - Everything needs to be in the function\n    - !! you can not share modules across differrent components\n    - !! some overhead at runtime : installation will be done at runtime",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Some Requirements :\n    - all the dependencies need to \n      be in the function body\n\n° Monolitic approach :\n    - Everything needs to be in the function\n    - !! you can not share modules across differrent components\n    - !! some overhead at runtime : installation will be done at runtime",
      "autoResize": true,
      "lineHeight": 1.25,
