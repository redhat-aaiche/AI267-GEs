      "versionNonce": 279319709,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793532368291,
      "link": null,
      "locked": false,
      "text": "==> Key Benefits :\n\n        ° Zero Memory Fragmentation\n\n        ° Dynamic Allocation as Tokens generate\n          Only allocate what you need\n\n        ° Easy Sharing between Requests\n\n        ° Memory is returned immediately when the \n          request complete and is ready for the\n          next request",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "==> Key Benefits :\n\n        ° Zero Memory Fragmentation\n\n        ° Dynamic Allocation as Tokens generate\n          Only allocate what you need\n\n        ° Easy Sharing between Requests\n\n        ° Memory is returned immediately when the \n          request complete and is ready for the\n          next request",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
