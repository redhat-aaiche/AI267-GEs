      "fontSize": 36,
      "fontFamily": 1,
      "text": "--> Different Hardware Metrics :\n    ° For example, you like to track :\n\n        - KV Cache",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> Different Hardware Metrics :\n    ° For example, you like to track :\n\n        - KV Cache",
      "autoResize": true,
      "lineHeight": 1.25,
