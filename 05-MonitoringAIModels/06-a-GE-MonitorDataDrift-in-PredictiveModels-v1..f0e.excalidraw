      "updated": 1785409478753,
      "link": null,
      "locked": false,
      "text": "[student@workstation scripts]$ cat establish_baseline.sh \n#!/bin/bash\n\nSCRIPT_DIR=$(cd \"$(dirname \"$0\")\" && pwd)\n\necho \"Establishing baseline SPD metrics by sending training data...\"\n\nfor batch in 0 250 500 750 1000 1250 1500 1750 2000 2250; do\n  echo \"Sending training data in batch $batch...\"\n  \"$SCRIPT_DIR/send_data_batch\" \"$SCRIPT_DIR/../data/training/$batch.json\"\ndone",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation scripts]$ cat establish_baseline.sh \n#!/bin/bash\n\nSCRIPT_DIR=$(cd \"$(dirname \"$0\")\" && pwd)\n\necho \"Establishing baseline SPD metrics by sending training data...\"\n\nfor batch in 0 250 500 750 1000 1250 1500 1750 2000 2250; do\n  echo \"Sending training data in batch $batch...\"\n  \"$SCRIPT_DIR/send_data_batch\" \"$SCRIPT_DIR/../data/training/$batch.json\"\ndone",
