      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "r4q-t0m3PTy06F8fl_z1Y",
        "xldV0AIcIkMsgcHLNKXcc",
        "1XhsYm_3-ikG1lh2d-GVc"
