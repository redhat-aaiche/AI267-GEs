      "link": null,
      "locked": false,
      "text": "[student@workstation genai-agentic]$ bash test_mcp_tools.sh\nDiscovering MCP tools...\nEndpoint: https://todo-mcp-genai-agentic.apps.lab.example.com/mcp/\n\n{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"result\": {\n    \"tools\": [\n      {\n        \"name\": \"add_task\",\n        \"description\": \"Create a new task with a title and optional due date\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"title\": {\n              \"type\": \"string\",\n              \"description\": \"The task title/description\"\n            },\n            \"due_date\": {\n              \"type\": \"string\",\n              \"description\": \"Due date in YYYY-MM-DD format\"\n            }\n          },\n          \"required\": [\n            \"title\"\n          ]\n        }\n      },\n      {\n        \"name\": \"complete_task\",\n        \"description\": \"Mark a task as completed by its ID\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"task_id\": {\n              \"type\": \"integer\",\n              \"description\": \"The ID of the task to complete\"\n            }\n          },\n          \"required\": [\n            \"task_id\"\n          ]\n        }\n      },\n      {\n        \"name\": \"get_tasks_for_date\",\n        \"description\": \"Get all tasks for a specific date\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"due_date\": {\n              \"type\": \"string\",\n              \"description\": \"Date in YYYY-MM-DD format\"\n            }\n          },\n          \"required\": [\n            \"due_date\"\n          ]\n        }\n      },\n      {\n        \"name\": \"get_pending_tasks\",\n        \"description\": \"Get all incomplete tasks\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {}\n        }\n      },\n      {\n        \"name\": \"search_tasks\",\n        \"description\": \"Search tasks by keyword in title\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"keyword\": {\n              \"type\": \"string\",\n              \"description\": \"Keyword to search for\"\n            }\n          },\n          \"required\": [\n            \"keyword\"\n          ]\n        }\n      }\n    ]\n  }\n}",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation genai-agentic]$ bash test_mcp_tools.sh\nDiscovering MCP tools...\nEndpoint: https://todo-mcp-genai-agentic.apps.lab.example.com/mcp/\n\n{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"result\": {\n    \"tools\": [\n      {\n        \"name\": \"add_task\",\n        \"description\": \"Create a new task with a title and optional due date\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"title\": {\n              \"type\": \"string\",\n              \"description\": \"The task title/description\"\n            },\n            \"due_date\": {\n              \"type\": \"string\",\n              \"description\": \"Due date in YYYY-MM-DD format\"\n            }\n          },\n          \"required\": [\n            \"title\"\n          ]\n        }\n      },\n      {\n        \"name\": \"complete_task\",\n        \"description\": \"Mark a task as completed by its ID\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"task_id\": {\n              \"type\": \"integer\",\n              \"description\": \"The ID of the task to complete\"\n            }\n          },\n          \"required\": [\n            \"task_id\"\n          ]\n        }\n      },\n      {\n        \"name\": \"get_tasks_for_date\",\n        \"description\": \"Get all tasks for a specific date\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"due_date\": {\n              \"type\": \"string\",\n              \"description\": \"Date in YYYY-MM-DD format\"\n            }\n          },\n          \"required\": [\n            \"due_date\"\n          ]\n        }\n      },\n      {\n        \"name\": \"get_pending_tasks\",\n        \"description\": \"Get all incomplete tasks\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {}\n        }\n      },\n      {\n        \"name\": \"search_tasks\",\n        \"description\": \"Search tasks by keyword in title\",\n        \"inputSchema\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"keyword\": {\n              \"type\": \"string\",\n              \"description\": \"Keyword to search for\"\n            }\n          },\n          \"required\": [\n            \"keyword\"\n          ]\n        }\n      }\n    ]\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
