      "updated": 1793532368291,
      "link": null,
      "locked": false,
      "text": " ° Imagine a Sequence into B0 through B7",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " ° Imagine a Sequence into B0 through B7",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1793532362015,
      "baseFontSize": null
    },
    {
      "id": "GAUccZFGOYi8FhhJrwBVv",
      "type": "text",
      "x": 320,
      "y": 39420,
      "width": 1182.86669921875,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "s8rvJsxR4g_7P-VXhJocZ",
        "zTDUk-yRTeC1dAoD6iZ5_",
        "fiLa55835S3NLU4ENgltO",
        "B_iGENWfubsF8PL-vL_hA",
        "NyA97lOdBg6qXf6_ACWaD"
      ],
      "frameId": null,
      "index": "c04D",
      "roundness": null,
      "seed": 560564765,
      "version": 3656,
      "versionNonce": 751034205,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793532368291,
      "link": null,
      "locked": false,
      "text": "° Logical blocks 0 through 7 might map to Physical positions\n  5 - 2- 7 - 0 12 3 9 and 15\n\n==> In other words, the data is non-contiguous in Physical memory,\n     and this's fine because the table translates for us\n\n\n==> This simple change :\n     \n        ° Eliminates fragmentation, \n\n        ° Allows dynamic growth as Tokens generate,\n\n     and \n\n        ° Makes sharing straightforward",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Logical blocks 0 through 7 might map to Physical positions\n  5 - 2- 7 - 0 12 3 9 and 15\n\n==> In other words, the data is non-contiguous in Physical memory,\n     and this's fine because the table translates for us\n\n\n==> This simple change :\n     \n        ° Eliminates fragmentation, \n\n        ° Allows dynamic growth as Tokens generate,\n\n     and \n\n        ° Makes sharing straightforward",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1793532362015,
      "baseFontSize": null
    },
