      "text": "[student@workstation monitoring-drift]$ \n[student@workstation monitoring-drift]$ curl ${TRUSTY_ROUTE}/data/upload \\\n-H \"Authorization: Bearer ${TOKEN}\" \\\n-H \"Content-Type: application/json\" \\\n-d @trustyai_training_data.json; echo\n\n768 datapoints successfully added to diabetes data.",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation monitoring-drift]$ \n[student@workstation monitoring-drift]$ curl ${TRUSTY_ROUTE}/data/upload \\\n-H \"Authorization: Bearer ${TOKEN}\" \\\n-H \"Content-Type: application/json\" \\\n-d @trustyai_training_data.json; echo\n\n768 datapoints successfully added to diabetes data.",
