      "updated": 1793532368291,
      "link": null,
      "locked": false,
      "text": "--> The Inspiration : Operating System Paging\n\n        ° No need for contiguous Physical Memory\n\n        ° Pages can be anywhere\n\n        ° Zero fragmentation",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> The Inspiration : Operating System Paging\n\n        ° No need for contiguous Physical Memory\n\n        ° Pages can be anywhere\n\n        ° Zero fragmentation",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null,
