      "updated": 1793614198806,
      "link": null,
      "locked": false,
      "text": "from kfp import dsl\nfrom kfp import compiler\n\n@dsl.component\ndef say_hello(name: str) -> str:\n    hello_text = f'Hello, {name}!'\n    print(hello_text)\n    return hello_text\n\n@dsl.pipeline\ndef hello_pipeline(recipient: str) -> str:\n    hello_task = say_hello(name=recipient)\n    return hello_task.output\n\ncompiler.Compiler().compile(hello_pipeline, 'pipeline.yaml')",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from kfp import dsl\nfrom kfp import compiler\n\n@dsl.component\ndef say_hello(name: str) -> str:\n    hello_text = f'Hello, {name}!'\n    print(hello_text)\n    return hello_text\n\n@dsl.pipeline\ndef hello_pipeline(recipient: str) -> str:\n    hello_task = say_hello(name=recipient)\n    return hello_task.output\n\ncompiler.Compiler().compile(hello_pipeline, 'pipeline.yaml')",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793614186888,
      "labelPosition": null,
      "baseFontSize": null
    },
