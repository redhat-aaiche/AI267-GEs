      "boundElements": [],
      "updated": 1793726663374,
      "created": 1789295214071,
      "link": null,
      "locked": false,
      "text": "° e.g. if your Model has never learned chemistry, \n            \n        ==> don't answer chemistry questions\n\n° you might want to make sure that the Model only talks about material \n  that is well informed on\n\n        ==> it only talks about subjects that it has the \n            educational background to speak on with authority\n\n° you could this by performing a Model Evaluation\n  figuring out which subjects the Model can answer really well\n  and which subjects the Model struggles on",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° e.g. if your Model has never learned chemistry, \n            \n        ==> don't answer chemistry questions\n\n° you might want to make sure that the Model only talks about material \n  that is well informed on\n\n        ==> it only talks about subjects that it has the \n            educational background to speak on with authority\n\n° you could this by performing a Model Evaluation\n  figuring out which subjects the Model can answer really well\n  and which subjects the Model struggles on",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
