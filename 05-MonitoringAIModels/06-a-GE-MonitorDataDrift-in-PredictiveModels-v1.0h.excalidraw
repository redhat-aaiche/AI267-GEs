    {
      "id": "sQmOJMG9URjtkMLw_UgvD",
      "type": "text",
      "x": 100,
      "y": 80000,
      "width": 3009.60009765625,
      "height": 540,
      "angle": 0,
      "strokeColor": "#a61e4d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "QaVuT8vKJtyeeC7s6zNru",
        "VyMfdaMcV8ktiBpy5uJgz",
        "_R8xq7XF435cjkLW28rU3",
        "LvFfMelAqnWGGxGeaVzda",
        "sHYZosI5RzdH-k1nEUwL4",
        "HhsEOY0pHGsNn0FFa-h3N",
        "lpOoqHjHbKDDFueAT9taN",
        "xTn43zEa_YY1f-gN8kXOr",
        "48Yrzuhdc7yBPBxAL8I-X",
        "vvA607Wj218forrq1DWpr",
        "RGZnUGIM_3B19JZODiHjL",
        "oQXJbMOcFgyN1gCFl0e3-",
        "91M-qzut3ijAClRWQY7ra"
      ],
      "frameId": null,
      "index": "c0Mw",
      "roundness": null,
      "seed": 92284473,
      "version": 6201,
      "versionNonce": 1759640185,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792929969207,
      "created": 1792929959533,
      "link": null,
      "locked": false,
      "text": "° Inspect the CSV file that contains samples / observations that you will convert so the TrustyAI instance can use these observations as reference data \n    - note that each sample contains alos the Output ( also called Outcome or Target in ML )\n\n° Convert the CSV file into a file that TrustyAI instance can understand\n    - to create this file, you will need :\n        ° the inference service name and that is why you did it one of the previous steps\n        ° get the names of the Features and Outputs that the Model is expecting. And this is why you got the Model Metadata in on of the previous steps\n        ° a file that contains samples ( observations ) + Outcome\n\n° Inspect the converted sample file\n\n° You will upload the converted file to the TrustyAI instance in the next step",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "° Inspect the CSV file that contains samples / observations that you will convert so the TrustyAI instance can use these observations as reference data \n    - note that each sample contains alos the Output ( also called Outcome or Target in ML )\n\n° Convert the CSV file into a file that TrustyAI instance can understand\n    - to create this file, you will need :\n        ° the inference service name and that is why you did it one of the previous steps\n        ° get the names of the Features and Outputs that the Model is expecting. And this is why you got the Model Metadata in on of the previous steps\n        ° a file that contains samples ( observations ) + Outcome\n\n° Inspect the converted sample file\n\n° You will upload the converted file to the TrustyAI instance in the next step",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
