    {
      "id": "zfjo7n4VAf1BUnpbPb2ek",
      "type": "text",
      "x": 314.062828445587,
      "y": 122422.31497157499,
      "width": 984,
      "height": 705.6,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vGSeNuvqI3y-NBLc3Uj6s",
        "H4qfHK4HQl-ptzY4iFEe4"
      ],
      "frameId": null,
      "index": "c16T",
      "roundness": null,
      "seed": 482802890,
      "version": 464,
      "versionNonce": 2080718556,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793710651494,
      "link": null,
      "locked": false,
      "text": "def smart_division(func): \n   def inner(a, b): \n      print(\"We are dividing\", a, \"with\", b) \n      if b == 0: \n         print(\"OOPS...cannot divide\") \n         return \n      else: \n         return func(a,b) \n   \n    return inner \n\n\n\n@smart_division \ndef division(a, b): \t# a,b are same args that inner()\n   return a / b \n\n\n \nprint(division(20, 2)) \nprint(division(20, 0)) ",
      "fontSize": 28,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def smart_division(func): \n   def inner(a, b): \n      print(\"We are dividing\", a, \"with\", b) \n      if b == 0: \n         print(\"OOPS...cannot divide\") \n         return \n      else: \n         return func(a,b) \n   \n    return inner \n\n\n\n@smart_division \ndef division(a, b): \t# a,b are same args that inner()\n   return a / b \n\n\n \nprint(division(20, 2)) \nprint(division(20, 0)) ",
      "autoResize": true,
      "lineHeight": 1.2,
      "created": 1793614276626,
      "labelPosition": null,
      "baseFontSize": null
    },
